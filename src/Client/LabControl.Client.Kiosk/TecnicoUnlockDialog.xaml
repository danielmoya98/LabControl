<Window x:Class="LabControl.Client.Kiosk.TecnicoUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desbloqueo de Soporte Técnico" 
        Height="450" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="{StaticResource UnivalleCardBgBrush}" CornerRadius="16" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="1.5" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <Border Background="{StaticResource UnivallePillBgBrush}" BorderBrush="{StaticResource UnivallePillBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="🛠️ MANTENIMIENTO TÉCNICO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource UnivallePillTextBrush}"/>
                </Border>
                <TextBlock Text="Desbloqueo de Emergencia" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="Ingrese la contraseña de soporte para acceder a las opciones de mantenimiento físico." 
                           FontSize="12" Foreground="{StaticResource UnivalleTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Error de contraseña -->
            <Border x:Name="ErrorBorder" Grid.Row="1" Visibility="Collapsed" Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                <TextBlock x:Name="TxtError" Text="Contraseña incorrecta." Foreground="#FCA5A5" FontSize="12" HorizontalAlignment="Center"/>
            </Border>

            <!-- Contenido / Acciones -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="Contraseña de Administrador:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource UnivallePasswordBox}" FontSize="15" Margin="0,0,0,15"
                             KeyDown="OnPasswordKeyDown"/>

                <StackPanel x:Name="PanelOpciones" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Opciones de Soporte Técnico:" FontSize="12" Foreground="{StaticResource UnivallePillTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="🔓 Desbloquear y Minimizar (Mantenimiento)" Height="38" Style="{StaticResource UnivallePrimaryButton}" Margin="0,0,0,8" Click="OnDesbloquearMinimizarClick"/>
                    <Button Content="⚙️ Abrir Configuración de Terminal" Height="38" Style="{StaticResource UnivalleOutlineButton}" Margin="0,0,0,8" Click="OnAbrirConfiguracionClick"/>
                    <Button Content="🗑️ Desinstalar Cliente de la Terminal" Height="38" Style="{StaticResource UnivalleDangerButton}" Margin="0,0,0,8" Click="OnDesinstalarAppClick"/>
                    <Button Content="❌ Salir y Cerrar Kiosk" Height="38" Style="{StaticResource UnivalleOutlineButton}" Click="OnCerrarAppClick"/>
                </StackPanel>
            </StackPanel>

            <!-- Botones inferiores -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Button x:Name="BtnValidar" Content="Verificar Clave" Width="130" Height="38" Style="{StaticResource UnivallePrimaryButton}" HorizontalAlignment="Right" Click="OnValidarClaveClick"/>
                <Button Content="Cancelar" Width="100" Height="38" Style="{StaticResource UnivalleOutlineButton}" HorizontalAlignment="Left" Click="OnCancelarClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
