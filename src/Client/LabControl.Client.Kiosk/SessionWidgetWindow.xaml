<Window x:Class="LabControl.Client.Kiosk.SessionWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesión Activa — Univalle LabControl"
        Width="255" Height="38"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="OnWindowLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Estilo de Botón Circular Glass para Cerrar Sesión -->
        <Style x:Key="WidgetCircularButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4DFFFFFF"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Circular Peligro Glass para Apagar PC -->
        <Style x:Key="WidgetDangerCircularButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#33DC2626"/>
            <Setter Property="BorderBrush" Value="#66F43F5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B3DC2626"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFA4AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#66991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#200F172A" 
            CornerRadius="19" 
            BorderBrush="#4DFFFFFF" 
            BorderThickness="1"
            Padding="8,0,6,0" 
            MouseDown="OnBorderMouseDown" 
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Logo Univalle -->
                <ColumnDefinition Width="Auto"/> <!-- Punto Verde Activo -->
                <ColumnDefinition Width="*"/>    <!-- Email / Usuario -->
                <ColumnDefinition Width="Auto"/> <!-- Botón Cerrar Sesión -->
                <ColumnDefinition Width="Auto"/> <!-- Botón Apagar -->
            </Grid.ColumnDefinitions>

            <!-- Logo Univalle -->
            <Image Grid.Column="0" 
                   Source="pack://application:,,,/Assets/logo_univalle.png" 
                   Width="18" Height="18" 
                   Margin="0,0,6,0" 
                   VerticalAlignment="Center" 
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Indicador Verde Activo -->
            <Ellipse Grid.Column="1" 
                     Width="7" Height="7" 
                     Fill="#10B981" 
                     Margin="0,0,6,0" 
                     VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Email Estudiante Recortado -->
            <TextBlock Grid.Column="2" 
                       x:Name="TxtEmailEstudiante" 
                       Text="estudiante@est.univalle.edu"
                       FontSize="11.5" 
                       FontWeight="SemiBold" 
                       Foreground="#F8FAFC"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,6,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <!-- Botón Cerrar Sesión -->
            <Button Grid.Column="3" 
                    Style="{StaticResource WidgetCircularButton}"
                    Margin="0,0,5,0"
                    Click="OnCerrarSesionClick"
                    ToolTip="Cerrar Sesión (Cambiar Usuario)">
                <Path Data="M 10,2 A 4,4 0 1,0 10,10 A 4,4 0 1,0 10,2 M 3,17 C 3,13.5 6,11.5 10,11.5 C 14,11.5 17,13.5 17,17" 
                      Stroke="#F8FAFC" 
                      StrokeThickness="1.4" 
                      StrokeStartLineCap="Round" 
                      StrokeEndLineCap="Round"
                      Width="12" Height="12" 
                      Stretch="Uniform" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>

            <!-- Botón Apagar PC -->
            <Button Grid.Column="4" 
                    Style="{StaticResource WidgetDangerCircularButton}"
                    Click="OnFinalizarYApagarClick"
                    ToolTip="Apagar Terminal">
                <Path Data="M 7,1 L 7,6 M 3.5,3.3 A 5,5 0 1,0 10.5,3.3" 
                      Stroke="#FFFFFF" 
                      StrokeThickness="1.5" 
                      StrokeStartLineCap="Round" 
                      StrokeEndLineCap="Round"
                      Width="11" Height="11" 
                      Stretch="Uniform" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</Window>
