<Window x:Class="LabControl.Client.Kiosk.SessionWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesión Activa - Univalle LabControl"
        Width="520" Height="78"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#1E293B" CornerRadius="14" BorderBrush="#38BDF8" BorderThickness="1.5"
            Padding="12,8" MouseDown="OnBorderMouseDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icono y Contador -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="⏱️" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="TxtContador" Text="01:30:00" FontSize="18" FontWeight="Bold"
                           FontFamily="Consolas, Segoe UI" Foreground="#38BDF8" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Información Estudiante / Aula -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="TxtEmailEstudiante" Text="estudiante@est.univalle.edu"
                           FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtDetalleAula" Text="Aula 302 | Sesión Activa"
                           FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Acciones: Cambiar Usuario & Finalizar y Apagar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cambiar Usuario" Click="OnCerrarSesionClick"
                        Height="32" Padding="8,0" Background="#334155" Foreground="#E2E8F0"
                        FontSize="10" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="⏻ Finalizar y Apagar" Click="OnFinalizarYApagarClick"
                        Height="32" Padding="10,0" Background="#DC2626" Foreground="#FFFFFF"
                        FontSize="11" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
