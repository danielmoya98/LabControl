<Window x:Class="LabControl.Client.Kiosk.SessionWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesión Activa — Univalle LabControl"
        Width="510" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="OnWindowLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Border Background="{StaticResource UnivalleGlassBackgroundBrush}" 
            CornerRadius="18" 
            BorderBrush="{StaticResource UnivalleGlassBorderBrush}" 
            BorderThickness="1.2"
            Padding="14,6" 
            MouseDown="OnBorderMouseDown" 
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <!-- Bisel reflectivo superior sutil (Specular Highlight) -->
            <Border Height="1" VerticalAlignment="Top" Background="#33FFFFFF" Margin="10,0,10,0" CornerRadius="1" Focusable="False"/>

            <Grid VerticalAlignment="Center" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Miniatura Sello Univalle -->
                <Image Grid.Column="0" 
                       Source="pack://application:,,,/Assets/logo_univalle.png" 
                       Width="26" Height="26" 
                       Margin="0,0,10,0" 
                       VerticalAlignment="Center" 
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Badge de Estado En Uso Vidrio Esmeralda -->
                <Border Grid.Column="1" Background="#33064E3B" BorderBrush="#5510B981" BorderThickness="1" 
                        CornerRadius="12" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,5,0"/>
                        <TextBlock Text="EN USO" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                    </StackPanel>
                </Border>

                <!-- Información Estudiante / Aula / PC -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtEmailEstudiante" Text="estudiante@est.univalle.edu"
                               FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDetalleAula" Text="Laboratorio 1 • PC-01"
                               FontSize="10" Foreground="#CBD5E1" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Acciones Acrílicas: Cambiar Usuario & Finalizar y Apagar -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cambiar Usuario" Click="OnCerrarSesionClick"
                            Height="32" Padding="12,0" Style="{StaticResource UnivalleGlassOutlineButton}"
                            FontSize="11" Margin="0,0,6,0" />

                    <Button Content="⏻ Apagar PC" Click="OnFinalizarYApagarClick"
                            Height="32" Padding="12,0" Style="{StaticResource UnivalleGlassDangerButton}"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
