<Window x:Class="LabControl.Client.Kiosk.InactivityWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso de Inactividad" Height="260" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource UnivalleCardBgBrush}" CornerRadius="18" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#F59E0B" Opacity="0.3" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado con Icono -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#2D1D0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                    <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="¿SIGUES AHÍ?" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"/>
                    <TextBlock Text="Detección de inactividad física" FontSize="11" Foreground="{StaticResource UnivalleTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Mensaje Central -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="TxtMensaje" Text="No se ha detectado movimiento de mouse o teclado."
                           FontSize="13" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtSegundosRestantes" Text="La terminal se apagará en 60 segundos..."
                           FontSize="14" FontWeight="Bold" Foreground="#FDA4AF"/>
            </StackPanel>

            <!-- Botón / Indicador de acción -->
            <Button Grid.Row="2" Content="Sigo Trabajando (Mueve el mouse o haz clic aquí)" 
                    Height="42" Style="{StaticResource UnivallePrimaryButton}"
                    Click="OnSigoTrabajandoClick"/>
        </Grid>
    </Border>
</Window>
