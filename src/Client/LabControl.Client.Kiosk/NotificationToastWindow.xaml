<Window x:Class="LabControl.Client.Kiosk.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso de Laboratorio" Height="115" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="{StaticResource UnivalleCardBgBrush}" CornerRadius="14" BorderBrush="{StaticResource UnivalleGuindoBrush}" BorderThickness="1.5"
            Padding="14,10" MouseDown="OnBorderMouseDown" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icono Notificación -->
            <Border Grid.Column="0" Background="{StaticResource UnivallePillBgBrush}" BorderBrush="{StaticResource UnivallePillBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                <TextBlock Text="📢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Contenido del Mensaje -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="AVISO DEL ADMINISTRADOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource UnivallePillTextBrush}"/>
                    <TextBlock Text=" • Univalle LabControl" FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtMensaje" Text="Mensaje de prueba..."
                           FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap" MaxHeight="54"
                           TextTrimming="CharacterEllipsis" LineHeight="16"/>
            </StackPanel>

            <!-- Botón Cerrar Rápido -->
            <Button Grid.Column="2" Content="✕" Width="24" Height="24" Margin="6,0,0,0"
                    VerticalAlignment="Top" Background="#334155" Foreground="#94A3B8"
                    FontSize="11" FontWeight="Bold" Cursor="Hand" Click="OnCerrarClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="12"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
