<Window x:Class="LabControl.Client.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Bloqueada — Univalle LabControl" 
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        Background="#090D16"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Loaded="OnWindowLoaded"
        Closed="OnWindowClosed">
    <Grid>
        <!-- Fondo Decorativo con resplandor Univalle -->
        <Border Margin="0">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#280A16" Offset="0.0" />
                    <GradientStop Color="#14070E" Offset="0.55" />
                    <GradientStop Color="#090B0E" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Tarjeta de Login Glassmorphic -->
                <Border Width="470" Padding="35,30" Background="{StaticResource UnivalleCardBgBrush}" CornerRadius="20" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Logo Univalle Oficial -->
                        <Image Source="pack://application:,,,/Assets/logo_univalle.png" 
                               Width="64" Height="64" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10" 
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Píldora de Estado Terminal Bloqueada -->
                        <Border Background="{StaticResource UnivallePillBgBrush}" 
                                BorderBrush="{StaticResource UnivallePillBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="10,3" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒 " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="TERMINAL BLOQUEADA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource UnivallePillTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Control de Laboratorios" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Universidad del Valle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource UnivalleGuindoHoverBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtAulaInfo" Text="Aula: ... | PC: ..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                        <!-- Mensajes de estado -->
                        <Border x:Name="AlertBorder" Visibility="Collapsed" Background="#331A1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                            <TextBlock x:Name="TxtAlert" Text="" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Formulario de Inicio de Sesión -->
                        <TextBlock Text="Correo Institucional (Estudiante o Docente):" FontSize="13" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource UnivalleTextBox}" FontSize="14" Margin="0,0,0,18"/>

                        <Button Content="🔓 Iniciar Sesión en Computadora" Height="46" Style="{StaticResource UnivallePrimaryButton}" FontSize="14" Click="OnIniciarSesionClick"/>

                        <Button Content="⏻ Apagar Terminal" Height="36" Style="{StaticResource UnivalleDangerButton}" FontSize="12" Margin="0,10,0,0" Click="OnApagarTerminalClick" />

                        <!-- Footer Limpio Institucional para Estudiantes -->
                        <Border Margin="0,20,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="Universidad del Valle — Sistema Centralizado de Cómputo" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Elementos técnicos ocultos para el estudiante (mantenimiento disponible con Ctrl+Shift+F12) -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="TxtSignalRStatus" Text=""/>
                            <TextBlock x:Name="TxtIpMac" Text=""/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
