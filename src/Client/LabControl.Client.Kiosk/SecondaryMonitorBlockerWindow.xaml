<Window x:Class="LabControl.Client.Kiosk.SecondaryMonitorBlockerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Bloqueada — Pantalla Secundaria"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#090D16"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseDown="OnMouseDown">
    <Grid>
        <!-- Fondo Decorativo -->
        <Border Margin="0" Background="#090D16">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Tarjeta Glassmorphic -->
                <Border Width="480" Padding="40" Background="#1E293B" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Logo e Icono -->
                        <TextBlock Text="🔒 TERMINAL BLOQUEADA" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pantalla Secundaria" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="Universidad del Valle — Control de Laboratorios" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,25"/>

                        <Border Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🖥️ Inicie sesión en la pantalla principal" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="El formulario de acceso del estudiante y las herramientas del laboratorio se encuentran activos en el monitor principal." 
                                           FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Haga clic aquí para enfocar la pantalla principal" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
