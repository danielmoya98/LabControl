<Window x:Class="LabControl.Client.Kiosk.SecondaryMonitorBlockerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Bloqueada — Pantalla Secundaria"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#090D16"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseDown="OnMouseDown">
    <Grid>
        <!-- Fondo Decorativo con resplandor Univalle -->
        <Border Margin="0">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#280A16" Offset="0.0" />
                    <GradientStop Color="#14070E" Offset="0.55" />
                    <GradientStop Color="#090B0E" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Tarjeta Glassmorphic -->
                <Border Width="480" Padding="35,30" Background="{StaticResource UnivalleCardBgBrush}" CornerRadius="20" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Logo Univalle Oficial -->
                        <Image Source="pack://application:,,,/Assets/logo_univalle.png" 
                               Width="64" Height="64" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10" 
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Píldora de Estado -->
                        <Border Background="{StaticResource UnivallePillBgBrush}" 
                                BorderBrush="{StaticResource UnivallePillBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="10,3" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒 " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="TERMINAL BLOQUEADA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource UnivallePillTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Pantalla Secundaria" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Universidad del Valle — Control de Laboratorios" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource UnivalleGuindoHoverBrush}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

                        <Border Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🖥️ Inicie sesión en la pantalla principal" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="El formulario de acceso del estudiante y las herramientas del laboratorio se encuentran activos en el monitor principal." 
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Haga clic aquí para enfocar la pantalla principal" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
