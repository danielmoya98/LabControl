<Window x:Class="LabControl.Client.Kiosk.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalación &amp; Configuración de Terminal — Univalle LabControl" 
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🖥️ Instalar &amp; Enlazar Agente Kiosk" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Selecciona el aula donde se encuentra esta computadora para vincularla a la base de datos." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🌐 URL de la API Central:" FontSize="13" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtApiUrl" Grid.Column="0" Text="http://localhost:5256/" FontSize="14" Padding="8,6" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569"/>
                    <Button Grid.Column="1" Content="🔄 Conectar y Leer Aulas" Margin="10,0,0,0" Padding="12,6" Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" Click="OnCargarAulasClick"/>
                </Grid>

                <TextBlock Text="🏢 Selecciona el Aula donde está esta PC:" FontSize="13" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbAulas" FontSize="14" Padding="8,6" Margin="0,0,0,20" Background="#0F172A" Foreground="#FFFFFF"/>

                <Border Background="#0F172A" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚙️ Especificaciones de Red Detectadas de esta PC:" FontSize="12" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtHostname" Text="Hostname: ..." FontSize="13" Foreground="#CBD5E1"/>
                        <TextBlock x:Name="TxtIp" Text="IP Local: ..." FontSize="13" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtMac" Text="Dirección MAC: ..." FontSize="13" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtStatus" Text="" FontSize="13" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="🚀 Enlazar y Auto-Registrar Terminal" Padding="20,10" Background="#22C55E" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Click="OnAutoRegistrarClick"/>
        </StackPanel>
    </Grid>
</Window>
