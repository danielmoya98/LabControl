<Window x:Class="LabControl.Client.Kiosk.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalación &amp; Configuración de Terminal — Univalle LabControl"
        Height="680" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" 
                   Source="pack://application:,,,/Assets/logo_univalle.png" 
                   Width="44" Height="44" 
                   Margin="0,0,14,0" 
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖥️ Instalar &amp; Enlazar Agente Kiosk" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Border Background="{StaticResource UnivallePillBgBrush}" 
                            BorderBrush="{StaticResource UnivallePillBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" 
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UNIVALLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource UnivallePillTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Selecciona el aula donde se encuentra esta computadora para vincularla a la base de datos central." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="{StaticResource UnivalleCardBgBrush}" CornerRadius="14" Padding="22" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🌐 URL de la API Central:" FontSize="13" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtApiUrl" Grid.Column="0" Text="http://localhost:5256/" Style="{StaticResource UnivalleTextBox}" FontSize="13" KeyDown="OnTxtApiUrlKeyDown" />
                    <Button Grid.Column="1" Content="🔄 Conectar y Leer Aulas" Margin="10,0,0,0" Height="40" Style="{StaticResource UnivallePrimaryButton}" FontSize="13" Click="OnCargarAulasClick"/>
                </Grid>

                <TextBlock Text="🏢 Selecciona el Aula donde está esta PC:" FontSize="13" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbAulas" FontSize="13" Padding="10,8" Margin="0,0,0,18" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#161D26"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#BE123C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#9E0044"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Border Background="#0F172A" CornerRadius="10" Padding="15" BorderBrush="{StaticResource UnivalleCardBorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚙️ Especificaciones de Red Detectadas de esta PC:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource UnivalleGuindoHoverBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtHostname" Text="Hostname: ..." FontSize="13" Foreground="#CBD5E1"/>
                        <TextBlock x:Name="TxtIp" Text="IP Local: ..." FontSize="13" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtMac" Text="Dirección MAC: ..." FontSize="13" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtStatus" Text="" FontSize="13" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Cerrar Asistente" Height="42" Padding="18,0" Style="{StaticResource UnivalleOutlineButton}" HorizontalAlignment="Left" Click="OnCerrarClick" />
            <Button Content="🚀 Enlazar y Auto-Registrar Terminal" Height="42" Padding="22,0" Background="#16A34A" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" Click="OnAutoRegistrarClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
