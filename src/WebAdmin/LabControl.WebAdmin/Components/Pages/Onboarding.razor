@page "/onboarding"
@using Microsoft.AspNetCore.Components.Web
@using LabControl.WebAdmin.Services
@using LabControl.Application.Features.Onboarding.Commands.CompleteOnboarding
@inject LabApiClient ApiClient
@inject UserSessionService SessionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Configuración Inicial — LabControl</PageTitle>

<div class="onboarding-root">
    <div class="onboarding-card">
        <!-- Encabezado de Marca -->
        <div class="onboarding-header">
            <div class="d-flex align-center justify-center gap-2 mb-2">
                <div class="logo-circle">
                    <img src="images/logo_univalle.png" alt="Univalle Logo" style="width: 26px; height: 26px; object-fit: contain;" />
                </div>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="color: #ffffff; letter-spacing: -0.5px;">
                    LabControl
                </MudText>
                <span class="badge-pill">Onboarding</span>
            </div>
            <MudText Typo="Typo.body2" Style="color: #94a3b8; text-align: center;">
                Asistente de Puesta en Marcha del Centro de Cómputo
            </MudText>
        </div>

        <!-- Barra de Progreso de Pasos -->
        <div class="steps-bar">
            <div class="step-item @(ActiveStep >= 0 ? "active" : "") @(ActiveStep > 0 ? "completed" : "")">
                <span class="step-number">1</span>
                <span class="step-label">Sede</span>
            </div>
            <div class="step-line @(ActiveStep >= 1 ? "filled" : "")"></div>
            <div class="step-item @(ActiveStep >= 1 ? "active" : "") @(ActiveStep > 1 ? "completed" : "")">
                <span class="step-number">2</span>
                <span class="step-label">Encargado</span>
            </div>
            <div class="step-line @(ActiveStep >= 2 ? "filled" : "")"></div>
            <div class="step-item @(ActiveStep >= 2 ? "active" : "") @(ActiveStep > 2 ? "completed" : "")">
                <span class="step-number">3</span>
                <span class="step-label">Bloques</span>
            </div>
            <div class="step-line @(ActiveStep >= 3 ? "filled" : "")"></div>
            <div class="step-item @(ActiveStep >= 3 ? "active" : "") @(ActiveStep > 3 ? "completed" : "")">
                <span class="step-number">4</span>
                <span class="step-label">Aulas</span>
            </div>
            <div class="step-line @(ActiveStep >= 4 ? "filled" : "")"></div>
            <div class="step-item @(ActiveStep >= 4 ? "active" : "")">
                <span class="step-number">5</span>
                <span class="step-label">Confirmar</span>
            </div>
        </div>

        <!-- Contenido Dinámico por Paso -->
        <div class="step-content">
            @if (ActiveStep == 0)
            {
                <!-- PASO 1: SEDE -->
                <div class="content-fade-in">
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1" Style="color: #f8fafc;">
                        Identificación de la Sede Local
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: #94a3b8;">
                        Registra la sede o regional donde está operando este servidor en la intranet.
                    </MudText>

                    <div class="form-grid">
                        <MudTextField @bind-Value="Model.SedeNombre" 
                                      Label="Nombre de la Sede" 
                                      Placeholder="Ej: Universidad del Valle - Sede Sucre" 
                                      Variant="Variant.Outlined" 
                                      Required="true" 
                                      FullWidth="true" />

                        <div class="d-flex gap-3">
                            <MudTextField @bind-Value="Model.SedeCodigo" 
                                          Label="Código Único" 
                                          Placeholder="Ej: SUC" 
                                          Variant="Variant.Outlined" 
                                          Required="true" 
                                          Style="flex: 1;" />

                            <MudTextField @bind-Value="Model.SedeCiudad" 
                                          Label="Ciudad" 
                                          Placeholder="Ej: Sucre" 
                                          Variant="Variant.Outlined" 
                                          Required="true" 
                                          Style="flex: 1;" />
                        </div>

                        <MudTextField @bind-Value="Model.SedeDireccion" 
                                      Label="Dirección / Campus (Opcional)" 
                                      Placeholder="Ej: Campus Universitario, Zona San Roque" 
                                      Variant="Variant.Outlined" 
                                      FullWidth="true" />
                    </div>
                </div>
            }
            else if (ActiveStep == 1)
            {
                <!-- PASO 2: PRIMER ENCARGADO -->
                <div class="content-fade-in">
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1" Style="color: #f8fafc;">
                        Primer Usuario Encargado
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: #94a3b8;">
                        El rol único de <strong>Encargado</strong> tiene control total de salas, horarios y reportes.
                    </MudText>

                    <div class="form-grid">
                        <MudTextField @bind-Value="Model.EncargadoNombreCompleto" 
                                      Label="Nombre Completo" 
                                      Placeholder="Ej: Ing. Daniel Moya" 
                                      Variant="Variant.Outlined" 
                                      Required="true" 
                                      FullWidth="true" />

                        <MudTextField @bind-Value="Model.EncargadoEmail" 
                                      Label="Correo Institucional" 
                                      Placeholder="Ej: encargado@univalle.edu" 
                                      Variant="Variant.Outlined" 
                                      Required="true" 
                                      FullWidth="true" />

                        <div class="d-flex gap-3">
                            <MudTextField @bind-Value="Model.EncargadoPassword" 
                                          Label="Contraseña" 
                                          InputType="InputType.Password" 
                                          Variant="Variant.Outlined" 
                                          Required="true" 
                                          Style="flex: 1;" />

                            <MudTextField @bind-Value="ConfirmPassword" 
                                          Label="Confirmar Contraseña" 
                                          InputType="InputType.Password" 
                                          Variant="Variant.Outlined" 
                                          Required="true" 
                                          Style="flex: 1;" />
                        </div>
                    </div>
                </div>
            }
            else if (ActiveStep == 2)
            {
                <!-- PASO 3: BLOQUES -->
                <div class="content-fade-in">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #f8fafc;">
                                Bloques / Edificios del Campus
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8;">
                                Define los bloques. Puedes marcar si tienen pisos o solo planta baja.
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Add" 
                                   OnClick="AgregarBloque"
                                   Size="Size.Small">
                            Nuevo Bloque
                        </MudButton>
                    </div>

                    @if (Model.Bloques.Count == 0)
                    {
                        <div class="empty-list-box">
                            <MudIcon Icon="@Icons.Material.Filled.Domain" Size="Size.Large" Color="Color.Default" />
                            <MudText Typo="Typo.body2" Class="mt-2" Style="color: #94a3b8;">
                                No has agregado ningún bloque. Pulsa "Nuevo Bloque" para comenzar.
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <div class="list-container">
                            @foreach (var (bloque, index) in Model.Bloques.Select((b, i) => (b, i)))
                            {
                                <div class="item-card mb-3" @key="index">
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                Bloque #@(index + 1)
                                            </MudChip>
                                            <span style="font-weight: 600; color: #f8fafc;">@(string.IsNullOrWhiteSpace(bloque.Nombre) ? "Sin nombre" : bloque.Nombre)</span>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" 
                                                       Color="Color.Error" 
                                                       Size="Size.Small" 
                                                       OnClick="() => EliminarBloque(index)" />
                                    </div>
                                    <div class="d-flex gap-3 mb-2">
                                        <MudTextField @bind-Value="bloque.Nombre" Label="Nombre del Bloque" Placeholder="Ej: Bloque A" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 2;" />
                                        <MudTextField @bind-Value="bloque.Codigo" Label="Código" Placeholder="Ej: BLQ-A" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;" />
                                    </div>
                                    <div class="d-flex align-center justify-space-between pt-1">
                                        <MudSwitch @bind-Value="bloque.TienePisos" Label="¿Tiene pisos superiores?" Color="Color.Primary" />
                                        @if (bloque.TienePisos)
                                        {
                                            <MudNumericField @bind-Value="bloque.TotalPisos" Label="Total Pisos" Min="1" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 140px;" />
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.8rem; color: #94a3b8;">(Solo Planta Baja / Nivel Único)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (ActiveStep == 3)
            {
                <!-- PASO 4: AULAS Y COMPUTADORAS -->
                <div class="content-fade-in">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #f8fafc;">
                                Aulas y Laboratorios
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color: #94a3b8;">
                                Asigna aulas a sus bloques y define la capacidad de computadoras.
                            </MudText>
                        </div>
                    </div>

                    @foreach (var (bloque, bIndex) in Model.Bloques.Select((b, i) => (b, i)))
                    {
                        <div class="bloque-section mb-4">
                            <div class="d-flex justify-space-between align-center mb-2 pb-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Color="Color.Primary" Size="Size.Small" />
                                    <span style="font-weight: 700; color: #e2e8f0;">@bloque.Nombre</span>
                                    <span style="font-size: 0.75rem; color: #94a3b8;">(@bloque.Codigo)</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Primary" 
                                           StartIcon="@Icons.Material.Filled.Add" 
                                           OnClick="() => AgregarAula(bloque)"
                                           Size="Size.Small">
                                    Agregar Aula
                                </MudButton>
                            </div>

                            @if (bloque.Aulas.Count == 0)
                            {
                                <div style="padding: 12px; text-align: center; color: #64748b; font-size: 0.85rem;">
                                    Sin aulas en este bloque aún.
                                </div>
                            }
                            else
                            {
                                @foreach (var (aula, aIndex) in bloque.Aulas.Select((a, i) => (a, i)))
                                {
                                    <div class="aula-item-card mb-2" @key="aIndex">
                                        <div class="d-flex gap-2 align-center">
                                            <MudTextField @bind-Value="aula.Nombre" 
                                                          Label="Nombre Aula / Lab" 
                                                          Placeholder="Ej: Laboratorio 302" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Dense" 
                                                          Style="flex: 2;" />

                                            <MudTextField @bind-Value="aula.Piso" 
                                                          Label="Piso / Nivel" 
                                                          Placeholder="Ej: Piso 2, PB" 
                                                          Variant="Variant.Outlined" 
                                                          Margin="Margin.Dense" 
                                                          Style="flex: 1;" />

                                            <MudNumericField @bind-Value="aula.Capacidad" 
                                                            Label="Cant. PCs" 
                                                            Min="1" 
                                                            Max="100" 
                                                            Variant="Variant.Outlined" 
                                                            Margin="Margin.Dense" 
                                                            Style="flex: 1;" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                                           Color="Color.Error" 
                                                           Size="Size.Small" 
                                                           OnClick="() => EliminarAula(bloque, aIndex)" />
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
            else if (ActiveStep == 4)
            {
                <!-- PASO 5: RESUMEN Y CONFIRMAR -->
                <div class="content-fade-in">
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1" Style="color: #f8fafc;">
                        Resumen de la Configuración
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: #94a3b8;">
                        Verifica los datos antes de inicializar el centro de cómputo.
                    </MudText>

                    <div class="summary-box mb-3">
                        <div class="summary-row">
                            <span class="summary-key">Sede:</span>
                            <span class="summary-val">@Model.SedeNombre (@Model.SedeCodigo) - @Model.SedeCiudad</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-key">Encargado:</span>
                            <span class="summary-val">@Model.EncargadoNombreCompleto (@Model.EncargadoEmail)</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-key">Bloques Registrados:</span>
                            <span class="summary-val">@Model.Bloques.Count bloque(s)</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-key">Total Aulas / Labs:</span>
                            <span class="summary-val">@Model.Bloques.Sum(b => b.Aulas.Count) aula(s)</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-key">Capacidad Total de Equipos:</span>
                            <span class="summary-val" style="color: #fda4af; font-weight: 700;">
                                @Model.Bloques.SelectMany(b => b.Aulas).Sum(a => a.Capacidad) PCs
                            </span>
                        </div>
                    </div>

                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg mb-2">
                        Al completar el onboarding, tu cuenta quedará autenticada automáticamente con el rol de <strong>Encargado</strong> y se habilitará el monitoreo y control en vivo.
                    </MudAlert>
                </div>
            }
        </div>

        <!-- Botones de Navegación Inferiores -->
        <div class="actions-bar">
            @if (ActiveStep > 0)
            {
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Default" 
                           OnClick="PasoAnterior" 
                           Disabled="IsSubmitting">
                    Anterior
                </MudButton>
            }
            else
            {
                <div></div>
            }

            @if (ActiveStep < 4)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           OnClick="PasoSiguiente">
                    Siguiente
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Success" 
                           StartIcon="@Icons.Material.Filled.RocketLaunch" 
                           OnClick="FinalizarOnboardingAsync" 
                           Disabled="IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Inicializando Sistema...</span>
                    }
                    else
                    {
                        <span>Completar Onboarding e Iniciar</span>
                    }
                </MudButton>
            }
        </div>
    </div>
</div>

<style>
    .onboarding-root {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 15%, rgba(158, 0, 68, 0.28) 0%, transparent 60%), linear-gradient(180deg, #0d0f14 0%, #170d13 50%, #090b0e 100%);
        padding: 24px;
        font-family: inherit;
    }

    .onboarding-card {
        width: 100%;
        max-width: 760px;
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        backdrop-filter: blur(16px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        padding: 32px;
        display: flex;
        flex-direction: column;
    }

    .onboarding-header {
        margin-bottom: 24px;
    }

    .logo-circle {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(158, 0, 68, 0.18);
        border: 1px solid rgba(158, 0, 68, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .badge-pill {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 9999px;
        background: rgba(158, 0, 68, 0.2);
        color: #fda4af;
        border: 1px solid rgba(244, 63, 94, 0.35);
    }

    .steps-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        padding: 0 12px;
    }

    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .step-number {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .step-label {
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 600;
    }

    .step-item.active .step-number {
        background: #9e0044;
        border-color: #be123c;
        color: #ffffff;
        box-shadow: 0 0 14px rgba(158, 0, 68, 0.5);
    }

    .step-item.active .step-label {
        color: #f8fafc;
    }

    .step-item.completed .step-number {
        background: rgba(16, 185, 129, 0.2);
        border-color: #10b981;
        color: #10b981;
    }

    .step-line {
        flex: 1;
        height: 2px;
        background: rgba(255, 255, 255, 0.08);
        margin: 0 8px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .step-line.filled {
        background: #9e0044;
    }

    .step-content {
        min-height: 320px;
        margin-bottom: 24px;
    }

    .content-fade-in {
        animation: fadeIn 0.25s ease-out forwards;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .empty-list-box {
        padding: 40px;
        border: 2px dashed rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        text-align: center;
    }

    .list-container {
        max-height: 350px;
        overflow-y: auto;
        padding-right: 6px;
    }

    .item-card {
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 14px;
    }

    .bloque-section {
        background: rgba(30, 41, 59, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px;
    }

    .aula-item-card {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 10px;
    }

    .summary-box {
        background: rgba(30, 41, 59, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }

    .summary-key {
        color: #94a3b8;
    }

    .summary-val {
        color: #f8fafc;
        font-weight: 600;
    }

    .actions-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* =========================================================================
       ALTO CONTRASTE Y MÁXIMA LEGIBILIDAD PARA CAMPOS DE ONBOARDING (DARK THEME)
       ========================================================================= */
    .onboarding-root,
    .onboarding-card {
        --mud-palette-text-primary: #f8fafc !important;
        --mud-palette-text-secondary: #cbd5e1 !important;
        --mud-palette-text-disabled: #64748b !important;
        --mud-palette-lines-inputs: rgba(255, 255, 255, 0.28) !important;
        --mud-palette-lines-default: rgba(255, 255, 255, 0.18) !important;
        --mud-palette-action-default: #e2e8f0 !important;
        --mud-palette-surface: #1e293b !important;
        --mud-palette-background: #0f172a !important;
        --mud-palette-primary: #f43f5e !important;
    }

    /* Contenedor del campo: Fondo oscuro distintivo para separarlo de la tarjeta */
    .onboarding-card .mud-input.mud-input-outlined {
        background-color: rgba(30, 41, 59, 0.85) !important;
        border-radius: 10px !important;
        transition: all 0.2s ease !important;
    }

    /* Borde del campo en reposo */
    .onboarding-card .mud-input.mud-input-outlined .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.28) !important;
        border-width: 1.5px !important;
    }

    /* Borde en hover */
    .onboarding-card .mud-input.mud-input-outlined:hover .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.6) !important;
    }

    /* Borde y foco activo */
    .onboarding-card .mud-input.mud-input-outlined:focus-within .mud-input-outlined-border {
        border-color: #f43f5e !important;
        border-width: 2px !important;
        box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.3) !important;
    }

    /* Texto tipiado o sugerido: Blanco brillante nítido */
    .onboarding-card .mud-input-slot,
    .onboarding-card input.mud-input-slot,
    .onboarding-card textarea.mud-input-slot {
        color: #ffffff !important;
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        -webkit-text-fill-color: #ffffff !important;
    }

    /* Placeholder visible */
    .onboarding-card .mud-input-slot::placeholder,
    .onboarding-card input.mud-input-slot::placeholder,
    .onboarding-card textarea.mud-input-slot::placeholder {
        color: #94a3b8 !important;
        -webkit-text-fill-color: #94a3b8 !important;
        opacity: 0.9 !important;
    }

    /* Etiquetas del campo (Labels) */
    .onboarding-card .mud-input-control > .mud-input-control-input-container > .mud-input-label-inputcontrol {
        color: #cbd5e1 !important;
        font-weight: 600 !important;
        font-size: 0.92rem !important;
    }

    /* Etiqueta reducida / flotante (notch) */
    .onboarding-card .mud-shrink ~ label.mud-input-label.mud-input-label-inputcontrol,
    .onboarding-card .mud-input:has(:-webkit-autofill) ~ label.mud-input-label.mud-input-label-inputcontrol {
        color: #fda4af !important;
        font-weight: 700 !important;
        background-color: transparent !important;
    }

    /* Etiqueta con foco activo */
    .onboarding-card .mud-input:focus-within ~ label.mud-input-label.mud-input-label-inputcontrol {
        color: #f43f5e !important;
        font-weight: 700 !important;
    }

    /* Adornments, Iconos y Controles Numéricos */
