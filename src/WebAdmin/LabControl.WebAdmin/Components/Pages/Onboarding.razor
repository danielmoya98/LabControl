@code {
    private int ActiveStep = 0;
    private bool IsSubmitting = false;
    private string ConfirmPassword = "";

    // Modelo de Onboarding
    private OnboardingFormModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        // Verificar si ya fue completado
        var status = await ApiClient.GetOnboardingStatusAsync();
        if (status != null && status.OnboardingCompletado)
        {
            // Ya fue completado previamente, redirigir a Login o Dashboard
            Navigation.NavigateTo("/login");
            return;
        }

        // Sugerir datos iniciales pero editables por el usuario
        Model.SedeNombre = "Universidad del Valle - Sede Sucre";
        Model.SedeCodigo = "SUC";
        Model.SedeCiudad = "Sucre";

        // Sugerir un bloque inicial
        var bloqueA = new BloqueFormModel
        {
            Nombre = "Bloque A",
            Codigo = "BLQ-A",
            TienePisos = true,
            TotalPisos = 3
        };

        // Sugerir las 3 aulas reales en el Piso 2 con 26 computadoras configurables
        bloqueA.Aulas.Add(new AulaFormModel { Nombre = "Laboratorio 302", Piso = "Piso 2", Capacidad = 26 });
        bloqueA.Aulas.Add(new AulaFormModel { Nombre = "Laboratorio 303", Piso = "Piso 2", Capacidad = 26 });
        bloqueA.Aulas.Add(new AulaFormModel { Nombre = "Laboratorio 308", Piso = "Piso 2", Capacidad = 26 });

        Model.Bloques.Add(bloqueA);
    }

    private void PasoSiguiente()
    {
        if (ActiveStep == 0)
        {
            if (string.IsNullOrWhiteSpace(Model.SedeNombre) || string.IsNullOrWhiteSpace(Model.SedeCodigo) || string.IsNullOrWhiteSpace(Model.SedeCiudad))
            {
                Snackbar.Add("Por favor completa los datos obligatorios de la sede.", Severity.Warning);
                return;
            }
        }
        else if (ActiveStep == 1)
        {
            if (string.IsNullOrWhiteSpace(Model.EncargadoNombreCompleto) || string.IsNullOrWhiteSpace(Model.EncargadoEmail))
            {
                Snackbar.Add("Por favor completa el nombre y correo del encargado.", Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(Model.EncargadoPassword) || Model.EncargadoPassword.Length < 6)
            {
                Snackbar.Add("La contraseña debe tener al menos 6 caracteres.", Severity.Warning);
                return;
            }

            if (Model.EncargadoPassword != ConfirmPassword)
            {
                Snackbar.Add("Las contraseñas no coinciden.", Severity.Warning);
                return;
            }
        }
        else if (ActiveStep == 2)
        {
            if (Model.Bloques.Count == 0)
            {
                Snackbar.Add("Debes agregar al menos un bloque.", Severity.Warning);
                return;
            }
        }
        else if (ActiveStep == 3)
        {
            int totalAulas = Model.Bloques.Sum(b => b.Aulas.Count);
            if (totalAulas == 0)
            {
                Snackbar.Add("Debes registrar al menos un aula o laboratorio.", Severity.Warning);
                return;
            }
        }

        ActiveStep++;
    }

    private void PasoAnterior()
    {
        if (ActiveStep > 0)
        {
            ActiveStep--;
        }
    }

    private void AgregarBloque()
    {
        int count = Model.Bloques.Count + 1;
        Model.Bloques.Add(new BloqueFormModel
        {
            Nombre = $"Bloque {count}",
            Codigo = $"BLQ-{count}",
            TienePisos = false
        });
    }

    private void EliminarBloque(int index)
    {
        if (index >= 0 && index < Model.Bloques.Count)
        {
            Model.Bloques.RemoveAt(index);
        }
    }

    private void AgregarAula(BloqueFormModel bloque)
    {
        int count = bloque.Aulas.Count + 1;
        bloque.Aulas.Add(new AulaFormModel
        {
            Nombre = $"Laboratorio {count}",
            Piso = bloque.TienePisos ? "Piso 1" : "Planta Baja",
            Capacidad = 26
        });
    }

    private void EliminarAula(BloqueFormModel bloque, int index)
    {
        if (index >= 0 && index < bloque.Aulas.Count)
        {
            bloque.Aulas.RemoveAt(index);
        }
    }

    private async Task FinalizarOnboardingAsync()
    {
        IsSubmitting = true;

        var command = new CompleteOnboardingCommand(
            Model.SedeNombre.Trim(),
            Model.SedeCodigo.Trim().ToUpperInvariant(),
            Model.SedeCiudad.Trim(),
            Model.SedeDireccion?.Trim(),
            Model.EncargadoNombreCompleto.Trim(),
            Model.EncargadoEmail.Trim().ToLowerInvariant(),
            Model.EncargadoPassword,
            Model.Bloques.Select(b => new BloqueOnboardingDto(
                b.Nombre.Trim(),
                b.Codigo.Trim().ToUpperInvariant(),
                b.TienePisos,
                b.TienePisos ? b.TotalPisos : null,
                b.Descripcion,
                b.Aulas.Select(a => new AulaOnboardingDto(
                    a.Nombre.Trim(),
                    a.Piso?.Trim(),
                    a.Capacidad,
                    a.MinutosInactividad,
                    AutoGenerarComputadoras: false
                )).ToList()
            )).ToList()
        );

        var (success, result, errorMessage) = await ApiClient.CompleteOnboardingAsync(command);

        if (success && result != null && !string.IsNullOrEmpty(result.Token))
        {
            // Iniciar sesión directamente con la sesión de Encargado
            SessionService.Login(new UserSession
            {
                Token = result.Token,
                Email = result.EncargadoEmail,
                NombreCompleto = result.EncargadoNombre,
                Rol = "Encargado"
            });

            Snackbar.Add($"¡Onboarding completado exitosamente! Bienvenido {result.EncargadoNombre}", Severity.Success);
            Navigation.NavigateTo("/");
        }
        else
        {
            string msg = !string.IsNullOrWhiteSpace(errorMessage)
                ? errorMessage
                : "Ocurrió un error al procesar el onboarding.";
            Snackbar.Add(msg, Severity.Error);
        }

        IsSubmitting = false;
    }

    public class OnboardingFormModel
    {
        public string SedeNombre { get; set; } = "";
        public string SedeCodigo { get; set; } = "";
        public string SedeCiudad { get; set; } = "";
        public string? SedeDireccion { get; set; }

        public string EncargadoNombreCompleto { get; set; } = "";
        public string EncargadoEmail { get; set; } = "";
        public string EncargadoPassword { get; set; } = "";

        public List<BloqueFormModel> Bloques { get; set; } = [];
    }

    public class BloqueFormModel
    {
        public string Nombre { get; set; } = "";
        public string Codigo { get; set; } = "";
        public bool TienePisos { get; set; } = true;
        public int? TotalPisos { get; set; } = 3;
        public string? Descripcion { get; set; }
        public List<AulaFormModel> Aulas { get; set; } = [];
    }

    public class AulaFormModel
    {
        public string Nombre { get; set; } = "";
        public string? Piso { get; set; } = "Piso 2";
        public int Capacidad { get; set; } = 26;
        public int MinutosInactividad { get; set; } = 15;
    }
