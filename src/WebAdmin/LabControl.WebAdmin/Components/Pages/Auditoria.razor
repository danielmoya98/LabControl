@page "/auditoria"
@using LabControl.WebAdmin.Services
@using LabControl.Application.Features.Sesiones.Queries.GetSesionesAuditoria
@using LabControl.Application.Common.Interfaces
@using LabControl.Application.Features.Aulas.Commands.CreateAula
@using LabControl.Domain.Enums
@inject LabApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Auditoría y Reportes — Control de Laboratorios</PageTitle>

<!-- ENCABEZADO Y ACCIONES DE EXPORTACIÓN -->
<div class="d-flex justify-space-between align-center mb-5 flex-wrap gap-4">
    <div>
        <div class="d-flex align-center gap-2">
            <div class="pa-2 rounded-lg d-flex align-center justify-center" style="background: rgba(37, 99, 235, 0.1); width: 36px; height: 36px;">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-size: 1.35rem; letter-spacing: -0.02em;">
                Auditoría y Reportes de Sesiones
            </MudText>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1" Style="font-size: 0.85rem;">
            Registro histórico de accesos a terminales, trazabilidad de duraciones y exportación para jefatura académica
        </MudText>
    </div>
    <div class="d-flex gap-2 align-center flex-wrap">
        <MudButton Href="@GetPdfExportUrl()"
                   Target="_blank"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   Class="rounded-lg font-weight-bold"
                   Style="text-transform: none; box-shadow: 0 2px 8px rgba(220, 38, 38, 0.2);">
            Exportar a PDF
        </MudButton>
        <MudButton Href="@GetExcelExportUrl()"
                   Target="_blank"
                   Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.TableChart"
                   Class="rounded-lg font-weight-bold"
                   Style="text-transform: none; box-shadow: 0 2px 8px rgba(22, 163, 74, 0.2);">
            Exportar a Excel (.xlsx)
        </MudButton>
        <MudButton Href="@GetCsvExportUrl()"
                   Target="_blank"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   Class="rounded-lg font-weight-bold"
                   Style="text-transform: none;">
            Exportar a CSV
        </MudButton>
    </div>
</div>

<!-- KPI CARDS (RESUMEN DE AUDITORÍA CON BORDES SUTILES) -->
<MudGrid Class="mb-5" Spacing="3">
    <!-- Card 1: Total Sesiones -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0">
            <div>
                <span class="kpi-title">TOTAL SESIONES</span>
                <MudText Typo="Typo.h5" Class="kpi-number mt-1">@(_resultado?.TotalRegistros.ToString("N0") ?? "0")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">Registros en el período</MudText>
            </div>
            <div class="kpi-icon-box kpi-icon-primary">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>

    <!-- Card 2: Horas-Máquina -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0">
            <div>
                <span class="kpi-title">HORAS-MÁQUINA</span>
                <MudText Typo="Typo.h5" Class="kpi-number mt-1" Style="color: #16a34a;">
                    @(((_resultado?.TotalMinutosUso ?? 0) / 60.0).ToString("F1")) hrs
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">
                    @(_resultado?.TotalMinutosUso.ToString("N0") ?? "0") min acumulados
                </MudText>
            </div>
            <div class="kpi-icon-box kpi-icon-success">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>

    <!-- Card 3: Estudiantes Únicos -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0">
            <div>
                <span class="kpi-title">ESTUDIANTES ÚNICOS</span>
                <MudText Typo="Typo.h5" Class="kpi-number mt-1" Style="color: #7c3aed;">
                    @(_resultado?.TotalEstudiantesUnicos.ToString("N0") ?? "0")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">Usuarios con actividad</MudText>
            </div>
            <div class="kpi-icon-box kpi-icon-purple">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>

    <!-- Card 4: Duración Promedio por Sesión -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0">
            <div>
                <span class="kpi-title">DURACIÓN PROMEDIO</span>
                <MudText Typo="Typo.h5" Class="kpi-number mt-1" Style="color: #d97706;">
                    @(_resultado != null && _resultado.TotalRegistros > 0 ? $"{(_resultado.TotalMinutosUso / (double)_resultado.TotalRegistros):F1} min" : "0 min")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">Promedio por terminal</MudText>
            </div>
            <div class="kpi-icon-box" style="background-color: rgba(217, 119, 6, 0.12); color: #d97706;">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- BARRA DE FILTROS EN TIEMPO REAL (REACTIVA & REORGANIZADA) -->
<MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4 rounded-lg d-flex flex-wrap align-center justify-space-between gap-3"
          Style="background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);">
    <div class="d-flex flex-wrap align-center gap-3" style="flex: 1;">
        <!-- 1. Búsqueda por Estudiante (Email) en tiempo real -->
        <MudTextField T="string"
                      Value="_filtroEstudiante"
                      ValueChanged="OnEstudianteChanged"
                      Immediate="true"
                      Label="Buscar Estudiante"
                      Placeholder="correo@est.univalle.edu..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.School"
                      Style="min-width: 230px; max-width: 280px;" />

        <!-- 2. Búsqueda por Terminal / Hostname en tiempo real -->
        <MudTextField T="string"
                      Value="_filtroHostname"
                      ValueChanged="OnHostnameChanged"
                      Immediate="true"
                      Label="Terminal / Hostname"
                      Placeholder="Ej: LAB1-PC01..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Computer"
                      Style="min-width: 190px; max-width: 230px;" />

        <!-- 3. Filtro por Aula en tiempo real -->
        <MudSelect T="int?"
                   Value="_filtroAulaId"
                   ValueChanged="OnAulaChanged"
                   Label="Aula / Laboratorio"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Outlined.MeetingRoom"
                   Style="min-width: 180px;">
            <MudSelectItem T="int?" Value="@((int?)null)">🏢 Todas las Aulas</MudSelectItem>
            @foreach (var aula in _aulas)
            {
                <MudSelectItem T="int?" Value="@((int?)aula.Id)">@aula.Nombre (@aula.Pabellon)</MudSelectItem>
            }
        </MudSelect>

        <!-- 4. Filtro por Tipo de Cierre en tiempo real -->
        <MudSelect T="TipoCierreSesion?"
                   Value="_filtroTipoCierre"
                   ValueChanged="OnTipoCierreChanged"
                   Label="Motivo de Cierre"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Outlined.PowerSettingsNew"
                   Style="min-width: 190px;">
            <MudSelectItem T="TipoCierreSesion?" Value="@((TipoCierreSesion?)null)">Todos los cierres</MudSelectItem>
            <MudSelectItem T="TipoCierreSesion?" Value="@TipoCierreSesion.Manual">🚪 Manual (Estudiante)</MudSelectItem>
            <MudSelectItem T="TipoCierreSesion?" Value="@TipoCierreSesion.Inactividad">⏱️ Inactividad Física</MudSelectItem>
            <MudSelectItem T="TipoCierreSesion?" Value="@TipoCierreSesion.FinPeriodo">🔔 Fin de Período</MudSelectItem>
            <MudSelectItem T="TipoCierreSesion?" Value="@TipoCierreSesion.Recreo">☕ Recreo / Pausa</MudSelectItem>
            <MudSelectItem T="TipoCierreSesion?" Value="@TipoCierreSesion.AdminRemoto">🛡️ Admin Remoto</MudSelectItem>
            <MudSelectItem T="TipoCierreSesion?" Value="@TipoCierreSesion.ApagadoForzado">⚡ Apagado Forzado</MudSelectItem>
        </MudSelect>

        <!-- 5. Selector de Rango de Fechas -->
        <div style="min-width: 240px; max-width: 280px;">
            <MudDateRangePicker DateRange="_dateRange"
                                DateRangeChanged="OnDateRangeChanged"
                                Label="Rango de Fechas"
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense"
                                Clearable="true"
                                PlaceholderStart="Desde"
                                PlaceholderEnd="Hasta" />
        </div>

        @if (HasActiveFilters)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.FilterAltOff"
                       OnClick="LimpiarFiltrosAsync"
                       Size="Size.Small"
                       Style="text-transform: none; font-size: 0.8rem;">
                Limpiar filtros
            </MudButton>
        }
    </div>
</MudPaper>

<!-- TABLA DE HISTORIAL DE AUDITORÍA SAAS REFINADA -->
<MudTable Items="@_sesiones"
          Dense="false"
          Hover="true"
          Bordered="false"
          Striped="false"
          Loading="@_cargando"
          LoadingProgressColor="Color.Primary"
          Elevation="0"
          Class="saas-card rounded-lg overflow-hidden">
    <HeaderContent>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">TERMINAL &amp; ID</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">AULA / ESPACIO</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">ESTUDIANTE</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">INICIO DE SESIÓN</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">FIN / ESTADO</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">DURACIÓN</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">TIPO DE CIERRE</MudTh>
        <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px; text-align: right;">SINCRONIZACIÓN</MudTh>
    </HeaderContent>
    <RowTemplate>
        <!-- 1. Terminal & ID -->
        <MudTd DataLabel="Terminal">
            <div class="d-flex align-center gap-3">
                <div class="pa-2 rounded-md d-flex align-center justify-center"
                     style="width: 36px; height: 36px; background: rgba(37, 99, 235, 0.08); flex-shrink: 0;">
                    <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Color="Color.Primary" Size="Size.Small" />
                </div>
                <div>
                    <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary" Style="font-size: 0.88rem;">
                        @context.Hostname
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">
                        Sesión #@context.SesionId
                    </MudText>
                </div>
            </div>
        </MudTd>

        <!-- 2. Aula / Espacio -->
        <MudTd DataLabel="Aula">
            <div class="d-flex align-center gap-2">
                <div class="pa-1 rounded-md" style="background: rgba(148, 163, 184, 0.1);">
                    <MudIcon Icon="@Icons.Material.Outlined.MeetingRoom" Size="Size.Small" Color="Color.Secondary" />
                </div>
                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.NombreAula</MudText>
            </div>
        </MudTd>

        <!-- 3. Estudiante -->
        <MudTd DataLabel="Estudiante">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Outlined.School" Size="Size.Small" Color="Color.Secondary" />
                <span style="font-size: 0.84rem; font-weight: 500;">
                    @context.EmailEstudiante
                </span>
                <button type="button" class="btn-copy-micro @(EstaCopiado($"aud_email_{context.SesionId}") ? "copied" : "")"
                        @onclick="@(() => CopiarConFeedbackAsync(context.EmailEstudiante, $"aud_email_{context.SesionId}", "Email"))"
                        title="Copiar correo del estudiante">
                    <MudIcon Icon="@(EstaCopiado($"aud_email_{context.SesionId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                </button>
            </div>
        </MudTd>

        <!-- 4. Fecha Inicio -->
        <MudTd DataLabel="Inicio">
            <div class="d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.85rem;" />
                <span style="font-size: 0.82rem;">
                    @context.FechaHoraInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                </span>
            </div>
        </MudTd>

        <!-- 5. Fecha Fin / Estado -->
        <MudTd DataLabel="Fin">
            @if (context.FechaHoraFin.HasValue)
            {
                <span style="font-size: 0.82rem; color: var(--mud-palette-text-secondary);">
                    @context.FechaHoraFin.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                </span>
            }
            else
            {
                <span class="badge-soft badge-soft-success">
                    <span class="pulse-dot-green"></span>
                    Sesión Activa
                </span>
            }
        </MudTd>

        <!-- 6. Duración -->
        <MudTd DataLabel="Duración">
            @if (context.DuracionMinutos.HasValue)
            {
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" Color="Color.Default" Style="font-size: 0.85rem;" />
                    <span style="font-weight: 700; font-size: 0.85rem;">
                        @context.DuracionMinutos.Value min
                    </span>
                </div>
            }
            else
            {
                <span style="color: var(--mud-palette-text-disabled);">-</span>
            }
        </MudTd>

        <!-- 7. Tipo de Cierre -->
        <MudTd DataLabel="Cierre">
            <span class="badge-soft @GetBadgeClassTipoCierre(context.TipoCierre)">
                @GetTextoTipoCierre(context.TipoCierre)
            </span>
        </MudTd>

        <!-- 8. Sincronización -->
        <MudTd DataLabel="Sincronización" Style="text-align: right;">
            @if (context.SyncStatus == SyncStatus.Online)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Outlined.CloudDone" Style="font-size: 0.72rem; height: 22px;">
                    En Línea
                </MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Outlined.CloudSync" Style="font-size: 0.72rem; height: 22px;">
                    Offline Sync
                </MudChip>
            }
        </MudTd>
    </RowTemplate>

    <!-- Estado de Carga Shimmer Elegante -->
    <LoadingContent>
        <div class="pa-4">
            @for (int i = 0; i < 5; i++)
            {
                <div class="d-flex align-center justify-space-between py-3" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                    <div class="d-flex align-center gap-3" style="width: 20%;">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        <div style="width: 70%;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Height="18px" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="14px" />
                        </div>
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="12%" Height="18px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="20%" Height="18px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="14%" Height="18px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="10%" Height="18px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="70px" Height="22px" Class="rounded-pill" />
                </div>
            }
        </div>
    </LoadingContent>

    <!-- Empty State con Llamada a la Acción -->
    <NoRecordsContent>
        <div class="d-flex flex-column align-center justify-center pa-10 text-center">
            @if (HasActiveFilters)
            {
                <div class="pa-4 rounded-circle mb-3" style="background: rgba(148, 163, 184, 0.1);">
                    <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff" Size="Size.Large" Color="Color.Secondary" Style="font-size: 2.8rem;" />
                </div>
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">No se encontraron registros</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 420px; font-size: 0.85rem;">
                    No existen eventos de auditoría que coincidan con el rango de fechas, estudiante o terminal seleccionados.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.RestartAlt"
                           OnClick="LimpiarFiltrosAsync"
                           Class="rounded-lg">
                    Restablecer Filtros
                </MudButton>
            }
            else
            {
                <div class="pa-4 rounded-circle mb-3" style="background: rgba(37, 99, 235, 0.08);">
                    <MudIcon Icon="@Icons.Material.Outlined.HistoryEdu" Size="Size.Large" Color="Color.Primary" Style="font-size: 3rem;" />
                </div>
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Sin historial de auditoría</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2" Style="max-width: 440px; font-size: 0.85rem;">
                    Aún no se han completado sesiones de uso de laboratorio en el sistema.
                </MudText>
            }
        </div>
    </NoRecordsContent>
</MudTable>

<!-- PIE DE PAGINACIÓN ELEGANTE Y REORGANIZADO -->
<div class="d-flex flex-wrap justify-space-between align-center mt-4 px-3 gap-3">
    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.85rem;">
        Página @(_resultado?.PaginaActual ?? 1) de @(Math.Max(_resultado?.TotalPaginas ?? 1, 1)) (@(_resultado?.TotalRegistros ?? 0) registros auditados)
    </MudText>

    <div class="d-flex align-center gap-4">
        <!-- Selector de Registros por Página -->
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Filas:</MudText>
            <MudSelect T="int" Value="_tamanioPagina" ValueChanged="OnTamanioPaginaChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 95px;">
                <MudSelectItem T="int" Value="15">15</MudSelectItem>
                <MudSelectItem T="int" Value="25">25</MudSelectItem>
                <MudSelectItem T="int" Value="50">50</MudSelectItem>
                <MudSelectItem T="int" Value="100">100</MudSelectItem>
            </MudSelect>
        </div>

        <!-- Botones de Navegación -->
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ChevronLeft"
                       Disabled="@(_paginaActual <= 1 || _cargando)"
                       OnClick="() => CargarAuditoriaAsync(_paginaActual - 1)"
                       Class="rounded-lg"
                       Size="Size.Small"
                       Style="text-transform: none;">
                Anterior
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       EndIcon="@Icons.Material.Filled.ChevronRight"
                       Disabled="@(_paginaActual >= (_resultado?.TotalPaginas ?? 1) || _cargando)"
                       OnClick="() => CargarAuditoriaAsync(_paginaActual + 1)"
                       Class="rounded-lg"
                       Size="Size.Small"
                       Style="text-transform: none;">
                Siguiente
            </MudButton>
        </div>
    </div>
</div>

@code {
    private List<AulaDto> _aulas = new();
    private List<SesionAuditoriaDto> _sesiones = new();
    private ResultadoAuditoriaDto? _resultado;
    private bool _cargando = false;

    // Modelos de Filtro Reactivos
    private DateRange? _dateRange;
    private int? _filtroAulaId;
    private string? _filtroEstudiante;
    private string? _filtroHostname;
    private TipoCierreSesion? _filtroTipoCierre;
    private int _paginaActual = 1;
    private int _tamanioPagina = 25;

    // Debounce para filtros de texto en tiempo real
    private CancellationTokenSource? _debounceCts;

    [SupplyParameterFromQuery(Name = "hostname")]
    public string? QueryHostname { get; set; }

    [SupplyParameterFromQuery(Name = "aulaId")]
    public int? QueryAulaId { get; set; }

    private bool HasActiveFilters =>
        _dateRange != null ||
        _filtroAulaId != null ||
        !string.IsNullOrWhiteSpace(_filtroEstudiante) ||
        !string.IsNullOrWhiteSpace(_filtroHostname) ||
        _filtroTipoCierre != null;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(QueryHostname))
            {
                _filtroHostname = QueryHostname.Trim();
            }
            if (QueryAulaId.HasValue && QueryAulaId.Value > 0)
            {
                _filtroAulaId = QueryAulaId.Value;
            }

            _aulas = await ApiClient.GetAulasAsync();
            await CargarAuditoriaAsync(1);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al inicializar auditoría: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private void TriggerDebouncedSearch()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(350, token);
                await CargarAuditoriaAsync(1);
                StateHasChanged();
            }
            catch (TaskCanceledException) { }
        });
    }

    private void OnEstudianteChanged(string val)
    {
        _filtroEstudiante = val;
        TriggerDebouncedSearch();
    }

    private void OnHostnameChanged(string val)
    {
