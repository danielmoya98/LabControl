    }

    private async Task CargarAuditoriaAsync(int nuevaPagina = 1)
    {
        _cargando = true;
        _paginaActual = nuevaPagina;

        // Convertir rangos de fechas locales a UTC para coincidir con almacenamiento PostgreSQL
        DateTime? fechaInicio = _dateRange?.Start.HasValue == true
            ? DateTime.SpecifyKind(_dateRange.Start.Value.Date, DateTimeKind.Local).ToUniversalTime()
            : null;
        DateTime? fechaFin = _dateRange?.End.HasValue == true
            ? DateTime.SpecifyKind(_dateRange.End.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime()
            : null;

        _resultado = await ApiClient.GetAuditoriaSesionesAsync(
            fechaInicio: fechaInicio,
            fechaFin: fechaFin,
            aulaId: _filtroAulaId,
            emailEstudiante: string.IsNullOrWhiteSpace(_filtroEstudiante) ? null : _filtroEstudiante.Trim(),
            hostname: string.IsNullOrWhiteSpace(_filtroHostname) ? null : _filtroHostname.Trim(),
            tipoCierre: _filtroTipoCierre,
            pagina: _paginaActual,
            tamanioPagina: _tamanioPagina
        );

        _sesiones = _resultado?.Sesiones ?? new List<SesionAuditoriaDto>();
        _cargando = false;
    }

    private async Task LimpiarFiltrosAsync()
    {
        _dateRange = null;
        _filtroAulaId = null;
        _filtroEstudiante = null;
        _filtroHostname = null;
        _filtroTipoCierre = null;
        _paginaActual = 1;
        await CargarAuditoriaAsync(1);
    }

