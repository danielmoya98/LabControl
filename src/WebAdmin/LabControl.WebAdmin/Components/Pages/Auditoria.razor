    private readonly HashSet<string> _copiedKeys = [];

    private async Task CopiarConFeedbackAsync(string? texto, string key, string label = "")
    {
        if (string.IsNullOrEmpty(texto)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("clipboardHelper.copyText", texto);
            _copiedKeys.Add(key);
            StateHasChanged();
            Snackbar.Add($"📋 {(string.IsNullOrEmpty(label) ? "Copiado" : label)}: {texto}", Severity.Success);
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copiedKeys.Remove(key);
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            Snackbar.Add("No se pudo copiar al portapapeles", Severity.Warning);
        }
    }

    private bool EstaCopiado(string key) => _copiedKeys.Contains(key);
