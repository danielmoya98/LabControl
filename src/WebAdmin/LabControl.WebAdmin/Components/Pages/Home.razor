    private bool IsPollingHeartbeats = false;

    private async Task SondearTerminalesClickAsync()
    {
        if (IsPollingHeartbeats) return;

        try
        {
            IsPollingHeartbeats = true;
            int? aulaId = Aulas.Any() && ActiveTabIndex >= 0 && ActiveTabIndex < Aulas.Count
                ? Aulas[ActiveTabIndex].AulaId
                : null;

            string aulaNombre = Aulas.Any() && ActiveTabIndex >= 0 && ActiveTabIndex < Aulas.Count
                ? Aulas[ActiveTabIndex].Nombre
                : "todas las aulas";

            Snackbar.Add($"📡 Emitiendo sondeo de telemetría y heartbeat a {aulaNombre}...", Severity.Info);
            var exito = await ApiClient.SondearTerminalesAsync(aulaId);
            if (exito)
            {
                Snackbar.Add("✓ Solicitud de telemetría transmitida. Actualizando estados...", Severity.Success);
                await Task.Delay(1500);
                await CargarDatosAsync();
            }
            else
            {
                Snackbar.Add("No se pudo transmitir la solicitud de sondeo al servidor.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al sondear: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsPollingHeartbeats = false;
            StateHasChanged();
        }
    }

    private async Task SondearTerminalIndividualAsync(string hostname)
    {
        try
        {
            Snackbar.Add($"📡 Solicitando heartbeat inmediato a '{hostname}'...", Severity.Info);
            var exito = await ApiClient.SondearTerminalesAsync(hostname: hostname);
            if (exito)
            {
                Snackbar.Add($"✓ Solicitud de telemetría enviada a '{hostname}'.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"No se pudo contactar a '{hostname}'.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private Color GetChipColor(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => Color.Success, // 🟢 Verde
        EstadoComputadora.EnUso => Color.Info,         // 🔵 Azul
        EstadoComputadora.Offline => Color.Error,      // 🔴 Rojo
        _ => Color.Dark                                // ⚪ Gris
    };

    private string GetEstadoTexto(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => "Disponible",
        EstadoComputadora.EnUso => "En Uso",
        EstadoComputadora.Offline => "Offline",
        _ => "Bloqueada"
    };

    private string GetEstiloBordeCard(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => "border-left: 5px solid #10b981 !important;", // Verde
        EstadoComputadora.EnUso => "border-left: 5px solid #2563eb !important;",      // Azul
        EstadoComputadora.Offline => "border-left: 5px solid #ef4444 !important;",    // Rojo
        _ => "border-left: 5px solid #64748b !important;"                             // Gris
    };

    private bool MostrarModalFreeze = false;
    private string FreezeAccion = "Descongelar";
    private string FreezeClave = "";
    private int? FreezeTargetComputadoraId = null;
    private string FreezeTargetHostname = "";
    private int? FreezeTargetAulaId = null;
    private string FreezeTargetAulaNombre = "";
    private bool IsExecutingFreeze = false;

    private bool MostrarModalActualizar = false;
    private int? UpdateTargetComputadoraId = null;
    private string UpdateTargetHostname = "";
    private int? UpdateTargetAulaId = null;
    private string UpdateTargetAulaNombre = "";
    private InfoActualizacionDto? InfoActualizacion = null;
    private bool IsLoadingUpdateInfo = false;
    private bool IsExecutingUpdate = false;

    private void OpenFreezeAulaDialog(string accion)
    {
        var aulaActual = Aulas.ElementAtOrDefault(ActiveTabIndex);
        if (aulaActual == null) return;

        FreezeAccion = accion;
        FreezeClave = "";
        FreezeTargetComputadoraId = null;
        FreezeTargetHostname = "";
        FreezeTargetAulaId = aulaActual.AulaId;
        FreezeTargetAulaNombre = aulaActual.Nombre;
        MostrarModalFreeze = true;
    }

    private void OpenFreezePcDialog(ComputadoraTarjetaDto pc, string accion)
    {
        FreezeAccion = accion;
        FreezeClave = "";
        FreezeTargetComputadoraId = pc.ComputadoraId;
        FreezeTargetHostname = pc.Hostname;
        FreezeTargetAulaId = null;
        FreezeTargetAulaNombre = "";
        MostrarModalFreeze = true;
    }

    private async Task EjecutarComandoFreezeAsync()
    {
        IsExecutingFreeze = true;
        try
        {
            if (FreezeTargetComputadoraId.HasValue)
            {
                var (success, msg) = await ApiClient.EnviarComandoFreezeComputadoraAsync(
                    FreezeTargetComputadoraId.Value, 
                    FreezeAccion, 
                    string.IsNullOrWhiteSpace(FreezeClave) ? null : FreezeClave);

                if (success)
                {
                    Snackbar.Add($"✓ Orden de '{FreezeAccion}' transmitida a {FreezeTargetHostname}.", Severity.Success);
                    MostrarModalFreeze = false;
                }
                else
                {
                    Snackbar.Add(msg, Severity.Error);
                }
            }
            else if (FreezeTargetAulaId.HasValue)
            {
                var (success, msg) = await ApiClient.EnviarComandoFreezeAulaAsync(
                    FreezeTargetAulaId.Value, 
                    FreezeAccion, 
                    string.IsNullOrWhiteSpace(FreezeClave) ? null : FreezeClave);

                if (success)
                {
                    Snackbar.Add($"✓ Orden de '{FreezeAccion}' transmitida a todas las terminales del aula {FreezeTargetAulaNombre}.", Severity.Success);
                    MostrarModalFreeze = false;
                }
                else
                {
                    Snackbar.Add(msg, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al ejecutar orden de freeze: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsExecutingFreeze = false;
            StateHasChanged();
        }
    }

    private async Task OpenActualizarAulaDialog()
    {
        var aulaActual = Aulas.ElementAtOrDefault(ActiveTabIndex);
        if (aulaActual == null) return;

        UpdateTargetComputadoraId = null;
        UpdateTargetHostname = "";
        UpdateTargetAulaId = aulaActual.AulaId;
        UpdateTargetAulaNombre = aulaActual.Nombre;
        MostrarModalActualizar = true;

        await CargarInfoActualizacionAsync();
    }

    private async Task OpenActualizarPcDialog(ComputadoraTarjetaDto pc)
    {
        UpdateTargetComputadoraId = pc.ComputadoraId;
        UpdateTargetHostname = pc.Hostname;
        UpdateTargetAulaId = null;
        UpdateTargetAulaNombre = "";
        MostrarModalActualizar = true;

        await CargarInfoActualizacionAsync();
    }

    private async Task CargarInfoActualizacionAsync()
    {
        IsLoadingUpdateInfo = true;
        try
        {
            InfoActualizacion = await ApiClient.ObtenerInfoActualizacionAsync();
        }
        catch
        {
            InfoActualizacion = null;
        }
        finally
        {
            IsLoadingUpdateInfo = false;
            StateHasChanged();
        }
    }

    private async Task EjecutarComandoActualizarAsync()
    {
        IsExecutingUpdate = true;
        try
        {
            string? url = InfoActualizacion?.UrlDescarga;
            string? ver = InfoActualizacion?.Version;
            string? sha = InfoActualizacion?.Sha256;

            if (UpdateTargetComputadoraId.HasValue)
            {
                var (success, msg) = await ApiClient.EnviarComandoActualizacionComputadoraAsync(
                    UpdateTargetComputadoraId.Value, url, ver, sha);

                if (success)
                {
                    Snackbar.Add($"🚀 Orden de actualización OTA enviada a {UpdateTargetHostname}.", Severity.Success);
                    MostrarModalActualizar = false;
                }
                else
                {
                    Snackbar.Add(msg, Severity.Error);
                }
            }
            else if (UpdateTargetAulaId.HasValue)
            {
                var (success, msg) = await ApiClient.EnviarComandoActualizacionAulaAsync(
                    UpdateTargetAulaId.Value, url, ver, sha);

                if (success)
                {
                    Snackbar.Add($"🚀 Orden de actualización OTA transmitida al aula {UpdateTargetAulaNombre}.", Severity.Success);
                    MostrarModalActualizar = false;
                }
                else
                {
                    Snackbar.Add(msg, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al ordenar actualización: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsExecutingUpdate = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        SignalRService.OnEstadoComputadoraCambiado -= HandleEstadoComputadoraCambiado;
        SignalRService.OnTelemetriaRecibida -= HandleTelemetriaRecibida;
        SignalRService.OnMiniaturaPantallaRecibida -= HandleMiniaturaPantallaRecibida;
    }
