@page "/"
@using Microsoft.AspNetCore.Components.Web
@using LabControl.Application.Features.Computadoras.Queries.GetEstadoAulasMapa
@using LabControl.Domain.Enums
@using LabControl.WebAdmin.Services
@inject LabApiClient ApiClient
@inject SignalRClientService SignalRService
@inject UserSessionService SessionService
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Tablero en Tiempo Real — Control de Laboratorios</PageTitle>

<!-- Saludo Superior y Botón Circular de Refresco -->
<div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-size: 1.5rem; letter-spacing: -0.4px;">
                Buenos días, @ObtenerNombreSaludo().
            </MudText>
            <span style="font-size: 1.4rem;">👋</span>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.95rem;" Class="mt-1">
            Aquí tienes el resumen de las terminales y laboratorios para hoy.
        </MudText>
    </div>
    
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Sensors" 
                   Size="Size.Small" Class="rounded-lg font-weight-bold" OnClick="SondearTerminalesClickAsync" Disabled="IsPollingHeartbeats">
            @(IsPollingHeartbeats ? "Sondeando..." : "📡 Sondear Terminales")
        </MudButton>
        <MudTooltip Text="Actualizar datos y telemetría">
            <button type="button" class="refresh-btn" @onclick="CargarDatosAsync" title="Actualizar datos">
                <MudIcon Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" />
            </button>
        </MudTooltip>
    </div>
</div>

<!-- Tarjetas de Estadísticas Globales (KPIs estilo Soft SaaS Premium) -->
<MudGrid Class="mb-6">
    @if (IsLoading && !Aulas.Any())
    {
        @for (int s = 0; s < 4; s++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Height="18px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="36px" Height="36px" />
                    </div>
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="40px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="65%" Height="24px" Class="rounded-pill" />
                    </div>
                </MudPaper>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">INACTIVAS / OFFLINE</span>
                    <div class="kpi-icon-box kpi-icon-error">
                        <MudIcon Icon="@Icons.Material.Filled.PowerOff" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalOffline</div>
                    <div class="mt-2">
                        <span class="badge-soft @(TotalOffline > 0 ? "badge-soft-error" : "badge-soft-success")">
                            @(TotalOffline > 0 ? "⚠️ Necesitan atención" : "✓ Todo en orden")
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">EN USO AHORA</span>
                    <div class="kpi-icon-box kpi-icon-primary">
                        <MudIcon Icon="@Icons.Material.Filled.LaptopMac" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalEnUso</div>
                    <div class="mt-2">
                        <span class="badge-soft badge-soft-info">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Style="font-size: 13px;" /> @TotalEnUso sesiones activas
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">DISPONIBLES</span>
                    <div class="kpi-icon-box kpi-icon-success">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalDisponibles</div>
                    <div class="mt-2">
                        <span class="badge-soft badge-soft-success">
                            ● @(TotalPcs > 0 ? (TotalDisponibles * 100 / TotalPcs) : 100)% listas para uso
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">TOTAL TERMINALES</span>
                    <div class="kpi-icon-box kpi-icon-purple">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalPcs</div>
                    <div class="mt-2">
                        <span class="badge-soft badge-soft-purple">
                            🏢 @Aulas.Count laboratorios vinculados
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<!-- Gráfico de Desempeño y Uso Mensual (Premium SaaS Card) -->
<MudPaper Elevation="0" Outlined="true" Class="saas-card pa-6 mb-6">
    <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.1rem;">
                    Resumen del desempeño mensual
                </MudText>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                Comparativo de sesiones activas, finalizadas e incidentes de energía
            </MudText>
        </div>

        <div class="d-flex align-center gap-4 flex-wrap">
            <MudCheckBox @bind-Value="MostrarEtiquetasGrafico" Label="Mostrar etiquetas" Color="Color.Primary" Dense="true" Size="Size.Small" />
            
            <div class="range-pill-group">
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 3 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(3)">3M</button>
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 6 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(6)">6M</button>
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 12 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(12)">12M</button>
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 24 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(24)">24M</button>
            </div>
        </div>
    </div>

    <div class="dashboard-chart-wrapper w-100 pt-2">
        <MudChart ChartType="ChartType.Bar" 
                  ChartSeries="@SeriesGrafico" 
                  ChartLabels="@MesesLabels" 
                  MatchBoundsToSize="true"
                  Width="100%" 
                  Height="320px" 
                  ChartOptions="_chartOptions" />
    </div>
</MudPaper>

<!-- Barra de Control y Supervisión de Aulas -->
<div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
    <div>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.15rem;">
            Supervisión de Terminales por Aula
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Control en tiempo real vía WebSockets y visor mosaico
        </MudText>
    </div>

    <div class="d-flex gap-2 align-center flex-wrap">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="rounded-lg overflow-hidden">
            <MudButton Variant="@(ModoMosaico ? Variant.Outlined : Variant.Filled)" 
                       StartIcon="@Icons.Material.Filled.ViewModule" 
                       OnClick="() => ModoMosaico = false">Tarjetas</MudButton>
            <MudButton Variant="@(ModoMosaico ? Variant.Filled : Variant.Outlined)" 
                       StartIcon="@Icons.Material.Filled.LiveTv" 
                       OnClick="() => ModoMosaico = true">Mosaico en Vivo</MudButton>
        </MudButtonGroup>

        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Sensors" 
                   Size="Size.Small" Class="rounded-lg" OnClick="SondearTerminalesClickAsync" Disabled="IsPollingHeartbeats">
            @(IsPollingHeartbeats ? "Sondeando..." : "Sondear Aula")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Campaign" 
                   Size="Size.Small" Class="rounded-lg" OnClick="OpenMensajeDialog">
            Transmitir Alerta
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PowerSettingsNew" 
                   Size="Size.Small" Class="rounded-lg" OnClick="ConfirmarCierreMasivoAulaAsync" Disabled="@(!Aulas.Any())">
            Desloguear Aula
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.PowerOff" 
                   Size="Size.Small" Class="rounded-lg" OnClick="ConfirmarApagadoAulaAsync" Disabled="@(!Aulas.Any())">
            Apagar Aula
        </MudButton>
    </div>
</div>

<!-- Pestañas de Aulas & Grilla de Computadoras -->
@if (Aulas.Any())
{
    <MudTabs @bind-ActivePanelIndex="ActiveTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="saas-card rounded-lg overflow-hidden mb-6">
            @foreach (var aula in Aulas)
            {
                <MudTabPanel Text="@($"{aula.Nombre} ({aula.Computadoras.Count} PCs)")" Icon="@Icons.Material.Filled.MeetingRoom" Class="pa-6">
                    @if (ModoMosaico)
                    {
                        <MudGrid>
                            @foreach (var pc in aula.Computadoras)
                            {
                                <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                                    <MudCard Elevation="0" Class="saas-card rounded-lg" Style="@($"{GetEstiloBordeCard(pc.EstadoActual)}; overflow: hidden; height: 100%;")">
                                        <div class="d-flex justify-space-between align-center px-3 py-2" style="background: rgba(0,0,0,0.35);">
                                            <div class="d-flex align-center gap-1 text-truncate" style="max-width: 60%;">
                                                <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-truncate">@pc.Hostname</MudText>
                                            </div>
                                            <MudChip T="string" Color="@GetChipColor(pc.EstadoActual)" Size="Size.Small" Class="font-weight-bold">
                                                @GetEstadoTexto(pc.EstadoActual)
                                            </MudChip>
                                        </div>

                                        <div style="position: relative; width: 100%; aspect-ratio: 16/9; background: #0f172a; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                             @onclick="() => AbrirZoomPantalla(pc)">
                                            @if (!string.IsNullOrEmpty(pc.MiniaturaBase64))
                                            {
                                                <img src="data:image/jpeg;base64,@pc.MiniaturaBase64" 
                                                     alt="Pantalla de @pc.Hostname" 
                                                     style="width: 100%; height: 100%; object-fit: cover;" />
                                                <div style="position: absolute; bottom: 6px; right: 6px; background: rgba(0,0,0,0.7); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; color: #fff;">
                                                    <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" Style="font-size: 14px; vertical-align: middle;" /> Ampliar
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center pa-4">
                                                    <MudIcon Icon="@(pc.EstadoActual == EstadoComputadora.Offline ? Icons.Material.Filled.PowerOff : Icons.Material.Filled.ScreenLockPortrait)" 
                                                             Size="Size.Large" Color="Color.Secondary" />
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                                                        @(pc.EstadoActual == EstadoComputadora.Offline ? "Terminal Offline" : "Esperando captura...")
                                                    </MudText>
                                                </div>
                                            }
                                        </div>

                                        <MudCardContent Class="py-2 px-3">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate" Style="max-width: 60%;">
                                                    @(pc.EstadoActual == EstadoComputadora.EnUso ? $"👤 {pc.EmailEstudianteActual}" : (pc.EstadoActual == EstadoComputadora.Disponible ? "🟢 Disponible" : "🔴 Offline"))
                                                </MudText>
                                                <div class="d-flex align-center gap-1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@pc.IpActual</MudText>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"ip_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.IpActual, $"ip_{pc.ComputadoraId}", "IP"))"
                                                            title="Copiar IP">
                                                        <MudIcon Icon="@(EstaCopiado($"ip_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            </div>
                                        </MudCardContent>

                                        <MudCardActions Class="justify-space-between px-3 py-1 flex-wrap gap-1">
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Chat" OnClick="() => AbrirMensajeDirecto(pc.Hostname)">
                                                Mensaje
                                            </MudButton>
                                            @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Block" OnClick="() => ConfirmarCierreForzadoAsync(pc.Hostname)">
                                                    Desloguear
                                                </MudButton>
                                            }
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var pc in aula.Computadoras)
                            {
                                <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                                    <div @oncontextmenu="@(() => AbrirMenuContextual(pc))" @oncontextmenu:preventDefault="true" style="cursor: context-menu; height: 100%;">
                                        <MudCard Elevation="0" Class="saas-card rounded-lg mud-hover" Style="@($"{GetEstiloBordeCard(pc.EstadoActual)}; height: 100%;")">
                                            <MudCardHeader Class="pb-2">
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.h6" Class="font-weight-bold">@pc.Hostname</MudText>
                                                </CardHeaderContent>
                                                <CardHeaderActions>
                                                    <MudChip T="string" Color="@GetChipColor(pc.EstadoActual)" Size="Size.Small" Class="font-weight-bold">
                                                        @GetEstadoTexto(pc.EstadoActual)
                                                    </MudChip>
                                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Opciones">
                                                        @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                                        {
                                                            <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Error" OnClick="() => ConfirmarCierreForzadoAsync(pc.Hostname)">
                                                                Desloguear Sesión
                                                            </MudMenuItem>
                                                        }
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Chat" IconColor="Color.Warning" OnClick="() => AbrirMensajeDirecto(pc.Hostname)">
                                                            Enviar Mensaje Directo
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.LiveTv" IconColor="Color.Info" OnClick="() => AbrirZoomPantalla(pc)">
                                                            Ver Pantalla en Vivo
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopiarAlPortapapeles(pc.IpActual, "IP"))">
                                                            Copiar IP
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Fingerprint" OnClick="@(() => CopiarAlPortapapeles(pc.MacAddress, "MAC"))">
                                                            Copiar MAC
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Sensors" IconColor="Color.Info" OnClick="() => SondearTerminalIndividualAsync(pc.Hostname)">
                                                            Sondear / Ping Terminal
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Memory" IconColor="Color.Primary" OnClick="() => AbrirFichaTecnicaAsync(pc)">
                                                            Ficha Técnica & Salud
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.History" IconColor="Color.Info" OnClick="@(() => NavigationManager.NavigateTo($"/auditoria?hostname={Uri.EscapeDataString(pc.Hostname)}"))">
                                                            Historial de Sesiones
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.PowerSettingsNew" IconColor="Color.Error" OnClick="() => ConfirmarApagadoPcAsync(pc)">
                                                            Apagar Terminal
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" IconColor="Color.Warning" OnClick="() => ConfirmarReinicioPcAsync(pc)">
                                                            Reiniciar Terminal
                                                        </MudMenuItem>
                                                    </MudMenu>
                                                </CardHeaderActions>
                                            </MudCardHeader>

                                        <MudCardContent Class="py-2">
                                            <div class="d-flex align-center justify-space-between mb-1 flex-wrap gap-1">
                                                <div class="d-flex align-center gap-1 text-truncate">
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space: nowrap;"><strong>IP:</strong> @pc.IpActual</MudText>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"ip_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.IpActual, $"ip_{pc.ComputadoraId}", "IP"))"
                                                            title="Copiar IP">
                                                        <MudIcon Icon="@(EstaCopiado($"ip_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                                <div class="d-flex align-center gap-1 text-truncate">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: nowrap;">@pc.MacAddress</MudText>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"mac_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.MacAddress, $"mac_{pc.ComputadoraId}", "MAC"))"
                                                            title="Copiar MAC">
                                                        <MudIcon Icon="@(EstaCopiado($"mac_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.Fingerprint)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            </div>

                                            @if (_telemetriaMap.TryGetValue(pc.ComputadoraId, out var telem))
                                            {
                                                <div class="d-flex gap-1 align-center flex-wrap my-1">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                             Color="@(telem.CpuUso > 85 ? Color.Error : (telem.CpuUso > 65 ? Color.Warning : Color.Success))" 
                                                             Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                        CPU: @(telem.CpuUso)%
                                                    </MudChip>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                             Color="@(telem.RamUso > 85 ? Color.Error : Color.Info)" 
                                                             Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                        RAM: @(telem.RamUso)%
                                                    </MudChip>
                                                    @if (telem.DiscoLibreGb < 10)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" 
                                                                 Icon="@Icons.Material.Filled.Warning" Class="px-1 py-0 font-weight-bold" Style="font-size: 0.7rem; height: 20px;">
                                                            @($"{telem.DiscoLibreGb}GB Libre")
                                                        </MudChip>
                                                    }
                                                </div>
                                            }

                                            @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                            {
                                                <div class="pa-2 rounded mt-2 d-flex align-center justify-space-between" style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.3);">
                                                    <div class="text-truncate mr-1">
                                                        <MudText Typo="Typo.body2" Color="Color.Info" Class="font-weight-bold text-truncate">
                                                            👤 @pc.EmailEstudianteActual
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Info">
                                                            ⏱️ @CalcularTiempoTranscurrido(pc.HoraInicioSesion)
                                                        </MudText>
                                                    </div>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"email_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.EmailEstudianteActual, $"email_{pc.ComputadoraId}", "Email"))"
                                                            title="Copiar correo del estudiante">
                                                        <MudIcon Icon="@(EstaCopiado($"email_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            }
                                            else if (pc.EstadoActual == EstadoComputadora.Disponible)
                                            {
                                                <div class="pa-2 rounded mt-2" style="background: rgba(34, 197, 94, 0.08); border: 1px dashed rgba(34, 197, 94, 0.3);">
                                                    <MudText Typo="Typo.caption" Color="Color.Success">
                                                        🟢 Lista para recibir estudiante
                                                    </MudText>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="pa-2 rounded mt-2" style="background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.3);">
                                                    <MudText Typo="Typo.caption" Color="Color.Error">
                                                        🔴 Sin señal (>2m sin heartbeat)
                                                    </MudText>
                                                </div>
                                            }
                                        </MudCardContent>

                                        <MudCardActions Class="justify-space-between pt-1 flex-wrap gap-1">
                                            <div class="d-flex align-center gap-1">
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Chat" OnClick="() => AbrirMensajeDirecto(pc.Hostname)">
                                                    Mensaje
                                                </MudButton>
                                                @if (!string.IsNullOrEmpty(pc.MiniaturaBase64))
