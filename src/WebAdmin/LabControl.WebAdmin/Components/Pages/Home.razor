    private bool IsPollingHeartbeats = false;

    private async Task SondearTerminalesClickAsync()
    {
        if (IsPollingHeartbeats) return;

        try
        {
            IsPollingHeartbeats = true;
            int? aulaId = Aulas.Any() && ActiveTabIndex >= 0 && ActiveTabIndex < Aulas.Count
                ? Aulas[ActiveTabIndex].AulaId
                : null;

            string aulaNombre = Aulas.Any() && ActiveTabIndex >= 0 && ActiveTabIndex < Aulas.Count
                ? Aulas[ActiveTabIndex].Nombre
                : "todas las aulas";

            Snackbar.Add($"📡 Emitiendo sondeo de telemetría y heartbeat a {aulaNombre}...", Severity.Info);
            var exito = await ApiClient.SondearTerminalesAsync(aulaId);
            if (exito)
            {
                Snackbar.Add("✓ Solicitud de telemetría transmitida. Actualizando estados...", Severity.Success);
                await Task.Delay(1500);
                await CargarDatosAsync();
            }
            else
            {
                Snackbar.Add("No se pudo transmitir la solicitud de sondeo al servidor.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al sondear: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsPollingHeartbeats = false;
            StateHasChanged();
        }
    }

    private async Task SondearTerminalIndividualAsync(string hostname)
    {
        try
        {
            Snackbar.Add($"📡 Solicitando heartbeat inmediato a '{hostname}'...", Severity.Info);
            var exito = await ApiClient.SondearTerminalesAsync(hostname: hostname);
            if (exito)
            {
                Snackbar.Add($"✓ Solicitud de telemetría enviada a '{hostname}'.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"No se pudo contactar a '{hostname}'.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private Color GetChipColor(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => Color.Success, // 🟢 Verde
        EstadoComputadora.EnUso => Color.Info,         // 🔵 Azul
        EstadoComputadora.Offline => Color.Error,      // 🔴 Rojo
        _ => Color.Dark                                // ⚪ Gris
    };

    private string GetEstadoTexto(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => "Disponible",
        EstadoComputadora.EnUso => "En Uso",
        EstadoComputadora.Offline => "Offline",
        _ => "Bloqueada"
    };

    private string GetEstiloBordeCard(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => "border-left: 5px solid #10b981 !important;", // Verde
        EstadoComputadora.EnUso => "border-left: 5px solid #2563eb !important;",      // Azul
        EstadoComputadora.Offline => "border-left: 5px solid #ef4444 !important;",    // Rojo
        _ => "border-left: 5px solid #64748b !important;"                             // Gris
    };

