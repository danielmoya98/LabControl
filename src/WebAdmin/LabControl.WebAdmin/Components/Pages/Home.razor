    private async Task CopiarAlPortapapeles(string texto, string tipo)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clipboardHelper.copyText", texto);
            Snackbar.Add($"📋 {tipo} copiada al portapapeles: {texto}", Severity.Success);
        }
        catch
        {
            Snackbar.Add($"📋 {tipo}: {texto}", Severity.Info);
        }
    }

    private string CalcularTiempoTranscurrido(DateTime? horaInicio)
    {
        if (!horaInicio.HasValue) return "Recién iniciada";
        var inicioUtc = horaInicio.Value.Kind == DateTimeKind.Utc 
            ? horaInicio.Value 
            : (horaInicio.Value.Kind == DateTimeKind.Local ? horaInicio.Value.ToUniversalTime() : DateTime.SpecifyKind(horaInicio.Value, DateTimeKind.Utc));
        var diff = DateTime.UtcNow.Subtract(inicioUtc);
        if (diff.TotalMinutes < 0) return "Recién iniciada";
        if (diff.TotalMinutes < 1) return "< 1 min";
        if (diff.TotalHours < 1) return $"{Math.Floor(diff.TotalMinutes)} min transcurridos";
        return $"{(int)diff.TotalHours}h {diff.Minutes}m transcurridos";
    }

    private async Task EnviarMensajeDirectoAsync()
    {
        if (string.IsNullOrWhiteSpace(MensajeDirectoTexto)) return;

        IsSendingMessage = true;
        bool exito = await ApiClient.EnviarMensajeAlertaAsync(MensajeDirectoTexto, hostname: TargetHostnameMensaje);

        if (exito)
        {
            Snackbar.Add($"¡Mensaje enviado a la terminal '{TargetHostnameMensaje}'!", Severity.Success);
            MostrarModalMensajeDirecto = false;
        }
        else
        {
            Snackbar.Add("No se pudo enviar el mensaje directo.", Severity.Error);
        }

        IsSendingMessage = false;
    }

    private async Task EnviarMensajeAsync()
    {
        if (string.IsNullOrWhiteSpace(MensajeTexto)) return;

        IsSendingMessage = true;
        bool exito = await ApiClient.EnviarMensajeAlertaAsync(
            MensajeTexto,
            null,
            DestinoAulaId == 0 ? null : DestinoAulaId);

        if (exito)
        {
            Snackbar.Add("¡Mensaje transmitido exitosamente a las terminales!", Severity.Success);
            MostrarModalMensaje = false;
        }
        else
        {
            Snackbar.Add("No se pudo transmitir el mensaje. Verifique la conexión con el servidor.", Severity.Error);
        }

        IsSendingMessage = false;
    }

    private async Task ConfirmarCierreForzadoAsync(string hostname)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Cierre Forzado",
            $"¿Estás seguro de finalizar la sesión de uso y desloguear la terminal '{hostname}'?",
            yesText: "Sí, Desloguear", cancelText: "Cancelar"
        );

        if (result == true)
        {
            bool exito = await ApiClient.DesloguearTerminalAsync(hostname: hostname);
            if (exito)
            {
                Snackbar.Add($"Orden de cierre forzado enviada a {hostname}", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"No se pudo enviar la orden a {hostname}", Severity.Error);
            }
        }
    }

    private async Task ConfirmarCierreMasivoAulaAsync()
    {
        var aulaActual = Aulas.ElementAtOrDefault(ActiveTabIndex);
        if (aulaActual == null) return;

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Deslogueo de Aula Completa",
            $"¿Estás seguro de cerrar todas las sesiones activas en el aula '{aulaActual.Nombre}' ({aulaActual.Computadoras.Count} PCs)?\nEsta acción bloqueará todas las terminales del aula.",
            yesText: "Sí, Desloguear Aula", cancelText: "Cancelar"
        );

        if (result == true)
        {
            bool exito = await ApiClient.DesloguearTerminalAsync(aulaId: aulaActual.AulaId);
            if (exito)
            {
                Snackbar.Add($"Orden de deslogueo enviada a todas las PCs del Aula '{aulaActual.Nombre}'.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("No se pudo procesar el deslogueo del aula.", Severity.Error);
            }
        }
    }

