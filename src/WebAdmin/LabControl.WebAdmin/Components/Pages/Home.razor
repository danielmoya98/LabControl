@page "/"
@using Microsoft.AspNetCore.Components.Web
@using LabControl.Application.Features.Computadoras.Queries.GetEstadoAulasMapa
@using LabControl.Domain.Enums
@using LabControl.WebAdmin.Services
@inject LabApiClient ApiClient
@inject SignalRClientService SignalRService
@inject UserSessionService SessionService
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Tablero en Tiempo Real — Control de Laboratorios</PageTitle>

<!-- Saludo Superior y Botón Circular de Refresco -->
<div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-4">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-size: 1.5rem; letter-spacing: -0.4px;">
                Buenos días, @ObtenerNombreSaludo().
            </MudText>
            <span style="font-size: 1.4rem;">👋</span>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.95rem;" Class="mt-1">
            Aquí tienes el resumen de las terminales y laboratorios para hoy.
        </MudText>
    </div>
    
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Sensors" 
                   Size="Size.Small" Class="rounded-lg font-weight-bold" OnClick="SondearTerminalesClickAsync" Disabled="IsPollingHeartbeats">
            @(IsPollingHeartbeats ? "Sondeando..." : "📡 Sondear Terminales")
        </MudButton>
        <MudTooltip Text="Actualizar datos y telemetría">
            <button type="button" class="refresh-btn" @onclick="CargarDatosAsync" title="Actualizar datos">
                <MudIcon Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" />
            </button>
        </MudTooltip>
    </div>
</div>

<!-- Tarjetas de Estadísticas Globales (KPIs estilo Soft SaaS Premium) -->
<MudGrid Class="mb-6">
    @if (IsLoading && !Aulas.Any())
    {
        @for (int s = 0; s < 4; s++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Height="18px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="36px" Height="36px" />
                    </div>
                    <div>
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="40px" Class="mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="65%" Height="24px" Class="rounded-pill" />
                    </div>
                </MudPaper>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">INACTIVAS / OFFLINE</span>
                    <div class="kpi-icon-box kpi-icon-error">
                        <MudIcon Icon="@Icons.Material.Filled.PowerOff" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalOffline</div>
                    <div class="mt-2">
                        <span class="badge-soft @(TotalOffline > 0 ? "badge-soft-error" : "badge-soft-success")">
                            @(TotalOffline > 0 ? "⚠️ Necesitan atención" : "✓ Todo en orden")
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">EN USO AHORA</span>
                    <div class="kpi-icon-box kpi-icon-primary">
                        <MudIcon Icon="@Icons.Material.Filled.LaptopMac" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalEnUso</div>
                    <div class="mt-2">
                        <span class="badge-soft badge-soft-info">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Style="font-size: 13px;" /> @TotalEnUso sesiones activas
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">DISPONIBLES</span>
                    <div class="kpi-icon-box kpi-icon-success">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalDisponibles</div>
                    <div class="mt-2">
                        <span class="badge-soft badge-soft-success">
                            ● @(TotalPcs > 0 ? (TotalDisponibles * 100 / TotalPcs) : 100)% listas para uso
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="saas-card pa-5 h-100 d-flex flex-column justify-space-between">
                <div class="d-flex justify-space-between align-center mb-3">
                    <span class="kpi-title">TOTAL TERMINALES</span>
                    <div class="kpi-icon-box kpi-icon-purple">
                        <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                    </div>
                </div>
                <div>
                    <div class="kpi-number">@TotalPcs</div>
                    <div class="mt-2">
                        <span class="badge-soft badge-soft-purple">
                            🏢 @Aulas.Count laboratorios vinculados
                        </span>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<!-- Gráfico de Desempeño y Uso Mensual (Premium SaaS Card) -->
<MudPaper Elevation="0" Outlined="true" Class="saas-card pa-6 mb-6">
    <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.1rem;">
                    Resumen del desempeño mensual
                </MudText>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                Comparativo de sesiones activas, finalizadas e incidentes de energía
            </MudText>
        </div>

        <div class="d-flex align-center gap-4 flex-wrap">
            <MudCheckBox @bind-Value="MostrarEtiquetasGrafico" Label="Mostrar etiquetas" Color="Color.Primary" Dense="true" Size="Size.Small" />
            
            <div class="range-pill-group">
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 3 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(3)">3M</button>
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 6 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(6)">6M</button>
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 12 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(12)">12M</button>
                <button type="button" class="range-pill-btn @(RangoMesesSeleccionado == 24 ? "active" : "")" 
                        @onclick="() => CambiarRangoGrafico(24)">24M</button>
            </div>
        </div>
    </div>

    <div class="dashboard-chart-wrapper w-100 pt-2">
        <MudChart ChartType="ChartType.Bar" 
                  ChartSeries="@SeriesGrafico" 
                  ChartLabels="@MesesLabels" 
                  MatchBoundsToSize="true"
                  Width="100%" 
                  Height="320px" 
                  ChartOptions="_chartOptions" />
    </div>
</MudPaper>

<!-- Barra de Control y Supervisión de Aulas -->
<div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
    <div>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.15rem;">
            Supervisión de Terminales por Aula
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Control en tiempo real vía WebSockets y visor mosaico
        </MudText>
    </div>

    <div class="d-flex gap-2 align-center flex-wrap">
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="rounded-lg overflow-hidden">
            <MudButton Variant="@(ModoVista == 0 ? Variant.Filled : Variant.Outlined)" 
                       StartIcon="@Icons.Material.Filled.ViewModule" 
                       OnClick="() => ModoVista = 0">Tarjetas</MudButton>
            <MudButton Variant="@(ModoVista == 1 ? Variant.Filled : Variant.Outlined)" 
                       StartIcon="@Icons.Material.Filled.LiveTv" 
                       OnClick="() => ModoVista = 1">Mosaico</MudButton>
            <MudButton Variant="@(ModoVista == 2 ? Variant.Filled : Variant.Outlined)" 
                       StartIcon="@Icons.Material.Filled.TableRows" 
                       OnClick="() => ModoVista = 2">Tabla</MudButton>
        </MudButtonGroup>

        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Bolt" 
                   Size="Size.Small" Class="rounded-lg font-weight-bold" OnClick="ConfirmarWakeOnLanAulaAsync" Disabled="@(!Aulas.Any())">
            Encender Aula (WoL)
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Sensors" 
                   Size="Size.Small" Class="rounded-lg" OnClick="SondearTerminalesClickAsync" Disabled="IsPollingHeartbeats">
            @(IsPollingHeartbeats ? "Sondeando..." : "Sondear Aula")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Campaign" 
                   Size="Size.Small" Class="rounded-lg" OnClick="OpenMensajeDialog">
            Transmitir Alerta
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PowerSettingsNew" 
                   Size="Size.Small" Class="rounded-lg" OnClick="ConfirmarCierreMasivoAulaAsync" Disabled="@(!Aulas.Any())">
            Desloguear Aula
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.PowerOff" 
                   Size="Size.Small" Class="rounded-lg" OnClick="ConfirmarApagadoAulaAsync" Disabled="@(!Aulas.Any())">
            Apagar Aula
        </MudButton>
        <MudMenu Label="Deep Freeze" Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AcUnit"
                 Size="Size.Small" Class="rounded-lg font-weight-bold" Disabled="@(!Aulas.Any())" EndIcon="@Icons.Material.Filled.ArrowDropDown">
            <MudMenuItem Icon="@Icons.Material.Filled.LocalFireDepartment" IconColor="Color.Warning" OnClick="@(() => OpenFreezeAulaDialog("Descongelar"))">
                Descongelar Aula (Thawed)
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.AcUnit" IconColor="Color.Info" OnClick="@(() => OpenFreezeAulaDialog("Congelar"))">
                Congelar Aula (Frozen)
            </MudMenuItem>
        </MudMenu>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SystemUpdate" 
                   Size="Size.Small" Class="rounded-lg font-weight-bold" OnClick="OpenActualizarAulaDialog" Disabled="@(!Aulas.Any())">
            Actualizar Clientes
        </MudButton>
    </div>
</div>

<!-- Barra de Filtros y Búsqueda en Tiempo Real -->
<MudPaper Elevation="0" Outlined="true" Class="saas-card pa-3 mb-4 d-flex justify-space-between align-center flex-wrap gap-3">
    <div class="d-flex align-center gap-2 flex-grow-1" style="max-width: 440px; min-width: 250px;">
        <MudTextField @bind-Value="SearchTerm" 
                      Placeholder="Buscar por Hostname, IP, MAC o Estudiante..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search" 
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Clearable="true" 
                      Immediate="true"
                      Class="flex-grow-1" />
    </div>

    <div class="d-flex align-center gap-1 flex-wrap">
        <MudChip T="string" Color="@(FiltroEstado == null ? Color.Primary : Color.Default)" 
                 Variant="@(FiltroEstado == null ? Variant.Filled : Variant.Outlined)" 
                 Size="Size.Small" 
                 OnClick="() => FiltroEstado = null" 
                 Class="cursor-pointer font-weight-bold">
            Todos (@TotalPcs)
        </MudChip>
        <MudChip T="string" Color="Color.Info" 
                 Variant="@(FiltroEstado == EstadoComputadora.EnUso ? Variant.Filled : Variant.Outlined)" 
                 Size="Size.Small" 
                 OnClick="() => FiltroEstado = (FiltroEstado == EstadoComputadora.EnUso ? null : EstadoComputadora.EnUso)" 
                 Class="cursor-pointer font-weight-bold">
            🟢 En Uso (@TotalEnUso)
        </MudChip>
        <MudChip T="string" Color="Color.Success" 
                 Variant="@(FiltroEstado == EstadoComputadora.Disponible ? Variant.Filled : Variant.Outlined)" 
                 Size="Size.Small" 
                 OnClick="() => FiltroEstado = (FiltroEstado == EstadoComputadora.Disponible ? null : EstadoComputadora.Disponible)" 
                 Class="cursor-pointer font-weight-bold">
            🔵 Disponibles (@TotalDisponibles)
        </MudChip>
        <MudChip T="string" Color="Color.Error" 
                 Variant="@(FiltroEstado == EstadoComputadora.Offline ? Variant.Filled : Variant.Outlined)" 
                 Size="Size.Small" 
                 OnClick="() => FiltroEstado = (FiltroEstado == EstadoComputadora.Offline ? null : EstadoComputadora.Offline)" 
                 Class="cursor-pointer font-weight-bold">
            🔴 Offline (@TotalOffline)
        </MudChip>
        <MudChip T="string" Color="Color.Warning" 
                 Variant="@(FiltroEstado == EstadoComputadora.Bloqueada ? Variant.Filled : Variant.Outlined)" 
                 Size="Size.Small" 
                 OnClick="() => FiltroEstado = (FiltroEstado == EstadoComputadora.Bloqueada ? null : EstadoComputadora.Bloqueada)" 
                 Class="cursor-pointer font-weight-bold">
            🟡 Bloqueadas (@TotalBloqueadas)
        </MudChip>
    </div>
</MudPaper>

<!-- Pestañas de Aulas & Grilla de Computadoras -->
@if (Aulas.Any())
{
    <MudTabs @bind-ActivePanelIndex="ActiveTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="saas-card rounded-lg overflow-hidden mb-6">
            @foreach (var aula in Aulas)
            {
                var pcsFiltradas = FiltrarComputadoras(aula.Computadoras).ToList();
                <MudTabPanel Text="@($"{aula.Nombre} ({(FiltroEstado != null || !string.IsNullOrWhiteSpace(SearchTerm) ? $"{pcsFiltradas.Count}/" : "")}{aula.Computadoras.Count} PCs)")" Icon="@Icons.Material.Filled.MeetingRoom" Class="pa-6">
                    @if (!pcsFiltradas.Any())
                    {
                        <div class="text-center pa-8">
                            <MudIcon Icon="@Icons.Material.Filled.FilterListOff" Size="Size.Large" Color="Color.Secondary" />
                            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-2 font-weight-bold">
                                No se encontraron computadoras con los filtros seleccionados en esta aula.
                            </MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="LimpiarFiltros" Class="mt-2">
                                Limpiar Filtros
                            </MudButton>
                        </div>
                    }
                    else if (ModoVista == 1)
                    {
                        <MudGrid>
                            @foreach (var pc in pcsFiltradas)
                            {
                                <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                                    <MudCard Elevation="0" Class="saas-card rounded-lg" Style="@($"{GetEstiloBordeCard(pc.EstadoActual)}; overflow: hidden; height: 100%;")">
                                        <div class="d-flex justify-space-between align-center px-3 py-2" style="background: rgba(0,0,0,0.35);">
                                            <div class="d-flex align-center gap-1 text-truncate" style="max-width: 60%;">
                                                <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-truncate">@pc.Hostname</MudText>
                                            </div>
                                            <div class="d-flex align-center gap-1">
                                                @if (pc.EstadoFreeze?.Equals("Congelado", StringComparison.OrdinalIgnoreCase) == true)
                                                {
                                                    <MudTooltip Text="Protección Activa (Congelado)">
                                                        <span style="font-size: 0.85rem;">🧊</span>
                                                    </MudTooltip>
                                                }
                                                else if (pc.EstadoFreeze?.Equals("Descongelado", StringComparison.OrdinalIgnoreCase) == true)
                                                {
                                                    <MudTooltip Text="Modo Mantenimiento (Descongelado)">
                                                        <span style="font-size: 0.85rem;">🔥</span>
                                                    </MudTooltip>
                                                }
                                                <MudChip T="string" Color="@GetChipColor(pc.EstadoActual)" Size="Size.Small" Class="font-weight-bold">
                                                    @GetEstadoTexto(pc.EstadoActual)
                                                </MudChip>
                                            </div>
                                        </div>

                                        <div style="position: relative; width: 100%; aspect-ratio: 16/9; background: #0f172a; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                             @onclick="() => AbrirZoomPantalla(pc)">
                                            @if (!string.IsNullOrEmpty(pc.MiniaturaBase64))
                                            {
                                                <img src="data:image/jpeg;base64,@pc.MiniaturaBase64" 
                                                     alt="Pantalla de @pc.Hostname" 
                                                     style="width: 100%; height: 100%; object-fit: cover;" />
                                                <div style="position: absolute; bottom: 6px; right: 6px; background: rgba(0,0,0,0.7); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; color: #fff;">
                                                    <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" Style="font-size: 14px; vertical-align: middle;" /> Ampliar
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center pa-4">
                                                    <MudIcon Icon="@(pc.EstadoActual == EstadoComputadora.Offline ? Icons.Material.Filled.PowerOff : Icons.Material.Filled.ScreenLockPortrait)" 
                                                             Size="Size.Large" Color="Color.Secondary" />
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                                                        @(pc.EstadoActual == EstadoComputadora.Offline ? "Terminal Offline" : "Esperando captura...")
                                                    </MudText>
                                                </div>
                                            }
                                        </div>

                                        <MudCardContent Class="py-2 px-3">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate" Style="max-width: 60%;">
                                                    @(pc.EstadoActual == EstadoComputadora.EnUso ? $"👤 {pc.EmailEstudianteActual}" : (pc.EstadoActual == EstadoComputadora.Disponible ? "🟢 Disponible" : "🔴 Offline"))
                                                </MudText>
                                                <div class="d-flex align-center gap-1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@pc.IpActual</MudText>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"ip_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.IpActual, $"ip_{pc.ComputadoraId}", "IP"))"
                                                            title="Copiar IP">
                                                        <MudIcon Icon="@(EstaCopiado($"ip_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            </div>
                                        </MudCardContent>

                                        <MudCardActions Class="justify-space-between px-3 py-1 flex-wrap gap-1">
                                            <div class="d-flex align-center gap-1">
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Chat" OnClick="() => AbrirMensajeDirecto(pc.Hostname)">
                                                    Mensaje
                                                </MudButton>
                                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Más opciones">
                                                    <MudMenuItem Icon="@Icons.Material.Filled.LocalFireDepartment" IconColor="Color.Warning" OnClick="@(() => OpenFreezePcDialog(pc, "Descongelar"))">Descongelar PC</MudMenuItem>
                                                    <MudMenuItem Icon="@Icons.Material.Filled.AcUnit" IconColor="Color.Info" OnClick="@(() => OpenFreezePcDialog(pc, "Congelar"))">Congelar PC</MudMenuItem>
                                                    <MudMenuItem Icon="@Icons.Material.Filled.SystemUpdate" IconColor="Color.Primary" OnClick="@(() => OpenActualizarPcDialog(pc))">Actualizar Cliente Kiosk</MudMenuItem>
                                                </MudMenu>
                                            </div>
                                            @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Block" OnClick="() => ConfirmarCierreForzadoAsync(pc.Hostname)">
                                                    Desloguear
                                                </MudButton>
                                            }
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else if (ModoVista == 2)
                    {
                        <MudTable Items="@pcsFiltradas" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="rounded-lg saas-card">
                            <HeaderContent>
                                <MudTh>Terminal</MudTh>
                                <MudTh>IP / MAC</MudTh>
                                <MudTh>Estado</MudTh>
                                <MudTh>Sesión Actual</MudTh>
                                <MudTh>Telemetría</MudTh>
                                <MudTh Style="text-align: right;">Acciones</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="pc">
                                <MudTd DataLabel="Terminal">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Small" Color="@GetChipColor(pc.EstadoActual)" />
                                        <div class="d-flex flex-column">
                                            <span class="font-weight-bold">@pc.Hostname</span>
                                            <div class="d-flex align-center gap-1">
                                                <span style="font-size: 0.72rem; color: #94A3B8;">v@(pc.VersionClienteKiosk ?? "1.0.0")</span>
                                                @if (pc.EstadoFreeze?.Equals("Congelado", StringComparison.OrdinalIgnoreCase) == true)
                                                {
                                                    <span style="font-size: 0.72rem; color: #38bdf8;">• 🧊 Congelado</span>
                                                }
                                                else if (pc.EstadoFreeze?.Equals("Descongelado", StringComparison.OrdinalIgnoreCase) == true)
                                                {
                                                    <span style="font-size: 0.72rem; color: #fb923c;">• 🔥 Descongelado</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="IP / MAC">
                                    <div class="d-flex flex-column">
                                        <div class="d-flex align-center gap-1">
                                            <span style="font-family: monospace; font-size: 0.85rem;">@pc.IpActual</span>
                                            <button type="button" class="btn-copy-micro @(EstaCopiado($"ip_{pc.ComputadoraId}") ? "copied" : "")"
                                                    @onclick="@(() => CopiarConFeedbackAsync(pc.IpActual, $"ip_{pc.ComputadoraId}", "IP"))"
                                                    title="Copiar IP">
                                                <MudIcon Icon="@(EstaCopiado($"ip_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                            </button>
                                        </div>
                                        <span style="font-size: 0.75rem; color: #94A3B8;">@pc.MacAddress</span>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Estado">
                                    <MudChip T="string" Color="@GetChipColor(pc.EstadoActual)" Size="Size.Small" Class="font-weight-bold">
                                        @GetEstadoTexto(pc.EstadoActual)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Sesión Actual">
                                    @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                    {
                                        <div class="d-flex flex-column">
                                            <span class="font-weight-bold text-truncate" style="max-width: 220px; color: #38BDF8;">
                                                👤 @pc.EmailEstudianteActual
                                            </span>
                                            <span style="font-size: 0.75rem; color: #94A3B8;">
                                                ⏱️ @CalcularTiempoTranscurrido(pc.HoraInicioSesion)
                                            </span>
                                        </div>
                                    }
                                    else if (pc.EstadoActual == EstadoComputadora.Disponible)
                                    {
                                        <span style="color: #10B981; font-size: 0.85rem;">🟢 Libre</span>
                                    }
                                    else
                                    {
                                        <span style="color: #EF4444; font-size: 0.85rem;">🔴 Desconectada</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Telemetría">
                                    @if (_telemetriaMap.TryGetValue(pc.ComputadoraId, out var telem))
                                    {
                                        <div class="d-flex gap-1 align-center flex-wrap">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                     Color="@(telem.CpuUso > 85 ? Color.Error : (telem.CpuUso > 65 ? Color.Warning : Color.Success))" 
                                                     Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                CPU: @(telem.CpuUso)%
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                     Color="@(telem.RamUso > 85 ? Color.Error : Color.Info)" 
                                                     Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                RAM: @(telem.RamUso)%
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                     Color="@(telem.DiscoLibreGb < 10 ? Color.Error : Color.Default)" 
                                                     Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                @(telem.DiscoLibreGb)GB
                                            </MudChip>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: #64748B; font-size: 0.8rem;">—</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Acciones" Style="text-align: right;">
                                    <div class="d-flex justify-end align-center gap-1">
                                        <MudTooltip Text="Enviar Mensaje Directo">
                                            <MudIconButton Icon="@Icons.Material.Filled.Chat" Color="Color.Warning" Size="Size.Small" OnClick="() => AbrirMensajeDirecto(pc.Hostname)" />
                                        </MudTooltip>
                                        @if (!string.IsNullOrEmpty(pc.MiniaturaBase64))
                                        {
                                            <MudTooltip Text="Ver Pantalla en Vivo">
                                                <MudIconButton Icon="@Icons.Material.Filled.LiveTv" Color="Color.Info" Size="Size.Small" OnClick="() => AbrirZoomPantalla(pc)" />
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="Ficha Técnica & Salud">
                                            <MudIconButton Icon="@Icons.Material.Filled.Memory" Color="Color.Primary" Size="Size.Small" OnClick="() => AbrirFichaTecnicaAsync(pc)" />
                                        </MudTooltip>
                                        @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                        {
                                            <MudTooltip Text="Desloguear Sesión">
                                                <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small" OnClick="() => ConfirmarCierreForzadoAsync(pc.Hostname)" />
                                            </MudTooltip>
                                        }
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                            <MudMenuItem Icon="@Icons.Material.Filled.Bolt" IconColor="Color.Warning" OnClick="() => EnviarWakeOnLanPcAsync(pc)">Encender Terminal (Wake-on-LAN)</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.Sensors" IconColor="Color.Info" OnClick="() => SondearTerminalIndividualAsync(pc.Hostname)">Sondear Terminal</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.LocalFireDepartment" IconColor="Color.Warning" OnClick="@(() => OpenFreezePcDialog(pc, "Descongelar"))">Descongelar PC (Thawed)</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.AcUnit" IconColor="Color.Info" OnClick="@(() => OpenFreezePcDialog(pc, "Congelar"))">Congelar PC (Frozen)</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.SystemUpdate" IconColor="Color.Primary" OnClick="@(() => OpenActualizarPcDialog(pc))">Actualizar Cliente Kiosk</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.History" IconColor="Color.Info" OnClick="@(() => NavigationManager.NavigateTo($"/auditoria?hostname={Uri.EscapeDataString(pc.Hostname)}"))">Historial de Sesiones</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.PowerSettingsNew" IconColor="Color.Error" OnClick="() => ConfirmarApagadoPcAsync(pc)">Apagar</MudMenuItem>
                                            <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" IconColor="Color.Warning" OnClick="() => ConfirmarReinicioPcAsync(pc)">Reiniciar</MudMenuItem>
                                        </MudMenu>
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var pc in pcsFiltradas)
                            {
                                <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                                    <div style="height: 100%;">
                                        <MudCard Elevation="0" Class="saas-card rounded-lg mud-hover" Style="@($"{GetEstiloBordeCard(pc.EstadoActual)}; height: 100%;")">
                                            <MudCardHeader Class="pb-2">
                                                <CardHeaderContent>
                                                    <div class="d-flex flex-column">
                                                        <MudText Typo="Typo.h6" Class="font-weight-bold">@pc.Hostname</MudText>
                                                        <span style="font-size: 0.72rem; color: #94A3B8;">v@(pc.VersionClienteKiosk ?? "1.0.0")</span>
                                                    </div>
                                                </CardHeaderContent>
                                                <CardHeaderActions>
                                                    <div class="d-flex align-center gap-1">
                                                        @if (pc.EstadoFreeze?.Equals("Congelado", StringComparison.OrdinalIgnoreCase) == true)
                                                        {
                                                            <MudTooltip Text="Protección Activa (Deep Freeze / UWF)">
                                                                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Class="font-weight-bold px-1" Style="font-size: 0.7rem; height: 22px;">
                                                                    🧊 Congelado
                                                                </MudChip>
                                                            </MudTooltip>
                                                        }
                                                        else if (pc.EstadoFreeze?.Equals("Descongelado", StringComparison.OrdinalIgnoreCase) == true)
                                                        {
                                                            <MudTooltip Text="Modo Mantenimiento (Descongelado)">
                                                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small" Class="font-weight-bold px-1" Style="font-size: 0.7rem; height: 22px;">
                                                                    🔥 Descongelado
                                                                </MudChip>
                                                            </MudTooltip>
                                                        }
                                                        <MudChip T="string" Color="@GetChipColor(pc.EstadoActual)" Size="Size.Small" Class="font-weight-bold">
                                                            @GetEstadoTexto(pc.EstadoActual)
                                                        </MudChip>
                                                    </div>
                                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Opciones">
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Bolt" IconColor="Color.Warning" OnClick="() => EnviarWakeOnLanPcAsync(pc)">
                                                            Encender Terminal (Wake-on-LAN)
                                                        </MudMenuItem>
                                                        @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                                        {
                                                            <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Error" OnClick="() => ConfirmarCierreForzadoAsync(pc.Hostname)">
                                                                Desloguear Sesión
                                                            </MudMenuItem>
                                                        }
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Chat" IconColor="Color.Warning" OnClick="() => AbrirMensajeDirecto(pc.Hostname)">
                                                            Enviar Mensaje Directo
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.LiveTv" IconColor="Color.Info" OnClick="() => AbrirZoomPantalla(pc)">
                                                            Ver Pantalla en Vivo
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopiarAlPortapapeles(pc.IpActual, "IP"))">
                                                            Copiar IP
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Fingerprint" OnClick="@(() => CopiarAlPortapapeles(pc.MacAddress, "MAC"))">
                                                            Copiar MAC
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Sensors" IconColor="Color.Info" OnClick="() => SondearTerminalIndividualAsync(pc.Hostname)">
                                                            Sondear / Ping Terminal
                                                        </MudMenuItem>
                                                        <MudDivider Class="my-1" />
                                                        <MudMenuItem Icon="@Icons.Material.Filled.LocalFireDepartment" IconColor="Color.Warning" OnClick="@(() => OpenFreezePcDialog(pc, "Descongelar"))">
                                                            Descongelar PC (Thawed / Mantenimiento)
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.AcUnit" IconColor="Color.Info" OnClick="@(() => OpenFreezePcDialog(pc, "Congelar"))">
                                                            Congelar PC (Frozen / Proteger)
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.SystemUpdate" IconColor="Color.Primary" OnClick="@(() => OpenActualizarPcDialog(pc))">
                                                            Actualizar Cliente Kiosk
                                                        </MudMenuItem>
                                                        <MudDivider Class="my-1" />
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Memory" IconColor="Color.Primary" OnClick="() => AbrirFichaTecnicaAsync(pc)">
                                                            Ficha Técnica & Salud
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.History" IconColor="Color.Info" OnClick="@(() => NavigationManager.NavigateTo($"/auditoria?hostname={Uri.EscapeDataString(pc.Hostname)}"))">
                                                            Historial de Sesiones
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.PowerSettingsNew" IconColor="Color.Error" OnClick="() => ConfirmarApagadoPcAsync(pc)">
                                                            Apagar Terminal
                                                        </MudMenuItem>
                                                        <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" IconColor="Color.Warning" OnClick="() => ConfirmarReinicioPcAsync(pc)">
                                                            Reiniciar Terminal
                                                        </MudMenuItem>
                                                    </MudMenu>
                                                </CardHeaderActions>
                                            </MudCardHeader>

                                        <MudCardContent Class="py-2">
                                            <div class="d-flex align-center justify-space-between mb-1 flex-wrap gap-1">
                                                <div class="d-flex align-center gap-1 text-truncate">
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space: nowrap;"><strong>IP:</strong> @pc.IpActual</MudText>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"ip_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.IpActual, $"ip_{pc.ComputadoraId}", "IP"))"
                                                            title="Copiar IP">
                                                        <MudIcon Icon="@(EstaCopiado($"ip_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                                <div class="d-flex align-center gap-1 text-truncate">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: nowrap;">@pc.MacAddress</MudText>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"mac_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.MacAddress, $"mac_{pc.ComputadoraId}", "MAC"))"
                                                            title="Copiar MAC">
                                                        <MudIcon Icon="@(EstaCopiado($"mac_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.Fingerprint)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            </div>

                                            @if (_telemetriaMap.TryGetValue(pc.ComputadoraId, out var telem))
                                            {
                                                <div class="d-flex gap-1 align-center flex-wrap my-1">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                             Color="@(telem.CpuUso > 85 ? Color.Error : (telem.CpuUso > 65 ? Color.Warning : Color.Success))" 
                                                             Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                        CPU: @(telem.CpuUso)%
                                                    </MudChip>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" 
                                                             Color="@(telem.RamUso > 85 ? Color.Error : Color.Info)" 
                                                             Class="px-1 py-0 font-weight-bold" Style="font-size: 0.75rem; height: 20px;">
                                                        RAM: @(telem.RamUso)%
                                                    </MudChip>
                                                    @if (telem.DiscoLibreGb < 10)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" 
                                                                 Icon="@Icons.Material.Filled.Warning" Class="px-1 py-0 font-weight-bold" Style="font-size: 0.7rem; height: 20px;">
                                                            @($"{telem.DiscoLibreGb}GB Libre")
                                                        </MudChip>
                                                    }
                                                </div>
                                            }

                                            @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                            {
                                                <div class="pa-2 rounded mt-2 d-flex align-center justify-space-between" style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.3);">
                                                    <div class="text-truncate mr-1">
                                                        <MudText Typo="Typo.body2" Color="Color.Info" Class="font-weight-bold text-truncate">
                                                            👤 @pc.EmailEstudianteActual
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Info">
                                                            ⏱️ @CalcularTiempoTranscurrido(pc.HoraInicioSesion)
                                                        </MudText>
                                                    </div>
                                                    <button type="button" class="btn-copy-micro @(EstaCopiado($"email_{pc.ComputadoraId}") ? "copied" : "")"
                                                            @onclick="@(() => CopiarConFeedbackAsync(pc.EmailEstudianteActual, $"email_{pc.ComputadoraId}", "Email"))"
                                                            title="Copiar correo del estudiante">
                                                        <MudIcon Icon="@(EstaCopiado($"email_{pc.ComputadoraId}") ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            }
                                            else if (pc.EstadoActual == EstadoComputadora.Disponible)
                                            {
                                                <div class="pa-2 rounded mt-2" style="background: rgba(34, 197, 94, 0.08); border: 1px dashed rgba(34, 197, 94, 0.3);">
                                                    <MudText Typo="Typo.caption" Color="Color.Success">
                                                        🟢 Lista para recibir estudiante
                                                    </MudText>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="pa-2 rounded mt-2" style="background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.3);">
                                                    <MudText Typo="Typo.caption" Color="Color.Error">
                                                        🔴 Sin señal (>2m sin heartbeat)
                                                    </MudText>
                                                </div>
                                            }
                                        </MudCardContent>

                                        <MudCardActions Class="justify-space-between pt-1 flex-wrap gap-1">
                                            <div class="d-flex align-center gap-1">
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Chat" OnClick="() => AbrirMensajeDirecto(pc.Hostname)">
                                                    Mensaje
                                                </MudButton>
                                                @if (!string.IsNullOrEmpty(pc.MiniaturaBase64))
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.LiveTv" Color="Color.Info" Size="Size.Small" OnClick="() => AbrirZoomPantalla(pc)" aria-label="Ver pantalla en vivo" />
                                                }
                                            </div>
                                            @if (pc.EstadoActual == EstadoComputadora.EnUso)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Block" OnClick="() => ConfirmarCierreForzadoAsync(pc.Hostname)">
                                                    Desloguear
                                                </MudButton>
                                            }
                                        </MudCardActions>
                                        </MudCard>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudTabPanel>
            }
        </MudTabs>
}
else if (IsLoading)
{
    <div class="saas-card rounded-lg pa-6 mb-6">
        <div class="d-flex align-center justify-space-between mb-4">
            <div class="d-flex align-center gap-2">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="140px" Height="36px" Class="rounded-lg" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="140px" Height="36px" Class="rounded-lg" />
            </div>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="36px" Class="rounded-lg" />
        </div>
        <MudGrid>
            @for (int s = 0; s < 8; s++)
            {
                <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                    <MudCard Elevation="0" Class="saas-card rounded-lg pa-4">
                        <div class="d-flex justify-space-between align-center mb-3">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Height="22px" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="70px" Height="22px" Class="rounded-pill" />
                        </div>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="130px" Class="rounded-lg mb-3" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Height="16px" Class="mb-1" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="14px" />
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </div>
}
else
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-4">
        ⚠️ No se pudieron cargar los datos del servidor central. Asegúrate de que la API esté corriendo en http://localhost:5256.
    </MudAlert>
}

<!-- Modal Transmitir Alerta Masiva (Aula o Global) -->
<MudDialog @bind-Visible="MostrarModalMensaje" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Warning">
            <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="mr-2" /> Transmitir Alerta a Terminales
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            El mensaje aparecerá inmediatamente en pantalla completa sobre las terminales seleccionadas.
        </MudText>
        <MudSelect T="int" @bind-Value="DestinoAulaId" Label="Destino de la Alerta" Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense">
            <MudSelectItem T="int" Value="0">📢 Todas las Aulas (Transmisión Global)</MudSelectItem>
            @foreach (var aula in Aulas)
            {
                <MudSelectItem T="int" Value="@aula.AulaId">🏫 Aula: @aula.Nombre (@aula.Computadoras.Count PCs)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="MensajeTexto" Label="Mensaje de Alerta" Variant="Variant.Outlined" 
                      Lines="3" Placeholder="Ej: El laboratorio cerrará en 10 minutos. Por favor guarden su trabajo." Required="true" FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalMensaje = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(string.IsNullOrWhiteSpace(MensajeTexto) || IsSendingMessage)" 
                   StartIcon="@Icons.Material.Filled.Send" OnClick="EnviarMensajeAsync">
            @(IsSendingMessage ? "Transmitiendo..." : "Transmitir Alerta")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Modal Enviar Mensaje Directo a PC Específica -->
<MudDialog @bind-Visible="MostrarModalMensajeDirecto" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Warning">
            <MudIcon Icon="@Icons.Material.Filled.Chat" Class="mr-2" /> Enviar Mensaje a @TargetHostnameMensaje
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Este aviso aparecerá en una ventana emergente en pantalla completa sobre la terminal <strong>@TargetHostnameMensaje</strong>.
        </MudText>
        <MudTextField @bind-Value="MensajeDirectoTexto" Label="Contenido del Mensaje" Variant="Variant.Outlined" 
                      Lines="3" Placeholder="Ej: Por favor acercarse al mostrador del encargado de laboratorio." Required="true" FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalMensajeDirecto = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(string.IsNullOrWhiteSpace(MensajeDirectoTexto) || IsSendingMessage)" 
                   StartIcon="@Icons.Material.Filled.Send" OnClick="EnviarMensajeDirectoAsync">
            @(IsSendingMessage ? "Enviando..." : "Enviar Mensaje")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Modal Zoom de Pantalla en Vivo -->
<MudDialog @bind-Visible="MostrarModalZoom" Options="_zoomDialogOptions">
    <TitleContent>
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.LiveTv" Class="mr-2" />
                Pantalla en Vivo: @PcZoom?.Hostname (@PcZoom?.IpActual)
            </MudText>
            @if (PcZoom?.EstadoActual == EstadoComputadora.EnUso)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                    👤 @PcZoom.EmailEstudianteActual
                </MudChip>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (PcZoom != null && !string.IsNullOrEmpty(PcZoom.MiniaturaBase64))
        {
            <div class="text-center" style="background: #000; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
                <img src="data:image/jpeg;base64,@PcZoom.MiniaturaBase64" 
                     alt="Vista en vivo de @PcZoom.Hostname" 
                     style="width: 100%; max-height: 70vh; object-fit: contain; display: block;" />
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block text-center">
                📡 Actualización automática en tiempo real vía WebSockets
            </MudText>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="my-4">No hay captura disponible actualmente para esta terminal.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (PcZoom?.EstadoActual == EstadoComputadora.EnUso)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Chat" 
                       OnClick="() => { MostrarModalZoom = false; if (PcZoom != null) AbrirMensajeDirecto(PcZoom.Hostname); }">
                Enviar Mensaje
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block" 
                       OnClick="async () => { MostrarModalZoom = false; if (PcZoom != null) await ConfirmarCierreForzadoAsync(PcZoom.Hostname); }">
                Desloguear
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalZoom = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<!-- Modal Gestión de Congelado / Descongelado (Deep Freeze / UWF) -->
<MudDialog @bind-Visible="MostrarModalFreeze" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(FreezeAccion == "Descongelar" ? Icons.Material.Filled.LocalFireDepartment : Icons.Material.Filled.AcUnit)" 
                     Color="@(FreezeAccion == "Descongelar" ? Color.Warning : Color.Info)" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                @(FreezeAccion == "Descongelar" ? "Descongelar Terminales (Thawed)" : "Congelar Terminales (Frozen)")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="@(FreezeAccion == "Descongelar" ? Severity.Warning : Severity.Info)" Class="mb-3">
            @if (FreezeTargetComputadoraId.HasValue)
            {
                <span>Objetivo: Terminal individual <strong>@FreezeTargetHostname</strong>.</span>
            }
            else
            {
                <span>Objetivo: Aula completa <strong>@FreezeTargetAulaNombre</strong>.</span>
            }
            <br />
            @if (FreezeAccion == "Descongelar")
            {
                <span class="mt-1 d-block">
                    ⚠️ Esta orden desactivará la protección contra escrituras (Deep Freeze / UWF) y <strong>reiniciará automáticamente</strong> el equipo para entrar en modo mantenimiento, permitiendo instalar programas o actualizaciones permanentes.
                </span>
            }
            else
            {
                <span class="mt-1 d-block">
                    🔒 Esta orden activará la protección de disco y <strong>reiniciará automáticamente</strong> el equipo. Todas las modificaciones futuras se descartarán en cada reinicio.
                </span>
            }
        </MudAlert>

        <MudTextField @bind-Value="FreezeClave" Label="Clave de Deep Freeze (Opcional si usa clave)" 
                      InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="Déjalo en blanco si tu instalación no requiere contraseña CLI (DFC)." FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalFreeze = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(FreezeAccion == "Descongelar" ? Color.Warning : Color.Info)" 
                   Disabled="IsExecutingFreeze" StartIcon="@(FreezeAccion == "Descongelar" ? Icons.Material.Filled.LocalFireDepartment : Icons.Material.Filled.AcUnit)" 
                   OnClick="EjecutarComandoFreezeAsync">
            @(IsExecutingFreeze ? "Transmitiendo orden..." : (FreezeAccion == "Descongelar" ? "Sí, Descongelar y Reiniciar" : "Sí, Congelar y Reiniciar"))
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Modal Actualización Remota OTA de Clientes Kiosk -->
<MudDialog @bind-Visible="MostrarModalActualizar" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.SystemUpdate" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                Actualizar Cliente Kiosk Over-the-Air (OTA)
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (IsLoadingUpdateInfo)
        {
            <div class="pa-4 text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Consultando paquete de actualización en el servidor...</MudText>
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @if (UpdateTargetComputadoraId.HasValue)
                {
                    <span>Se enviará la orden de descarga y auto-reemplazo a la terminal <strong>@UpdateTargetHostname</strong>.</span>
                }
                else
                {
                    <span>Se enviará la orden a todas las computadoras del aula <strong>@UpdateTargetAulaNombre</strong>.</span>
                }
            </MudText>

            @if (InfoActualizacion != null && InfoActualizacion.Disponible)
            {
                <MudPaper Outlined="true" Class="pa-3 rounded-lg mb-3" Style="background: rgba(37,99,235,0.04); border-color: rgba(37,99,235,0.2);">
                    <div class="d-flex justify-space-between align-center mb-1">
                        <span class="font-weight-bold" style="color: var(--mud-palette-primary);">Paquete Oficial Disponible:</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">v@InfoActualizacion.Version</MudChip>
                    </div>
                    <div style="font-size: 0.8rem; color: var(--mud-palette-text-secondary);">
                        <div>Archivo: <strong>@InfoActualizacion.NombreArchivo</strong> (@(InfoActualizacion.TamanoMb) MB)</div>
                        @if (!string.IsNullOrEmpty(InfoActualizacion.Sha256))
                        {
                            <div class="text-truncate">SHA256: <code style="font-size: 0.75rem;">@(InfoActualizacion.Sha256.Substring(0, Math.Min(16, InfoActualizacion.Sha256.Length)))...</code></div>
                        }
                    </div>
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    La API distribuirá el binario actual del cliente disponible en el repositorio central.
                </MudAlert>
            }

            <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-2" Style="font-size: 0.78rem;">
                💡 <strong>Nota sobre equipos congelados:</strong> Si las terminales tienen Deep Freeze activo, se recomienda <em>descongelarlas</em> primero para que la nueva versión persista después de reiniciar.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalActualizar = false">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(IsLoadingUpdateInfo || IsExecutingUpdate)"
                   StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="EjecutarComandoActualizarAsync">
            @(IsExecutingUpdate ? "Enviando orden..." : "Iniciar Actualización OTA")
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    private List<AulaEstadoDto> Aulas = [];
    private bool IsLoading = true;
    private bool IsSignalRConnected => SignalRService.IsConnected;
    private int ActiveTabIndex = 0;
    private int ModoVista = 0; // 0 = Tarjetas, 1 = Mosaico en Vivo, 2 = Tabla Compacta
    private bool ModoMosaico
    {
        get => ModoVista == 1;
        set => ModoVista = value ? 1 : 0;
    }
    private string SearchTerm = "";
    private EstadoComputadora? FiltroEstado = null;
    private int TotalBloqueadas => Aulas.Sum(a => a.Computadoras.Count(c => c.EstadoActual == EstadoComputadora.Bloqueada));

    private void LimpiarFiltros()
    {
        SearchTerm = "";
        FiltroEstado = null;
        StateHasChanged();
    }

    private IEnumerable<ComputadoraTarjetaDto> FiltrarComputadoras(IEnumerable<ComputadoraTarjetaDto> computadoras)
    {
        var query = computadoras;

        if (FiltroEstado.HasValue)
        {
            query = query.Where(c => c.EstadoActual == FiltroEstado.Value);
        }

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var term = SearchTerm.Trim().ToLowerInvariant();
            query = query.Where(c => 
                (c.Hostname?.ToLowerInvariant().Contains(term) ?? false) ||
                (c.IpActual?.ToLowerInvariant().Contains(term) ?? false) ||
                (c.MacAddress?.ToLowerInvariant().Contains(term) ?? false) ||
                (c.EmailEstudianteActual?.ToLowerInvariant().Contains(term) ?? false));
        }

        return query;
    }

    private readonly HashSet<string> _copiedKeys = [];

    private async Task CopiarConFeedbackAsync(string? texto, string key, string label = "")
    {
        if (string.IsNullOrEmpty(texto)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("clipboardHelper.copyText", texto);
            _copiedKeys.Add(key);
            StateHasChanged();
            Snackbar.Add($"📋 {(string.IsNullOrEmpty(label) ? "Copiado" : label)} al portapapeles: {texto}", Severity.Success);
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copiedKeys.Remove(key);
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            Snackbar.Add("No se pudo copiar al portapapeles", Severity.Warning);
        }
    }

    private bool EstaCopiado(string key) => _copiedKeys.Contains(key);

    private bool MostrarModalMensaje = false;
    private bool MostrarModalMensajeDirecto = false;
    private bool MostrarModalZoom = false;
    private bool IsSendingMessage = false;

    private int DestinoAulaId = 0;
    private string MensajeTexto = "";
    private string TargetHostnameMensaje = "";
    private string MensajeDirectoTexto = "";
    private ComputadoraTarjetaDto? PcSeleccionada;
    private ComputadoraTarjetaDto? PcZoom;

    private bool _mostrarEtiquetasGrafico;
    private bool MostrarEtiquetasGrafico
    {
        get => _mostrarEtiquetasGrafico;
        set
        {
            _mostrarEtiquetasGrafico = value;
            _chartOptions.ShowValues = value;
        }
    }
    private int RangoMesesSeleccionado = 12;

    private readonly BarChartOptions _chartOptions = new()
    {
        ChartPalette = new[] { "#38bdf8", "#818cf8", "#f472b6" },
        YAxisLines = true,
        XAxisLines = false
    };

    private string[] MesesLabels = [];
    private List<ChartSeries<double>> SeriesGrafico = [];

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        Position = DialogPosition.Center
    };

    private readonly DialogOptions _zoomDialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        Position = DialogPosition.Center
    };

    private int TotalPcs => Aulas.Sum(a => a.Computadoras.Count);
    private int TotalEnUso => Aulas.Sum(a => a.Computadoras.Count(c => c.EstadoActual == EstadoComputadora.EnUso));
    private int TotalDisponibles => Aulas.Sum(a => a.Computadoras.Count(c => c.EstadoActual == EstadoComputadora.Disponible));
    private int TotalOffline => Aulas.Sum(a => a.Computadoras.Count(c => c.EstadoActual == EstadoComputadora.Offline));

    private string ObtenerNombreSaludo()
    {
        var nombre = SessionService.CurrentUser?.NombreCompleto;
        if (string.IsNullOrWhiteSpace(nombre))
            return "Administrador";
        return nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Administrador";
    }

    public record LiveTelemetria(int CpuUso, int RamUso, int DiscoLibreGb, DateTime UltimaLectura);
    private readonly Dictionary<int, LiveTelemetria> _telemetriaMap = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosGraficoAsync();
        await CargarDatosAsync();

        SignalRService.OnEstadoComputadoraCambiado += HandleEstadoComputadoraCambiado;
        SignalRService.OnTelemetriaRecibida += HandleTelemetriaRecibida;
        SignalRService.OnMiniaturaPantallaRecibida += HandleMiniaturaPantallaRecibida;

        string baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5256/";
        string hubUrl = baseUrl.TrimEnd('/') + "/hubs/laboratorio";
        await SignalRService.StartAsync(hubUrl);
    }

    private async Task CargarDatosGraficoAsync()
    {
        try
        {
            var dto = await ApiClient.GetDesempenoMensualAsync(RangoMesesSeleccionado);
            if (dto != null && dto.Meses.Count > 0)
            {
                MesesLabels = dto.Meses.Select(m => m.MesLabel).ToArray();
                var datosActivas = dto.Meses.Select(m => (double)m.SesionesActivas).ToArray();
                var datosCompletadas = dto.Meses.Select(m => (double)m.SesionesCompletadas).ToArray();
                var datosIncidentes = dto.Meses.Select(m => (double)m.InfraccionesEnergia).ToArray();

                SeriesGrafico = new List<ChartSeries<double>>
                {
                    new ChartSeries<double> { Name = "Sesiones Activas", Data = datosActivas },
                    new ChartSeries<double> { Name = "Sesiones Finalizadas", Data = datosCompletadas },
                    new ChartSeries<double> { Name = "Infracciones Energía", Data = datosIncidentes }
                };
            }
            else
            {
                EstablecerGraficoVacio();
            }
        }
        catch (Exception)
        {
            EstablecerGraficoVacio();
        }
        StateHasChanged();
    }

    private void EstablecerGraficoVacio()
    {
        int count = RangoMesesSeleccionado;
        var meses = new List<string>();
        var fecha = DateTime.UtcNow.AddMonths(-count + 1);
        for (int i = 0; i < count; i++)
        {
            meses.Add(fecha.AddMonths(i).ToString("MMM", new System.Globalization.CultureInfo("es-ES")).ToUpper());
        }
        MesesLabels = meses.ToArray();
        SeriesGrafico = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "Sesiones Activas", Data = new double[count] },
            new ChartSeries<double> { Name = "Sesiones Finalizadas", Data = new double[count] },
            new ChartSeries<double> { Name = "Infracciones Energía", Data = new double[count] }
        };
    }

    private async Task CambiarRangoGrafico(int meses)
    {
        RangoMesesSeleccionado = meses;
        await CargarDatosGraficoAsync();
    }

    private void AbrirZoomPantalla(ComputadoraTarjetaDto pc)
    {
        PcZoom = pc;
        MostrarModalZoom = true;
    }

    private void HandleMiniaturaPantallaRecibida(int computadoraId, string hostname, string imagenBase64)
    {
        InvokeAsync(() =>
        {
            foreach (var aula in Aulas)
            {
                var pc = aula.Computadoras.FirstOrDefault(c => c.ComputadoraId == computadoraId || c.Hostname == hostname);
                if (pc != null)
                {
                    pc.MiniaturaBase64 = imagenBase64;
                    if (PcZoom != null && (PcZoom.ComputadoraId == computadoraId || PcZoom.Hostname == hostname))
                    {
                        PcZoom.MiniaturaBase64 = imagenBase64;
                    }
                    StateHasChanged();
                    break;
                }
            }
        });
    }

    private async Task CargarDatosAsync()
    {
        IsLoading = true;
        Aulas = await ApiClient.GetMapaAulasAsync();
        await CargarDatosGraficoAsync();
        IsLoading = false;
        StateHasChanged();
    }

    private void HandleTelemetriaRecibida(int computadoraId, string hostname, int cpuUso, int ramUso, int discoLibreGb)
    {
        InvokeAsync(() =>
        {
            _telemetriaMap[computadoraId] = new LiveTelemetria(cpuUso, ramUso, discoLibreGb, DateTime.UtcNow);
            StateHasChanged();
        });
    }

    private void HandleEstadoComputadoraCambiado(int computadoraId, string hostname, EstadoComputadora nuevoEstado, string? emailEstudiante)
    {
        foreach (var aula in Aulas)
        {
            var pc = aula.Computadoras.FirstOrDefault(c => c.ComputadoraId == computadoraId || c.Hostname == hostname);
            if (pc != null)
            {
                var index = aula.Computadoras.IndexOf(pc);
                var nuevaPc = new ComputadoraTarjetaDto(
                    pc.ComputadoraId,
                    pc.Hostname,
                    pc.IpActual,
                    pc.MacAddress,
                    nuevoEstado,
                    DateTime.UtcNow,
                    nuevoEstado == EstadoComputadora.EnUso ? emailEstudiante : null,
                    nuevoEstado == EstadoComputadora.EnUso ? DateTime.UtcNow : null,
                    pc.CpuModelo,
                    pc.RamTotalGb,
                    pc.DiscoTotalGb,
                    pc.DiscoLibreGb,
                    pc.SistemaOperativo,
                    pc.UptimeHoras,
                    pc.DiscosDetalleJson,
                    pc.VersionClienteKiosk,
                    pc.EstadoFreeze
                );
                nuevaPc.MiniaturaBase64 = pc.MiniaturaBase64;
                aula.Computadoras[index] = nuevaPc;
                InvokeAsync(StateHasChanged);
                break;
            }
        }
    }

    private void OpenMensajeDialog()
    {
        MensajeTexto = "";
        DestinoAulaId = Aulas.ElementAtOrDefault(ActiveTabIndex)?.AulaId ?? 0;
        MostrarModalMensaje = true;
    }

    private async Task EnviarWakeOnLanPcAsync(ComputadoraTarjetaDto pc)
    {
        if (string.IsNullOrWhiteSpace(pc.MacAddress))
        {
            Snackbar.Add($"La terminal '{pc.Hostname}' no cuenta con una dirección MAC registrada para Wake-on-LAN.", Severity.Warning);
            return;
        }

        Snackbar.Add($"⚡ Transmitiendo paquete Wake-on-LAN a '{pc.Hostname}' ({pc.MacAddress})...", Severity.Info);
        bool exito = await ApiClient.WakeOnLanComputadoraAsync(pc.ComputadoraId);
        if (exito)
        {
            Snackbar.Add($"✓ Paquete Wake-on-LAN enviado a '{pc.Hostname}'.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"No se pudo enviar el paquete Wake-on-LAN a '{pc.Hostname}'.", Severity.Error);
        }
    }

    private async Task ConfirmarWakeOnLanAulaAsync()
    {
        var aulaActual = Aulas.ElementAtOrDefault(ActiveTabIndex);
        if (aulaActual == null) return;

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Encendido Remoto (Wake-on-LAN)",
            $"¿Deseas enviar paquetes de encendido (Wake-on-LAN) a todas las computadoras del aula '{aulaActual.Nombre}' ({aulaActual.Computadoras.Count} PCs)?\nLos equipos que tengan Wake-on-LAN habilitado en su placa madre/BIOS se encenderán.",
            yesText: "Sí, Encender Aula", cancelText: "Cancelar"
        );

        if (result == true)
        {
            Snackbar.Add($"⚡ Transmitiendo ráfaga Wake-on-LAN a las PCs del Aula '{aulaActual.Nombre}'...", Severity.Info);
            bool exito = await ApiClient.WakeOnLanAulaAsync(aulaActual.AulaId);
            if (exito)
            {
                Snackbar.Add($"✓ Paquetes Wake-on-LAN transmitidos exitosamente a '{aulaActual.Nombre}'.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"No se pudo transmitir la orden Wake-on-LAN al aula '{aulaActual.Nombre}'.", Severity.Error);
            }
        }
    }

    private void AbrirMensajeDirecto(string hostname)
    {
        TargetHostnameMensaje = hostname;
        MensajeDirectoTexto = "";
        MostrarModalMensajeDirecto = true;
    }

    private async Task AbrirFichaTecnicaAsync(ComputadoraTarjetaDto pc)
