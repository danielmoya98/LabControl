    private async Task GuardarBloqueHorarioAsync()
    {
        if (NuevoAulaId <= 0)
        {
            MensajeError = "Por favor selecciona un aula válida.";
            return;
        }

        if (!HoraInicioTs.HasValue || !HoraFinTs.HasValue || HoraFinTs.Value <= HoraInicioTs.Value)
        {
            MensajeError = "La hora de fin debe ser posterior a la hora de inicio.";
            return;
        }

        IsSaving = true;
        MensajeError = null;

        int? periodoFinalId = NuevoBloquePeriodoId > 0 ? NuevoBloquePeriodoId : (PeriodoSeleccionadoId > 0 ? PeriodoSeleccionadoId : null);

        bool exito;
        if (IsEditMode)
        {
            exito = await ApiClient.UpdateBloqueHorarioAsync(
                BloqueIdSeleccionado,
                NuevoAulaId,
                NuevoDiaSemana,
                HoraInicioTs.Value,
                HoraFinTs.Value,
                EsRecreo,
                NuevaDescripcion,
                NuevoMateriaId,
                NuevoDocenteId,
                NuevoGrupoParalelo,
                esUsoLibre: false,
                periodoAcademicoId: periodoFinalId,
                docenteNombreManual: NuevoDocenteNombreManual,
                docenteEmailManual: NuevoDocenteEmailManual,
                materiaNombreManual: NuevoMateriaNombreManual
            );
        }
        else
        {
            exito = await ApiClient.CreateBloqueHorarioAsync(
                NuevoAulaId,
                NuevoDiaSemana,
                HoraInicioTs.Value,
                HoraFinTs.Value,
                EsRecreo,
                NuevaDescripcion,
                NuevoMateriaId,
                NuevoDocenteId,
                NuevoGrupoParalelo,
                esUsoLibre: false,
                periodoAcademicoId: periodoFinalId,
                docenteNombreManual: NuevoDocenteNombreManual,
                docenteEmailManual: NuevoDocenteEmailManual,
                materiaNombreManual: NuevoMateriaNombreManual
            );
        }

        if (exito)
        {
            Snackbar.Add(IsEditMode ? "¡Bloque horario actualizado exitosamente!" : "¡Bloque horario guardado exitosamente!", Severity.Success);
            MostrarModal = false;
            if (periodoFinalId.HasValue && periodoFinalId.Value > 0 && PeriodoSeleccionadoId != periodoFinalId.Value)
            {
                PeriodoSeleccionadoId = periodoFinalId.Value;
            }
            await CargarHorariosAsync();
        }
        else
        {
            MensajeError = IsEditMode
                ? "No se pudo actualizar el bloque horario. Revisa los datos ingresados."
                : "No se pudo registrar el bloque horario. Revisa los datos ingresados.";
        }

        IsSaving = false;
    }

    private async Task EjecutarClonacionHorariosAsync()
    {
        var bloquesOrigen = ListaHorarios.Where(h => h.DiaSemana == DiaOrigenClonacion).ToList();
        if (bloquesOrigen.Count == 0)
        {
            Snackbar.Add($"El día origen {DiaOrigenClonacion} no contiene ningún bloque para replicar.", Severity.Warning);
            return;
        }

        var diasDestino = new List<DiaSemana>();
        if (ClonarMartes && DiaOrigenClonacion != DiaSemana.Martes) diasDestino.Add(DiaSemana.Martes);
        if (ClonarMiercoles && DiaOrigenClonacion != DiaSemana.Miercoles) diasDestino.Add(DiaSemana.Miercoles);
        if (ClonarJueves && DiaOrigenClonacion != DiaSemana.Jueves) diasDestino.Add(DiaSemana.Jueves);
        if (ClonarViernes && DiaOrigenClonacion != DiaSemana.Viernes) diasDestino.Add(DiaSemana.Viernes);
        if (ClonarSabado && DiaOrigenClonacion != DiaSemana.Sabado) diasDestino.Add(DiaSemana.Sabado);

        if (diasDestino.Count == 0)
        {
            Snackbar.Add("Selecciona al menos un día destino diferente al día origen.", Severity.Warning);
            return;
        }

        IsSaving = true;
        int creados = 0;

        foreach (var destino in diasDestino)
        {
            foreach (var bloque in bloquesOrigen)
            {
                bool ok = await ApiClient.CreateBloqueHorarioAsync(
                    AulaSeleccionadaId,
                    destino,
                    bloque.HoraInicio,
                    bloque.HoraFin,
                    bloque.EsRecreo,
                    bloque.Descripcion,
                    bloque.MateriaId,
                    bloque.DocenteId,
                    bloque.GrupoParalelo,
                    bloque.EsUsoLibre,
                    periodoAcademicoId: bloque.PeriodoAcademicoId ?? (PeriodoSeleccionadoId > 0 ? PeriodoSeleccionadoId : null),
                    docenteNombreManual: bloque.DocenteNombreManual,
                    docenteEmailManual: bloque.DocenteEmailManual,
                    materiaNombreManual: bloque.MateriaNombreManual
                );
                if (ok) creados++;
            }
        }

        IsSaving = false;
        MostrarModalClonar = false;
        Snackbar.Add($"¡Replicación exitosa! Se crearon {creados} bloques horarios en {diasDestino.Count} días.", Severity.Success);
        await CargarHorariosAsync();
    }

    private async Task ConfirmarEliminarHorarioAsync(BloqueHorarioDto bloque)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación",
            $"¿Está seguro que desea eliminar el bloque horario de {bloque.DiaSemana} ({bloque.HoraInicio:hh\\:mm} - {bloque.HoraFin:hh\\:mm})?",
            yesText: "Sí, Eliminar", cancelText: "Cancelar");

        if (confirm == true)
        {
            bool exito = await ApiClient.DeleteBloqueHorarioAsync(bloque.Id);
            if (exito)
            {
                Snackbar.Add("Bloque horario eliminado exitosamente.", Severity.Info);
                await CargarHorariosAsync();
            }
            else
            {
                Snackbar.Add("No se pudo eliminar el bloque horario.", Severity.Error);
            }
        }
    }

