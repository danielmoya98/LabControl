@page "/horarios"
@using Microsoft.AspNetCore.Components.Web
@using LabControl.Application.Features.Aulas.Commands.CreateAula
@using LabControl.Application.Features.Horarios.Commands.CreateBloqueHorario
@using LabControl.Domain.Enums
@using LabControl.WebAdmin.Services
@inject LabApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Horarios y Turnos — Control de Laboratorios</PageTitle>

<!-- ENCABEZADO Y ACCIONES PRINCIPALES -->
<div class="d-flex justify-space-between align-center mb-5 flex-wrap gap-4">
    <div>
        <div class="d-flex align-center gap-2">
            <div class="pa-2 rounded-lg d-flex align-center justify-center" style="background: rgba(37, 99, 235, 0.1); width: 38px; height: 38px;">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Primary" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold" Style="font-size: 1.35rem; letter-spacing: -0.02em;">
                Gestión de Horarios y Recreos (Auto-Kickout)
            </MudText>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1" Style="font-size: 0.85rem;">
            Programación semanal de clases y franjas de receso con cierre automático de terminales
        </MudText>
    </div>
    <div class="d-flex gap-2 align-center flex-wrap">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.DateRange"
                   OnClick="OpenGestionPeriodosDialog"
                   Class="rounded-lg font-weight-bold"
                   Style="text-transform: none;">
            Semestres (@(ListaPeriodos.FirstOrDefault(p => p.Id == PeriodoSeleccionadoId)?.Nombre ?? "Actual"))
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ContentCopy"
                   OnClick="OpenClonarDialog"
                   Disabled="@(!ListaHorarios.Any())"
                   Class="rounded-lg font-weight-bold"
                   Style="text-transform: none;">
            Replicar a Otros Días
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog"
                   Class="rounded-lg font-weight-bold"
                   Style="text-transform: none; box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);">
            Configurar Nuevo Bloque
        </MudButton>
    </div>
</div>

<!-- BARRA DE SELECCIÓN DE AULA Y KPIs (SAAS REFINADO 8-10px) -->
<MudGrid Class="mb-5" Spacing="3">
    <!-- Card 1: Selector de Semestre y Laboratorio Activo -->
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 d-flex flex-column justify-center saas-card rounded-lg" Elevation="0" Style="height: 100%;">
            <div class="d-flex justify-space-between align-center mb-1">
                <span class="kpi-title">SEMESTRE / GESTIÓN</span>
                <span style="font-size: 0.72rem; color: #16a34a; font-weight: bold;">
                    @(ListaPeriodos.FirstOrDefault(p => p.Id == PeriodoSeleccionadoId)?.EsActual == true ? "⭐ Actual" : "📁 Histórico")
                </span>
            </div>
            <MudSelect T="int" 
                       Value="PeriodoSeleccionadoId" 
                       ValueChanged="OnPeriodoSeleccionadoChanged" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Outlined.CalendarMonth"
                       FullWidth="true"
                       Class="mb-2">
                @foreach (var p in ListaPeriodos)
                {
                    <MudSelectItem T="int" Value="@p.Id">@p.Nombre @(p.EsActual ? " ⭐ (Actual)" : "")</MudSelectItem>
                }
            </MudSelect>

            <span class="kpi-title mb-1">LABORATORIO ACTIVO</span>
            <MudSelect T="int" 
                       Value="AulaSeleccionadaId" 
                       ValueChanged="OnAulaSeleccionadaChanged" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Outlined.MeetingRoom"
                       FullWidth="true">
                @foreach (var aula in ListaAulas)
                {
                    <MudSelectItem T="int" Value="@aula.Id">@aula.Nombre (@aula.Capacidad equipos)</MudSelectItem>
                }
            </MudSelect>
        </MudPaper>
    </MudItem>

    <!-- Card 2: Bloques Totales -->
    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0" Style="height: 100%;">
            <div>
                <span class="kpi-title">BLOQUES TOTALES</span>
                <MudText Typo="Typo.h5" Class="kpi-number mt-1">@ListaHorarios.Count</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">
                    @ListaHorarios.Count(h => !h.EsRecreo) clases · @ListaHorarios.Count(h => h.EsRecreo) recesos
                </MudText>
            </div>
            <div class="kpi-icon-box kpi-icon-primary">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>

    <!-- Card 3: Horas Académicas -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0" Style="height: 100%;">
            <div>
                <span class="kpi-title">HORAS ACADÉMICAS</span>
                <MudText Typo="Typo.h5" Class="kpi-number mt-1" Style="color: #16a34a;">
                    @CalcularHorasSemanales().ToString("F1") hrs
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">
                    @ListaHorarios.Count(h => !h.EsRecreo) clases programadas
                </MudText>
            </div>
            <div class="kpi-icon-box kpi-icon-success">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>

    <!-- Card 4: Estado Actual en Vivo -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center justify-space-between saas-card rounded-lg" Elevation="0" Style="height: 100%;">
            <div>
                <span class="kpi-title">ESTADO ACTUAL EN VIVO</span>
                @if (ObtenerBloqueEnCurso() is var bloqueActual && bloqueActual != null)
                {
                    <div class="mt-1 d-flex align-center gap-1">
                        @if (bloqueActual.EsRecreo)
                        {
                            <span class="badge-soft-warning font-weight-bold" style="font-size: 0.75rem;">
                                ☕ En Receso (@bloqueActual.HoraInicio.ToString(@"hh\:mm") - @bloqueActual.HoraFin.ToString(@"hh\:mm"))
                            </span>
                        }
                        else
                        {
                            <span class="badge-soft-success font-weight-bold" style="font-size: 0.75rem;">
                                <span class="pulse-dot-green mr-1"></span>En Clase (@bloqueActual.HoraInicio.ToString(@"hh\:mm") - @bloqueActual.HoraFin.ToString(@"hh\:mm"))
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-1">
                        <span class="badge-soft-info" style="font-size: 0.75rem;">
                            ⚪ Aula Libre (Sin Clase)
                        </span>
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;" Class="mt-1 d-block">
                    Auto-Kickout configurado
                </MudText>
            </div>
            <div class="kpi-icon-box" style="background-color: rgba(245, 158, 11, 0.12); color: #d97706;">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- TOOLBAR DE VISTA (GRILLA SEMANAL VS TABLA + FILTRO RÁPIDO) -->
<div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.05rem;">
            Programación: @(ListaAulas.FirstOrDefault(a => a.Id == AulaSeleccionadaId)?.Nombre ?? "Laboratorio")
        </MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="font-weight-bold" Style="font-size: 0.76rem;">
            @(ListaAulas.FirstOrDefault(a => a.Id == AulaSeleccionadaId)?.Pabellon ?? "Campus Central")
        </MudChip>
    </div>
    <div class="d-flex align-center gap-3">
        <!-- Buscador rápido de materia -->
        <MudTextField T="string"
                      @bind-Value="BusquedaMateria"
                      Placeholder="Filtrar por materia..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Style="min-width: 180px; max-width: 240px;" />

        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="rounded-lg">
            <MudButton Variant="@(_vistaGrilla ? Variant.Filled : Variant.Outlined)" 
                       OnClick="() => _vistaGrilla = true" 
                       StartIcon="@Icons.Material.Filled.ViewWeek"
                       Style="text-transform: none; font-weight: 600;">
                Grilla Semanal
            </MudButton>
            <MudButton Variant="@(!_vistaGrilla ? Variant.Filled : Variant.Outlined)" 
                       OnClick="() => _vistaGrilla = false" 
                       StartIcon="@Icons.Material.Filled.FormatListBulleted"
                       Style="text-transform: none; font-weight: 600;">
                Tabla Detallada
            </MudButton>
        </MudButtonGroup>
    </div>
</div>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6 rounded" />
}
else if (_vistaGrilla)
{
    <!-- VISTA GRILLA SEMANAL (6 COLUMNAS: LUNES A SÁBADO) -->
    <MudGrid Spacing="3">
        @foreach (var dia in Enum.GetValues<DiaSemana>().Where(d => d != DiaSemana.Domingo))
        {
            var bloquesDia = ListaHorarios
                .Where(h => h.DiaSemana == dia && CumpleFiltroMateria(h))
                .OrderBy(h => h.HoraInicio)
                .ToList();
            bool esHoy = dia == ObtenerDiaActual();

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="0" 
                          Class="pa-3 rounded-lg saas-card d-flex flex-column" 
                          Style="@($"height: 100%; min-height: 380px; {(esHoy ? "border-top: 3px solid #2563eb;" : "")}")">
                    <!-- Cabecera del Día -->
                    <div class="d-flex justify-space-between align-center mb-3 pb-2" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="@(esHoy ? Color.Primary : Color.Default)" Style="font-size: 0.82rem; letter-spacing: 0.5px;">
                                @dia.ToString().ToUpper()
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.7rem;">
                                @bloquesDia.Count @(bloquesDia.Count == 1 ? "bloque" : "bloques")
                            </MudText>
                        </div>
                        @if (esHoy)
                        {
                            <span class="badge-soft-info font-weight-bold" style="font-size: 0.68rem; padding: 2px 6px;">HOY</span>
                        }
                    </div>

                    <!-- Lista de Bloques del Día -->
                    <div class="d-flex flex-column gap-2" style="flex: 1;">
                        @if (bloquesDia.Count == 0)
                        {
                            <div class="pa-4 text-center d-flex flex-column align-center justify-center my-auto rounded-lg" 
                                 style="border: 1px dashed var(--mud-palette-lines-default); background: rgba(148, 163, 184, 0.03);">
                                <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Small" Color="Color.Secondary" Class="mb-1" />
                                <span style="color: var(--mud-palette-text-secondary); font-size: 0.75rem;">
                                    Sin bloques
                                </span>
                                <MudButton Variant="Variant.Text" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => OpenCreateDialogForDay(dia)"
                                           Class="mt-1"
                                           Style="font-size: 0.72rem; text-transform: none;">
                                    Agregar
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            @foreach (var bloque in bloquesDia)
                            {
                                bool enCurso = esHoy && EsBloqueEnCurso(bloque);
                                string cardBorder = enCurso
                                    ? "border-left: 3px solid #16a34a; box-shadow: 0 0 0 1px rgba(22, 163, 74, 0.25);"
                                    : (bloque.EsRecreo ? "border-left: 3px solid #d97706;" : "border-left: 3px solid #2563eb;");

                                <div class="pa-2 rounded-md saas-card" 
                                     style="@($"border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); {cardBorder}")">
                                    <!-- Fila Superior: Horario y Acciones -->
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <span style="font-weight: 700; font-size: 0.8rem; color: var(--mud-palette-text-primary);">
                                                @bloque.HoraInicio.ToString(@"hh\:mm") - @bloque.HoraFin.ToString(@"hh\:mm")
                                            </span>
                                            <span style="font-size: 0.68rem; color: var(--mud-palette-text-secondary); margin-left: 4px;">
                                                @((int)(bloque.HoraFin - bloque.HoraInicio).TotalMinutes)m
                                            </span>
                                        </div>
                                        <div class="d-flex align-center">
                                            @if (!bloque.EsRecreo)
                                            {
                                                <MudTooltip Text="Descargar / Imprimir Planilla de Asistencia (PDF)">
                                                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" 
                                                                   Size="Size.Small" 
                                                                   Color="Color.Primary" 
                                                                   Href="@ApiClient.GetReporteAsistenciaPdfUrl(bloque.Id)" 
                                                                   Target="_blank"
                                                                   Style="padding: 2px;" />
                                                </MudTooltip>
                                            }
                                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" 
                                                           Size="Size.Small" 
                                                           OnClick="() => OpenEditDialog(bloque)" 
                                                           Style="padding: 2px;" />
                                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" 
                                                           Size="Size.Small" 
                                                           Color="Color.Error" 
                                                           OnClick="() => ConfirmarEliminarHorarioAsync(bloque)" 
                                                           Style="padding: 2px;" />
                                        </div>
                                    </div>

                                    <!-- Fila Media: Badge y Materia -->
                                    <div class="mt-1">
                                        @if (bloque.EsRecreo)
                                        {
                                            <span class="badge-soft-warning font-weight-bold" style="font-size: 0.68rem; padding: 1px 5px;">
                                                ☕ Recreo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft-info font-weight-bold" style="font-size: 0.68rem; padding: 1px 5px;">
                                                📚 @(string.IsNullOrWhiteSpace(bloque.MateriaSigla) ? "Clase" : bloque.MateriaSigla)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(bloque.GrupoParalelo))
                                            {
                                                <span class="ml-1" style="font-size: 0.68rem; color: #94a3b8;">(@bloque.GrupoParalelo)</span>
                                            }
                                        }

                                        <MudText Typo="Typo.body2" Class="font-weight-bold text-truncate mt-1" Style="font-size: 0.78rem;" title="@(bloque.MateriaNombre ?? bloque.Descripcion)">
                                            @if (!string.IsNullOrWhiteSpace(bloque.MateriaNombre))
                                            {
                                                <span>@bloque.MateriaNombre</span>
                                            }
                                            else
                                            {
                                                @(!string.IsNullOrWhiteSpace(bloque.Descripcion) ? bloque.Descripcion : "(Sin descripción)")
                                            }
                                        </MudText>

                                        @if (!string.IsNullOrWhiteSpace(bloque.DocenteNombre))
                                        {
                                            <div class="d-flex align-center gap-1 mt-1 text-truncate" style="font-size: 0.7rem; color: #38bdf8;">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="font-size: 13px;" />
                                                <span>@bloque.DocenteNombre</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Indicador En Curso -->
                                    @if (enCurso)
                                    {
                                        <div class="mt-1">
                                            <span class="badge-soft-success font-weight-bold" style="font-size: 0.64rem; padding: 1px 6px;">
                                                <span class="pulse-dot-green mr-1"></span>EN CURSO
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <!-- TABLA DETALLADA SAAS REFINADA -->
    <MudTable Items="ListaHorarios.Where(CumpleFiltroMateria)" 
              Loading="IsLoading" 
              Hover="true" 
              Bordered="false"
              Striped="false" 
              Elevation="0" 
              Class="saas-card rounded-lg overflow-hidden">
        <HeaderContent>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">DÍA</MudTh>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">HORA INICIO</MudTh>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">HORA FIN</MudTh>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">DURACIÓN</MudTh>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">TIPO DE FRANJA</MudTh>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px;">MATERIA / DESCRIPCIÓN</MudTh>
            <MudTh Style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.5px; text-align: right;">ACCIONES</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Día">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" Style="font-size: 1rem;" />
                    <span style="font-weight: 700; font-size: 0.84rem;">@context.DiaSemana.ToString()</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Hora Inicio">
                <div class="d-flex align-center gap-1" style="font-size: 0.82rem;">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.95rem;" />
                    <span>@context.HoraInicio.ToString(@"hh\:mm")</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Hora Fin">
                <div class="d-flex align-center gap-1" style="font-size: 0.82rem;">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.95rem;" />
                    <span>@context.HoraFin.ToString(@"hh\:mm")</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Duración">
                <span style="font-size: 0.8rem; font-weight: 600; color: var(--mud-palette-text-secondary);">
                    @((int)(context.HoraFin - context.HoraInicio).TotalMinutes) min
                </span>
            </MudTd>
            <MudTd DataLabel="Tipo">
                @if (context.EsRecreo)
                {
                    <span class="badge-soft-warning font-weight-bold" style="font-size: 0.72rem;">
                        ☕ Franja de Recreo
                    </span>
                }
                else
                {
                    <span class="badge-soft-info font-weight-bold" style="font-size: 0.72rem;">
                        📚 Clase Académica
                    </span>
                }
            </MudTd>
            <MudTd DataLabel="Descripción">
                <span style="font-size: 0.84rem; font-weight: 600; color: var(--mud-palette-text-primary);">
                    @(!string.IsNullOrWhiteSpace(context.Descripcion) ? context.Descripcion : "-")
                </span>
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: right;">
                @if (!context.EsRecreo)
                {
                    <MudTooltip Text="Descargar / Imprimir Planilla de Asistencia (PDF)">
                        <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Primary" Size="Size.Small" Href="@ApiClient.GetReporteAsistenciaPdfUrl(context.Id)" Target="_blank" />
                    </MudTooltip>
                }
                <MudTooltip Text="Editar Bloque">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                </MudTooltip>
                <MudTooltip Text="Eliminar Bloque">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => ConfirmarEliminarHorarioAsync(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="pa-8 d-flex flex-column align-center justify-center text-center">
                <div class="pa-3 rounded-circle mb-3" style="background: rgba(148, 163, 184, 0.1);">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Secondary" />
                </div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">
                    No hay bloques horarios registrados para esta aula
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 440px;">
                    Configura las materias o los recesos diarios para que el cierre automático funcione adecuadamente.
                </MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add" 
                           OnClick="OpenCreateDialog"
                           Class="rounded-lg font-weight-bold"
                           Style="text-transform: none;">
                    Configurar Primer Bloque
                </MudButton>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <div class="pa-3 d-flex align-center justify-space-between flex-wrap gap-2" 
                 style="border-top: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Bloques horarios del laboratorio seleccionado
                </MudText>
                <MudTablePager RowsPerPageString="Filas por página:" 
                               InfoFormat="{first_item}-{last_item} de {all_items}" 
                               PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </div>
        </PagerContent>
    </MudTable>
}

<!-- MODAL REGISTRAR / EDITAR BLOQUE HORARIO -->
<MudDialog @bind-Visible="MostrarModal" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div class="pa-2 rounded-md" style="background: rgba(37, 99, 235, 0.1);">
                <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.AccessTime)" Color="Color.Primary" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.1rem;">
                @(IsEditMode ? "Editar Bloque Horario" : "Configurar Nuevo Bloque Horario")
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(MensajeError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg">@MensajeError</MudAlert>
        }

        <EditForm Model="this" OnValidSubmit="GuardarBloqueHorarioAsync">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="NuevoAulaId" Label="Aula" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" FullWidth="true">
                        @foreach (var aula in ListaAulas)
                        {
                            <MudSelectItem T="int" Value="@aula.Id">@aula.Nombre (@(aula.BloqueNombre ?? aula.Pabellon ?? "Aula"))</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="NuevoBloquePeriodoId" Label="Semestre / Gestión" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" FullWidth="true">
                        @foreach (var p in ListaPeriodos)
                        {
                            <MudSelectItem T="int" Value="@p.Id">@p.Nombre @(p.EsActual ? " ⭐ (Actual)" : "")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="DiaSemana" @bind-Value="NuevoDiaSemana" Label="Día de la Semana" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" FullWidth="true">
                        <MudSelectItem T="DiaSemana" Value="@DiaSemana.Lunes">Lunes</MudSelectItem>
                        <MudSelectItem T="DiaSemana" Value="@DiaSemana.Martes">Martes</MudSelectItem>
                        <MudSelectItem T="DiaSemana" Value="@DiaSemana.Miercoles">Miércoles</MudSelectItem>
                        <MudSelectItem T="DiaSemana" Value="@DiaSemana.Jueves">Jueves</MudSelectItem>
                        <MudSelectItem T="DiaSemana" Value="@DiaSemana.Viernes">Viernes</MudSelectItem>
                        <MudSelectItem T="DiaSemana" Value="@DiaSemana.Sabado">Sábado</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="bool" @bind-Value="EsRecreo" Label="Tipo de Franja" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                        <MudSelectItem T="bool" Value="false">📚 Clase Académica / Práctica</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">☕ Franja de Recreo / Receso</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (!EsRecreo)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">MATERIA / ASIGNATURA</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="d-flex align-center gap-2">
                            <MudSelect T="int?" @bind-Value="NuevoMateriaId" Label="Materia (Catálogo)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Clearable="true">
                                <MudSelectItem T="int?" Value="@((int?)null)">(Sin materia del catálogo)</MudSelectItem>
                                @foreach (var mat in ListaMaterias)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)mat.Id)">@mat.Sigla - @mat.Nombre</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTooltip Text="Crear nueva materia rápidamente">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                               Color="Color.Primary" 
                                               Variant="Variant.Filled" 
                                               Size="Size.Small" 
                                               OnClick="OpenCrearMateriaRapidaModal" 
                                               Class="rounded-lg" 
                                               Style="height: 38px; min-width: 38px; box-shadow: 0 1px 4px rgba(158, 0, 68, 0.2);" />
                            </MudTooltip>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="NuevoMateriaNombreManual" 
                                      Label="O Nombre Materia (Manual sin catálogo)" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Placeholder="Ej: Taller de Robótica" 
                                      FullWidth="true"
                                      Disabled="@(NuevoMateriaId.HasValue && NuevoMateriaId.Value > 0)"
                                      HelperText="@(NuevoMateriaId.HasValue && NuevoMateriaId.Value > 0 ? "Desactivado (seleccionaste del catálogo)" : "Escribe el nombre si no deseas registrarla en catálogo")" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">DOCENTE RESPONSABLE</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="d-flex align-center gap-2">
                            <MudSelect T="int?" @bind-Value="NuevoDocenteId" Label="Docente (Catálogo)" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Clearable="true">
                                <MudSelectItem T="int?" Value="@((int?)null)">(Sin docente del catálogo)</MudSelectItem>
                                @foreach (var doc in ListaDocentes)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)doc.Id)">@doc.NombreCompleto</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTooltip Text="Crear nuevo docente rápidamente">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                               Color="Color.Primary" 
                                               Variant="Variant.Filled" 
                                               Size="Size.Small" 
                                               OnClick="OpenCrearDocenteRapidoModal" 
                                               Class="rounded-lg" 
                                               Style="height: 38px; min-width: 38px; box-shadow: 0 1px 4px rgba(158, 0, 68, 0.2);" />
                            </MudTooltip>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="NuevoDocenteNombreManual" 
                                      Label="O Nombre Docente (Manual sin catálogo)" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Placeholder="Ej: Lic. Mario Vargas" 
                                      FullWidth="true"
                                      Disabled="@(NuevoDocenteId.HasValue && NuevoDocenteId.Value > 0)"
                                      HelperText="@(NuevoDocenteId.HasValue && NuevoDocenteId.Value > 0 ? "Desactivado (seleccionaste del catálogo)" : "Nombre directo si no está en catálogo")" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="NuevoDocenteEmailManual" 
                                      Label="Email Docente (Manual, opcional @@univalle.edu)" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      Placeholder="mario.vargas@univalle.edu" 
                                      FullWidth="true"
                                      Disabled="@(NuevoDocenteId.HasValue && NuevoDocenteId.Value > 0)" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="NuevoGrupoParalelo" Label="Grupo / Paralelo" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ej: Grupo 1 / Paralelo A" FullWidth="true" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NuevaDescripcion" Label="Notas / Observaciones" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ej: Taller práctico / Examen parcial" FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Hora Inicio" @bind-Time="HoraInicioTs" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Hora Fin" @bind-Time="HoraFinTs" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CloseDialog" Class="rounded-lg" Style="text-transform: none;">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsSaving" StartIcon="@Icons.Material.Filled.Save" OnClick="GuardarBloqueHorarioAsync" Class="rounded-lg font-weight-bold" Style="text-transform: none;">
            @(IsSaving ? "Guardando..." : (IsEditMode ? "Actualizar Bloque" : "Guardar Bloque"))
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- MODAL PARA REPLICAR HORARIOS A OTROS DÍAS -->
<MudDialog @bind-Visible="MostrarModalClonar" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div class="pa-2 rounded-md" style="background: rgba(37, 99, 235, 0.1);">
                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.1rem;">
                Replicar Horarios a Otros Días
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Copia todos los bloques de clase y recesos del día seleccionado hacia los días destino elegidos para ahorrar tiempo.
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudSelect T="DiaSemana" @bind-Value="DiaOrigenClonacion" Label="Día Origen (Modelo a Copiar)" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var dia in Enum.GetValues<DiaSemana>().Where(d => d != DiaSemana.Domingo))
                    {
                        <MudSelectItem T="DiaSemana" Value="@dia">@dia.ToString() (@ListaHorarios.Count(h => h.DiaSemana == dia) bloques)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold" Style="font-size: 0.85rem;">
                    Seleccionar Días Destino:
                </MudText>
                <div class="d-flex flex-wrap gap-4 pa-3 rounded-lg" style="background: rgba(148, 163, 184, 0.05); border: 1px solid var(--mud-palette-lines-default);">
                    <MudCheckBox T="bool" @bind-Value="ClonarMartes" Label="Martes" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="ClonarMiercoles" Label="Miércoles" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="ClonarJueves" Label="Jueves" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="ClonarViernes" Label="Viernes" Color="Color.Primary" />
                    <MudCheckBox T="bool" @bind-Value="ClonarSabado" Label="Sábado" Color="Color.Primary" />
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalClonar = false" Class="rounded-lg" Style="text-transform: none;">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@IsSaving" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="EjecutarClonacionHorariosAsync" Class="rounded-lg font-weight-bold" Style="text-transform: none;">
            @(IsSaving ? "Replicando..." : "Ejecutar Replicación")
        </MudButton>
    </DialogActions>
</MudDialog>

