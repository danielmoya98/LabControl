    private async Task GuardarNuevoPeriodoAsync()
    {
        if (string.IsNullOrWhiteSpace(NuevoPeriodoNombre))
        {
            ErrorGestionPeriodos = "El nombre del semestre (ej: I-2027) es obligatorio.";
            return;
        }

        if (!NuevoPeriodoFechaInicio.HasValue || !NuevoPeriodoFechaFin.HasValue || NuevoPeriodoFechaFin <= NuevoPeriodoFechaInicio)
        {
            ErrorGestionPeriodos = "La fecha fin debe ser posterior a la fecha inicio.";
            return;
        }

        GuardandoPeriodo = true;
        ErrorGestionPeriodos = null;

        var periodoOrigenActual = ListaPeriodos.FirstOrDefault(p => p.EsActual);

        var (exito, errorMsg) = await ApiClient.CreatePeriodoAcademicoAsync(
            NuevoPeriodoNombre.Trim().ToUpperInvariant(),
            NuevoPeriodoFechaInicio.Value,
            NuevoPeriodoFechaFin.Value,
            NuevoPeriodoEsActual
        );

        if (exito)
        {
            ListaPeriodos = await ApiClient.GetPeriodosAcademicosAsync();
            var nuevo = ListaPeriodos.FirstOrDefault(p => p.Nombre.Equals(NuevoPeriodoNombre.Trim(), StringComparison.OrdinalIgnoreCase));

            if (nuevo != null)
            {
                if (NuevoPeriodoClonarHorarios && periodoOrigenActual != null)
                {
                    var (clonOk, clonados) = await ApiClient.ClonarHorariosSemestreAsync(periodoOrigenActual.Id, nuevo.Id);
                    if (clonOk)
                    {
                        Snackbar.Add($"Se clonaron {clonados} bloques del semestre {periodoOrigenActual.Nombre}.", Severity.Info);
                    }
                }

                // Cambiar la vista de la grilla directamente al nuevo semestre creado
                PeriodoSeleccionadoId = nuevo.Id;
            }

            Snackbar.Add($"Semestre '{NuevoPeriodoNombre}' creado exitosamente.", Severity.Success);
            MostrarModalGestionPeriodos = false;
            await CargarHorariosAsync();
        }
        else
        {
            ErrorGestionPeriodos = errorMsg ?? "No se pudo crear el semestre. Verifique que el nombre sea único.";
        }

        GuardandoPeriodo = false;
    }

    private bool CumpleFiltroMateria(BloqueHorarioDto bloque)
    {
        if (string.IsNullOrWhiteSpace(BusquedaMateria)) return true;
        var q = BusquedaMateria.Trim().ToLowerInvariant();
        return (!string.IsNullOrWhiteSpace(bloque.Descripcion) && bloque.Descripcion.ToLowerInvariant().Contains(q)) ||
               (bloque.EsRecreo && "recreo".Contains(q)) ||
               (!bloque.EsRecreo && "clase".Contains(q));
    }

    private double CalcularHorasSemanales()
    {
        return ListaHorarios
            .Where(h => !h.EsRecreo)
            .Sum(h => (h.HoraFin - h.HoraInicio).TotalHours);
    }

    private DiaSemana ObtenerDiaActual()
    {
        return TimeZoneHelper.NowBolivia.DayOfWeek switch
        {
            DayOfWeek.Monday => DiaSemana.Lunes,
            DayOfWeek.Tuesday => DiaSemana.Martes,
            DayOfWeek.Wednesday => DiaSemana.Miercoles,
            DayOfWeek.Thursday => DiaSemana.Jueves,
            DayOfWeek.Friday => DiaSemana.Viernes,
            DayOfWeek.Saturday => DiaSemana.Sabado,
            _ => DiaSemana.Domingo
        };
    }

    private bool EsBloqueEnCurso(BloqueHorarioDto bloque)
    {
        var horaActual = TimeZoneHelper.NowBolivia.TimeOfDay;
        return bloque.HoraInicio <= horaActual && bloque.HoraFin > horaActual;
    }

    private BloqueHorarioDto? ObtenerBloqueEnCurso()
    {
        var diaHoy = ObtenerDiaActual();
        var horaActual = TimeZoneHelper.NowBolivia.TimeOfDay;
        return ListaHorarios.FirstOrDefault(h => h.DiaSemana == diaHoy && h.HoraInicio <= horaActual && h.HoraFin > horaActual);
    }

