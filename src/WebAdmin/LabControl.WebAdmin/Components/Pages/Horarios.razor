    private async Task GuardarDocenteRapidoAsync()
    {
        if (string.IsNullOrWhiteSpace(RapidoDocenteNombres) || string.IsNullOrWhiteSpace(RapidoDocenteApellidos) || string.IsNullOrWhiteSpace(RapidoDocenteEmail))
        {
            ErrorDocenteRapido = "Nombres, Apellidos y Email son obligatorios.";
            return;
        }

        if (!RapidoDocenteEmail.Contains("@"))
        {
            ErrorDocenteRapido = "El correo institucional no es válido.";
            return;
        }

        GuardandoDocenteRapido = true;
        ErrorDocenteRapido = null;

        var emailTrim = RapidoDocenteEmail.Trim().ToLowerInvariant();
        bool exito = await ApiClient.CreateDocenteAsync(RapidoDocenteNombres.Trim(), RapidoDocenteApellidos.Trim(), emailTrim, string.IsNullOrWhiteSpace(RapidoDocenteTelefono) ? null : RapidoDocenteTelefono.Trim());
        if (exito)
        {
            ListaDocentes = await ApiClient.GetDocentesAsync();
            var creado = ListaDocentes.FirstOrDefault(d => string.Equals(d.EmailInstitucional, emailTrim, StringComparison.OrdinalIgnoreCase));
            if (creado != null)
            {
                NuevoDocenteId = creado.Id;
            }
            Snackbar.Add($"Docente '{RapidoDocenteNombres} {RapidoDocenteApellidos}' creado y asignado.", Severity.Success);
            MostrarModalDocenteRapido = false;
        }
        else
        {
            ErrorDocenteRapido = "No se pudo registrar el docente. Verifique que el correo no esté en uso.";
        }

        GuardandoDocenteRapido = false;
    }
