<!-- MODAL PARA GESTIÓN DE SEMESTRES / PERIODOS ACADÉMICOS -->
<MudDialog @bind-Visible="MostrarModalGestionPeriodos" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div class="pa-2 rounded-md" style="background: rgba(37, 99, 235, 0.1);">
                <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" Size="Size.Small" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-size: 1.1rem;">
                    Gestión de Semestres y Periodos Académicos
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Administra semestres vigentes, activa nuevos periodos o consulta horarios históricos
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(ErrorGestionPeriodos))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Variant="Variant.Filled">@ErrorGestionPeriodos</MudAlert>
        }

        <!-- TABLA DE SEMESTRES EXISTENTES -->
        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Semestres Registrados</MudText>
        <MudTable Items="ListaPeriodos" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="mb-4 rounded-lg">
            <HeaderContent>
                <MudTh>Semestre</MudTh>
                <MudTh>Rango de Fechas</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Semestre">
                    <span class="font-weight-bold">@context.Nombre</span>
                </MudTd>
                <MudTd DataLabel="Fechas">
                    @context.FechaInicio.ToString("dd/MM/yyyy") - @context.FechaFin.ToString("dd/MM/yyyy")
                </MudTd>
                <MudTd DataLabel="Estado">
                    @if (context.EsActual)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Star">
                            Semestre Actual
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                            Histórico
                        </MudChip>
                    }
                </MudTd>
                <MudTd Style="text-align: right;">
                    @if (!context.EsActual)
                    {
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Primary" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   OnClick="() => ActivarPeriodoAsync(context.Id)"
                                   Class="rounded-lg"
                                   Style="text-transform: none;">
                            Activar como Actual
                        </MudButton>
                    }
                    else
                    {
                        <span style="font-size: 0.8rem; color: #16a34a; font-weight: bold;">En vigor</span>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudDivider Class="my-3" />

        <!-- FORMULARIO PARA CREAR NUEVO SEMESTRE -->
        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Aperturar Nuevo Semestre</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="NuevoPeriodoNombre" Label="Nombre Gestión / Semestre" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ej: I-2027" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="NuevoPeriodoFechaInicio" Label="Fecha Inicio" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="NuevoPeriodoFechaFin" Label="Fecha Fin" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudCheckBox T="bool" @bind-Value="NuevoPeriodoEsActual" Label="Establecer inmediatamente como semestre activo" Color="Color.Primary" Dense="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudCheckBox T="bool" @bind-Value="NuevoPeriodoClonarHorarios" Label="Replicar horarios del semestre actual a este nuevo semestre" Color="Color.Secondary" Dense="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MostrarModalGestionPeriodos = false" Class="rounded-lg" Style="text-transform: none;">
            Cerrar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@GuardandoPeriodo" StartIcon="@Icons.Material.Filled.Add" OnClick="GuardarNuevoPeriodoAsync" Class="rounded-lg font-weight-bold" Style="text-transform: none;">
            @(GuardandoPeriodo ? "Guardando..." : "Crear Semestre")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AulaDto> ListaAulas = [];
    private List<BloqueHorarioDto> ListaHorarios = [];
    private List<MateriaDto> ListaMaterias = [];
    private List<DocenteDto> ListaDocentes = [];
    private List<PeriodoAcademicoModel> ListaPeriodos = [];
    private int AulaSeleccionadaId = 0;
    private int PeriodoSeleccionadoId = 0;
    private bool IsLoading = true;
    private bool MostrarModal = false;
    private bool MostrarModalClonar = false;
    private bool MostrarModalGestionPeriodos = false;
    private bool IsSaving = false;
    private bool IsEditMode = false;
    private bool _vistaGrilla = true;
    private int BloqueIdSeleccionado = 0;
    private string? MensajeError;
    private string BusquedaMateria = "";

    // Formulario de Semestre / Periodo
    private string NuevoPeriodoNombre = "";
    private DateTime? NuevoPeriodoFechaInicio = DateTime.Today;
    private DateTime? NuevoPeriodoFechaFin = DateTime.Today.AddMonths(5);
    private bool NuevoPeriodoEsActual = false;
    private bool NuevoPeriodoClonarHorarios = true;
    private bool GuardandoPeriodo = false;
    private string? ErrorGestionPeriodos = null;

    // Formulario de Bloque
    private int NuevoAulaId = 0;
    private int NuevoBloquePeriodoId = 0;
    private DiaSemana NuevoDiaSemana = DiaSemana.Lunes;
    private TimeSpan? HoraInicioTs = new TimeSpan(7, 30, 0);
    private TimeSpan? HoraFinTs = new TimeSpan(9, 0, 0);
    private bool EsRecreo = false;
    private string? NuevaDescripcion;
    private int? NuevoMateriaId;
    private int? NuevoDocenteId;
    private string? NuevoGrupoParalelo;
    private string? NuevoMateriaNombreManual;
    private string? NuevoDocenteNombreManual;
    private string? NuevoDocenteEmailManual;

    // Modales rápidos
    private bool MostrarModalMateriaRapida = false;
    private string RapidaMateriaSigla = "";
    private string RapidaMateriaNombre = "";
    private string? RapidaMateriaCarrera = "";
    private string? ErrorMateriaRapida = null;
    private bool GuardandoMateriaRapida = false;

    private bool MostrarModalDocenteRapido = false;
    private string RapidoDocenteNombres = "";
    private string RapidoDocenteApellidos = "";
    private string RapidoDocenteEmail = "";
    private string? RapidoDocenteTelefono = "";
    private string? ErrorDocenteRapido = null;
    private bool GuardandoDocenteRapido = false;

    // Clonación
    private DiaSemana DiaOrigenClonacion = DiaSemana.Lunes;
    private bool ClonarMartes = true;
    private bool ClonarMiercoles = true;
    private bool ClonarJueves = true;
    private bool ClonarViernes = true;
    private bool ClonarSabado = false;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        Position = DialogPosition.Center
    };

    private readonly DialogOptions _subDialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        Position = DialogPosition.Center
    };

    protected override async Task OnInitializedAsync()
    {
        ListaAulas = await ApiClient.GetAulasAsync();
        ListaMaterias = await ApiClient.GetMateriasAsync();
        ListaDocentes = await ApiClient.GetDocentesAsync();
        ListaPeriodos = await ApiClient.GetPeriodosAcademicosAsync();

        var actual = ListaPeriodos.FirstOrDefault(p => p.EsActual) ?? ListaPeriodos.FirstOrDefault();
        if (actual != null)
        {
            PeriodoSeleccionadoId = actual.Id;
        }

        if (ListaAulas.Any())
        {
            AulaSeleccionadaId = ListaAulas.First().Id;
            NuevoAulaId = AulaSeleccionadaId;
            await CargarHorariosAsync();
        }
        else
        {
            IsLoading = false;
        }
    }

    private async Task CargarHorariosAsync()
    {
        if (AulaSeleccionadaId <= 0) return;
        IsLoading = true;
        try
        {
            ListaHorarios = await ApiClient.GetHorariosByAulaAsync(AulaSeleccionadaId, PeriodoSeleccionadoId > 0 ? PeriodoSeleccionadoId : null);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar horarios: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

