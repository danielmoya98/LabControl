@page "/computadoras"
@using Microsoft.AspNetCore.Components.Web
@using LabControl.Application.Features.Aulas.Commands.CreateAula
@using LabControl.Application.Features.Computadoras.Queries.GetEstadoAulasMapa
@using LabControl.Domain.Enums
@using LabControl.WebAdmin.Services
@inject LabApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Gestión de Terminales — Control de Laboratorios</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold">💻 Gestión de Computadoras y Terminales</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Registra y asigna las terminales físicas a cada laboratorio</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        Registrar Nueva PC
    </MudButton>
</div>

<!-- Modal Centrado para Registrar / Editar Computadora -->
<MudDialog @bind-Visible="MostrarModal" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Primary">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Computer)" Class="mr-2" />
            @(IsEditMode ? $"Editar Terminal: {NuevoHostname}" : "Registrar Nueva Terminal")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(MensajeError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@MensajeError</MudAlert>
        }

        <EditForm Model="this" OnValidSubmit="GuardarComputadoraAsync">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="int" @bind-Value="NuevoAulaId" Label="Aula de Destino" Variant="Variant.Outlined" Required="true" FullWidth="true">
                        <MudSelectItem T="int" Value="0">-- Seleccionar Aula --</MudSelectItem>
                        @foreach (var aula in ListaAulas)
                        {
                            <MudSelectItem T="int" Value="@aula.Id">@aula.Nombre (@aula.Pabellon)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="NuevoHostname" Label="Hostname (Nombre de Equipo)" Variant="Variant.Outlined" Required="true" Placeholder="Ej: LAB01-PC01" FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NuevaIp" Label="Dirección IP Local" Variant="Variant.Outlined" Required="true" Placeholder="Ej: 192.168.1.11" FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="NuevaMac" Label="Dirección MAC Física" Variant="Variant.Outlined" Required="true" Placeholder="Ej: 00:1A:2B:3C:01:01" FullWidth="true" />
                </MudItem>

                @if (IsEditMode)
                {
                    <MudItem xs="12">
                        <MudSelect T="EstadoComputadora" @bind-Value="NuevoEstado" Label="Estado de la Terminal" Variant="Variant.Outlined" FullWidth="true">
                            <MudSelectItem T="EstadoComputadora" Value="@EstadoComputadora.Disponible">Disponible</MudSelectItem>
                            <MudSelectItem T="EstadoComputadora" Value="@EstadoComputadora.EnUso">En Uso</MudSelectItem>
                            <MudSelectItem T="EstadoComputadora" Value="@EstadoComputadora.Offline">Offline</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CloseDialog">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@IsSaving" StartIcon="@Icons.Material.Filled.Save" OnClick="GuardarComputadoraAsync">
            @(IsSaving ? "Guardando..." : (IsEditMode ? "Actualizar Terminal" : "Guardar Terminal"))
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Selector de Filtro de Aula y Tabla de PCs -->
<MudTable Items="PCsFiltradas" Loading="IsLoading" Hover="true" Striped="true" Elevation="3" Class="rounded-lg">
    <ToolBarContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">Terminales Registradas</MudText>
        <MudSpacer />
        <MudSelect T="int" Value="AulaFiltroId" ValueChanged="OnAulaFiltroChanged" Label="Filtrar por Aula" Variant="Variant.Outlined" Style="width: 240px;">
            <MudSelectItem T="int" Value="0">Todas las Aulas</MudSelectItem>
            @foreach (var aula in ListaAulas)
            {
                <MudSelectItem T="int" Value="@aula.Id">@aula.Nombre</MudSelectItem>
            }
        </MudSelect>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>AULA</MudTh>
        <MudTh>HOSTNAME</MudTh>
        <MudTh>DIRECCIÓN IP</MudTh>
        <MudTh>DIRECCIÓN MAC</MudTh>
        <MudTh>ESTADO ACTUAL</MudTh>
        <MudTh Style="text-align: right;">ACCIONES</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Aula">
            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Secondary">@context.NombreAula</MudText>
        </MudTd>
        <MudTd DataLabel="Hostname">
            <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Primary">@context.Hostname</MudText>
        </MudTd>
        <MudTd DataLabel="IP">@context.IpActual</MudTd>
        <MudTd DataLabel="MAC">@context.MacAddress</MudTd>
        <MudTd DataLabel="Estado">
            <MudChip T="string" Color="@GetChipColor(context.EstadoActual)" Size="Size.Small">
                @context.EstadoActual.ToString()
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Acciones" Style="text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" aria-label="Editar Computadora" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => ConfirmarEliminarComputadoraAsync(context))" aria-label="Eliminar Computadora" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4 text-center" Color="Color.Secondary">
            ⚠️ No hay computadoras registradas. Usa el botón superior para agregar la primera.
        </MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<AulaDto> ListaAulas = [];
    private List<AulaEstadoDto> MapaAulas = [];
    private int AulaFiltroId = 0;
    private bool IsLoading = true;
    private bool MostrarModal = false;
    private bool IsSaving = false;
    private bool IsEditMode = false;
    private int ComputadoraIdSeleccionada = 0;
    private string? MensajeError;

    private int NuevoAulaId = 0;
    private string NuevoHostname = "";
    private string NuevaIp = "192.168.1.10";
    private string NuevaMac = "00:1A:2B:3C:01:01";
    private EstadoComputadora NuevoEstado = EstadoComputadora.Disponible;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        Position = DialogPosition.Center
    };

    public record PcRowItem(int ComputadoraId, int AulaId, string NombreAula, string Hostname, string IpActual, string MacAddress, EstadoComputadora EstadoActual);

    private IEnumerable<PcRowItem> PCsFiltradas
    {
        get
        {
            var result = new List<PcRowItem>();
            var aulas = AulaFiltroId == 0 ? MapaAulas : MapaAulas.Where(a => a.AulaId == AulaFiltroId);
            foreach (var aula in aulas)
            {
                foreach (var pc in aula.Computadoras)
                {
                    result.Add(new PcRowItem(pc.ComputadoraId, aula.AulaId, aula.Nombre, pc.Hostname, pc.IpActual, pc.MacAddress, pc.EstadoActual));
                }
            }
            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        IsLoading = true;
        ListaAulas = await ApiClient.GetAulasAsync();
        MapaAulas = await ApiClient.GetMapaAulasAsync();
        IsLoading = false;
    }

    private void OnAulaFiltroChanged(int id)
    {
        AulaFiltroId = id;
    }

    private void OpenCreateDialog()
    {
        IsEditMode = false;
        ComputadoraIdSeleccionada = 0;
        NuevoAulaId = ListaAulas.FirstOrDefault()?.Id ?? 0;
        NuevoHostname = "";
        NuevaIp = "192.168.1.10";
        NuevaMac = "00:1A:2B:3C:01:01";
        NuevoEstado = EstadoComputadora.Disponible;
        MensajeError = null;
        MostrarModal = true;
    }

    private void OpenEditDialog(PcRowItem pc)
    {
        IsEditMode = true;
        ComputadoraIdSeleccionada = pc.ComputadoraId;
        NuevoAulaId = pc.AulaId;
        NuevoHostname = pc.Hostname;
        NuevaIp = pc.IpActual;
        NuevaMac = pc.MacAddress;
        NuevoEstado = pc.EstadoActual;
        MensajeError = null;
        MostrarModal = true;
    }

    private void CloseDialog()
    {
        MostrarModal = false;
    }

    private async Task GuardarComputadoraAsync()
    {
        if (NuevoAulaId <= 0 || string.IsNullOrWhiteSpace(NuevoHostname) || string.IsNullOrWhiteSpace(NuevaIp) || string.IsNullOrWhiteSpace(NuevaMac))
        {
            MensajeError = "Por favor complete todos los campos obligatorios.";
            return;
        }

        IsSaving = true;
        MensajeError = null;

        bool exito;
        if (IsEditMode)
        {
            exito = await ApiClient.UpdateComputadoraAsync(
                ComputadoraIdSeleccionada, NuevoAulaId, NuevoHostname, NuevaIp, NuevaMac, NuevoEstado);
        }
        else
        {
            exito = await ApiClient.CreateComputadoraAsync(NuevoAulaId, NuevoHostname, NuevaIp, NuevaMac);
        }

        if (exito)
        {
            Snackbar.Add(IsEditMode ? $"¡Terminal '{NuevoHostname}' actualizada exitosamente!" : $"¡Terminal '{NuevoHostname}' registrada exitosamente!", Severity.Success);
            MostrarModal = false;
            await CargarDatosAsync();
        }
        else
        {
            MensajeError = IsEditMode
                ? "No se pudo actualizar la terminal. Verifica los datos ingresados."
                : "No se pudo registrar la terminal. Verifica el formato de la IP/MAC o que el Hostname sea único.";
        }

        IsSaving = false;
    }

    private async Task ConfirmarEliminarComputadoraAsync(PcRowItem pc)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación",
            $"¿Está seguro que desea eliminar la terminal '{pc.Hostname}' ({pc.IpActual})?\nEsta acción cerrará cualquier sesión activa.",
            yesText: "Sí, Eliminar", cancelText: "Cancelar");

        if (confirm == true)
        {
            bool exito = await ApiClient.DeleteComputadoraAsync(pc.ComputadoraId);
            if (exito)
            {
                Snackbar.Add($"Terminal '{pc.Hostname}' eliminada exitosamente.", Severity.Info);
                await CargarDatosAsync();
            }
            else
            {
                Snackbar.Add("No se pudo eliminar la terminal. Verifique la conexión con el servidor.", Severity.Error);
            }
        }
    }

    private Color GetChipColor(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.EnUso => Color.Success,
        EstadoComputadora.Disponible => Color.Default,
        EstadoComputadora.Offline => Color.Error,
        _ => Color.Default
    };
}
