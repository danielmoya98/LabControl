@using LabControl.Application.Features.Computadoras.Queries.GetEstadoAulasMapa
@using LabControl.Domain.Enums

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Memory" Color="Color.Primary" Class="mr-2" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Ficha Técnica &amp; Salud: @Pc.Hostname</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Inventario de Hardware y Diagnóstico de Terminal</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <!-- Procesador -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-3 rounded-xl d-flex align-center saas-card">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Class="mr-3">
                        <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" />
                    </MudAvatar>
                    <div style="overflow: hidden;" title="@(Pc.CpuModelo ?? "No reportado")">
                        <span class="kpi-title">PROCESADOR (CPU)</span>
                        <MudText Typo="Typo.body2" Class="font-weight-bold text-truncate mt-1">
                            @(string.IsNullOrWhiteSpace(Pc.CpuModelo) ? "Pendiente de reporte" : Pc.CpuModelo)
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Memoria RAM -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-3 rounded-xl d-flex align-center saas-card">
                    <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled" Class="mr-3">
                        <MudIcon Icon="@Icons.Material.Filled.Memory" />
                    </MudAvatar>
                    <div>
                        <span class="kpi-title">MEMORIA RAM INSTALADA</span>
                        <MudText Typo="Typo.body2" Class="font-weight-bold mt-1">
                            @(Pc.RamTotalGb.HasValue && Pc.RamTotalGb > 0 ? $"{Pc.RamTotalGb.Value} GB RAM Física" : "Pendiente")
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Unidades de Almacenamiento (Todos los Discos) -->
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-3 rounded-xl saas-card">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Info" Class="mr-2" />
                            <MudText Typo="Typo.body2" Class="font-weight-bold">Unidades de Almacenamiento Detectadas</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @ObtenerDiscos().Count unidad(es) de disco
                        </MudText>
                    </div>

                    @if (ObtenerDiscos() is var listaDiscos && listaDiscos.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var disco in listaDiscos)
                            {
                                var ocupadoGb = Math.Max(0, disco.TotalGb - disco.LibreGb);
                                var usoPorc = disco.TotalGb > 0 ? (int)Math.Clamp(Math.Round(((double)ocupadoGb / disco.TotalGb) * 100), 0, 100) : 0;
                                var barColor = usoPorc > 90 ? Color.Error : (usoPorc > 75 ? Color.Warning : Color.Success);

                                <div class="pa-2 rounded-lg" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <div class="d-flex align-center gap-2">
                                            <span class="badge-soft-primary px-2 py-0 font-weight-bold" style="font-size: 0.75rem;">
                                                💾 @disco.Nombre
                                            </span>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                @(string.IsNullOrWhiteSpace(disco.Etiqueta) ? disco.Tipo : disco.Etiqueta)
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            <span>@ocupadoGb GB ocupados de @(disco.TotalGb) GB (@(disco.LibreGb) GB libres)</span>
                                        </MudText>
                                    </div>
                                    <MudProgressLinear Color="@barColor" Value="@usoPorc" Class="my-1" Size="Size.Medium" Rounded="true">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: white; font-size: 0.7rem;">@($"{usoPorc}%")</MudText>
                                    </MudProgressLinear>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-center d-block">Sin datos de almacenamiento reportados</MudText>
                    }
                </MudPaper>
            </MudItem>

            <!-- Sistema Operativo & Uptime -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-3 rounded-xl d-flex align-center saas-card">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Class="mr-3">
                        <MudIcon Icon="@Icons.Material.Filled.LaptopWindows" />
                    </MudAvatar>
                    <div style="overflow: hidden;" title="@(Pc.SistemaOperativo ?? "Windows")">
                        <span class="kpi-title">SISTEMA OPERATIVO</span>
                        <MudText Typo="Typo.body2" Class="font-weight-bold text-truncate mt-1">
                            @(string.IsNullOrWhiteSpace(Pc.SistemaOperativo) ? "Microsoft Windows" : Pc.SistemaOperativo)
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-3 rounded-xl d-flex align-center saas-card">
                    <MudAvatar Color="@(Pc.UptimeHoras.GetValueOrDefault(0) > 12 ? Color.Warning : Color.Success)" Variant="Variant.Filled" Class="mr-3">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" />
                    </MudAvatar>
                    <div>
                        <span class="kpi-title">TIEMPO ENCENDIDO (UPTIME)</span>
                        <MudText Typo="Typo.body2" Class="font-weight-bold">
                            @if (Pc.UptimeHoras.HasValue)
                            {
                                <span>@(Pc.UptimeHoras.Value) horas continuas</span>
                            }
                            else
                            {
                                <span>No disponible</span>
                            }
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Red & Estado -->
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-3 rounded-xl saas-card">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <span class="kpi-title">DIRECCIÓN IP</span>
                            <MudText Typo="Typo.body2" Class="font-weight-bold mt-1">@Pc.IpActual</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <span class="kpi-title">DIRECCIÓN MAC</span>
                            <MudText Typo="Typo.body2" Class="font-weight-bold mt-1">@Pc.MacAddress</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <span class="kpi-title">ESTADO EN TIEMPO REAL</span>
                            <div class="mt-1">
                                <MudChip T="string" Color="@GetChipColor(Pc.EstadoActual)" Size="Size.Small" Class="font-weight-bold">
                                    @Pc.EstadoActual.ToString()
                                </MudChip>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.History" OnClick="VerHistorial">
            Ver Historial de Sesiones
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ComputadoraTarjetaDto Pc { get; set; } = default!;

    public class DiscoInfoDto
    {
        public string Nombre { get; set; } = "";
        public string Etiqueta { get; set; } = "";
        public string Tipo { get; set; } = "";
        public int TotalGb { get; set; }
        public int LibreGb { get; set; }
    }

    private List<DiscoInfoDto> ObtenerDiscos()
    {
        if (!string.IsNullOrWhiteSpace(Pc.DiscosDetalleJson))
        {
            try
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var discos = System.Text.Json.JsonSerializer.Deserialize<List<DiscoInfoDto>>(Pc.DiscosDetalleJson, options);
                if (discos != null && discos.Count > 0)
                {
                    return discos;
                }
            }
            catch { }
        }

        // Fallback al disco principal C:
        if (Pc.DiscoTotalGb.HasValue && Pc.DiscoTotalGb.Value > 0)
        {
            return new List<DiscoInfoDto>
            {
                new DiscoInfoDto
                {
                    Nombre = "C:",
                    Etiqueta = "Sistema",
                    Tipo = "Fixed",
                    TotalGb = Pc.DiscoTotalGb.Value,
                    LibreGb = Pc.DiscoLibreGb.GetValueOrDefault(0)
                }
            };
        }

        return new List<DiscoInfoDto>();
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void VerHistorial()
    {
        MudDialog.Close();
        NavigationManager.NavigateTo($"/auditoria?hostname={Uri.EscapeDataString(Pc.Hostname)}");
    }

    private Color GetChipColor(EstadoComputadora estado) => estado switch
    {
        EstadoComputadora.Disponible => Color.Success,
        EstadoComputadora.EnUso => Color.Info,
        EstadoComputadora.Offline => Color.Error,
        _ => Color.Dark
    };
}
