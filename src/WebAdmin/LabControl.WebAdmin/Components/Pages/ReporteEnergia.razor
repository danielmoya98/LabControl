    private async Task ApagarPcDesdeReporteAsync(RegistroEnergiaDetalleModel item)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Apagado Remoto por Infracción",
            $"¿Deseas enviar la orden de apagado inmediato a la terminal '{item.Hostname}'?",
            yesText: "Sí, Apagar", cancelText: "Cancelar"
        );

        if (confirm == true)
        {
            bool ok = await ApiClient.EnviarComandoEnergiaAsync(item.ComputadoraId, "SHUTDOWN", "Apagado por infracción energética");
            if (ok)
            {
                Snackbar.Add($"Orden de apagado enviada con éxito a {item.Hostname}.", Severity.Success);
                await CargarReporteAsync();
            }
            else
            {
                Snackbar.Add($"No se pudo apagar {item.Hostname}.", Severity.Error);
            }
        }
    }

    private readonly HashSet<string> _copiedKeys = [];

    private async Task CopiarConFeedbackAsync(string? texto, string key, string label = "")
    {
        if (string.IsNullOrEmpty(texto)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("clipboardHelper.copyText", texto);
            _copiedKeys.Add(key);
            StateHasChanged();
            Snackbar.Add($"📋 {(string.IsNullOrEmpty(label) ? "Copiado" : label)}: {texto}", Severity.Success);
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _copiedKeys.Remove(key);
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            Snackbar.Add("No se pudo copiar al portapapeles", Severity.Warning);
        }
    }

    private bool EstaCopiado(string key) => _copiedKeys.Contains(key);

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
