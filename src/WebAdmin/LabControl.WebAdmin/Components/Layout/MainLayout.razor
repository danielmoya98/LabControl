    ];

    private IEnumerable<CommandNavItem> FilteredNavItems =>
        string.IsNullOrWhiteSpace(_commandQuery)
            ? _navItems
            : _navItems.Where(n => n.Title.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase) ||
                                   n.Description.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase) ||
                                   n.Route.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<AulaDto> FilteredAulas =>
        string.IsNullOrWhiteSpace(_commandQuery)
            ? _aulasCache.Take(4)
            : _aulasCache.Where(a => a.Nombre.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase) ||
                                    (a.Pabellon?.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase) ?? false)).Take(5);

    private IEnumerable<CommandActionItem> FilteredActionItems
    {
        get
        {
            var actions = new List<CommandActionItem>
            {
                new("Alternar Tema Claro / Oscuro", "Cambiar entre modo día y noche en la interfaz", _isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode, "Tema", async () => { await ToggleThemeAsync(); CloseCommandPalette(); }),
                new("Pantalla Completa (F11)", "Activar o desactivar modo pantalla completa del navegador", Icons.Material.Outlined.Fullscreen, "NOC", async () => { await JSRuntime.InvokeVoidAsync("fullscreenHelper.toggleFullscreen"); CloseCommandPalette(); }),
                new("Mi Perfil de Usuario", "Editar nombre, credenciales y avatar administrativo", Icons.Material.Outlined.Person, "Ajustes", () => { _showProfileDialog = true; CloseCommandPalette(); return Task.CompletedTask; }),
                new("Centro de Ayuda y Soporte", "Guía rápida de operaciones y contactos TI Univalle", Icons.Material.Outlined.HelpOutline, "Ayuda", () => { _showHelpDialog = true; CloseCommandPalette(); return Task.CompletedTask; }),
                new("Cerrar Sesión Segura", "Finalizar la sesión del administrador", Icons.Material.Outlined.Logout, "Salir", () => { CloseCommandPalette(); HandleLogout(); return Task.CompletedTask; })
            };

            return string.IsNullOrWhiteSpace(_commandQuery)
                ? actions
                : actions.Where(a => a.Title.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase) ||
                                     a.Description.Contains(_commandQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OpenCommandPalette()
    {
        _commandQuery = "";
        _showCommandPalette = true;
        _ = LoadAulasCacheAsync();
        StateHasChanged();
    }

    private void CloseCommandPalette()
    {
        _showCommandPalette = false;
        _commandQuery = "";
        StateHasChanged();
    }

    private void NavigateFromPalette(string route)
    {
        CloseCommandPalette();
        Navigation.NavigateTo(route);
    }

    private void NavigateToAula(int aulaId)
    {
        CloseCommandPalette();
        Navigation.NavigateTo($"/computadoras?aulaId={aulaId}");
    }

    private async Task LoadAulasCacheAsync()
    {
        if (_aulasCache.Count == 0)
        {
            try
            {
                _aulasCache = await ApiClient.GetAulasAsync();
                StateHasChanged();
            }
            catch
            {
                // Silencioso
            }
        }
    }

    // Diálogos modales
    private bool _showProfileDialog = false;
