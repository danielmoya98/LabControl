    }

    private void OpenEditProfileDialog()
    {
        _editNombre = SessionService.CurrentUser?.NombreCompleto ?? "";
        _editFotoUrl = SessionService.CurrentUser?.FotoUrl ?? "";
        _currentPassword = "";
        _newPassword = "";
        _confirmPassword = "";
        _showProfileDialog = true;
    }

    private void SaveProfileChanges()
    {
        if (string.IsNullOrWhiteSpace(_editNombre))
        {
            Snackbar.Add("El nombre completo es obligatorio.", Severity.Warning);
            return;
        }

        if (!string.IsNullOrEmpty(_newPassword))
        {
            if (_newPassword.Length < 6)
            {
                Snackbar.Add("La nueva contraseña debe tener al menos 6 caracteres.", Severity.Warning);
                return;
            }
            if (_newPassword != _confirmPassword)
            {
                Snackbar.Add("Las nuevas contraseñas no coinciden.", Severity.Warning);
                return;
            }
        }

        SessionService.UpdateProfile(_editNombre.Trim(), _editFotoUrl?.Trim());
        Snackbar.Add("Perfil actualizado exitosamente.", Severity.Success);
        _showProfileDialog = false;
    }

