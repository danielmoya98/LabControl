    private int _unreadCount => _notificaciones.Count(n => !n.Leida);

    private void MarcarNotificacionesLeidas()
    {
        foreach (var n in _notificaciones)
        {
            n.Leida = true;
        }
        Snackbar.Add("Todas las notificaciones marcadas como leídas.", Severity.Info);
    }

    private void LimpiarNotificaciones()
    {
