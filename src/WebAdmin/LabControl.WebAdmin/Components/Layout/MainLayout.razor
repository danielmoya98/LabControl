    public MainLayout()
    {
        _customTheme.Typography.Default.FontFamily = new[] { "Plus Jakarta Sans", "Outfit", "Segoe UI", "sans-serif" };
    }

    protected override async Task OnInitializedAsync()
    {
        SessionService.OnChange += StateHasChanged;

        if (!Navigation.Uri.Contains("/onboarding"))
        {
            var status = await ApiClient.GetOnboardingStatusAsync();
            if (status != null && !status.OnboardingCompletado)
            {
                Navigation.NavigateTo("/onboarding");
                return;
            }

            if (!SessionService.IsAuthenticated && !Navigation.Uri.Contains("/login"))
            {
                Navigation.NavigateTo("/login");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var pref = await JSRuntime.InvokeAsync<string>("themeManager.getThemePreference");
                if (pref == "dark")
                {
                    _isDarkMode = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // Silencioso si JSInterop no está listo
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JSRuntime.InvokeVoidAsync("themeManager.setThemePreference", _isDarkMode ? "dark" : "light");
        }
        catch
        {
            // Silencioso
        }
    }

    private void HandleLogout()
    {
        SessionService.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        SessionService.OnChange -= StateHasChanged;
    }
