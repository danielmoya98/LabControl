@inherits LayoutComponentBase
@using LabControl.WebAdmin.Services
@using LabControl.Application.Features.Aulas.Commands.CreateAula
@inject UserSessionService SessionService
@inject SignalRClientService SignalRService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject LabApiClient ApiClient
@implements IDisposable

<MudThemeProvider Theme="_customTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider Position="DialogPosition.Center" CloseButton="true" FullWidth="false" />
<MudSnackbarProvider />

@if (IsBareLayoutPage)
{
    <main>
        @Body
    </main>
}
else
{
    <MudLayout>
        <!-- Sidebar Drawer Elegante (Ocupa todo el alto vertical de la pantalla: 100vh) -->
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="0"
                   ClipMode="DrawerClipMode.Never"
                   Width="260px"
                   Style="border-right: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-drawer-background); z-index: calc(var(--mud-zindex-appbar) + 1);">
            <NavMenu />
        </MudDrawer>

        <!-- AppBar Superior Limpia (Estilo Radzen / Soft SaaS, a la derecha del Sidebar) -->
        <MudAppBar Elevation="0" Fixed="true" Class="saas-appbar">
            <!-- Sección Izquierda: Toggle Drawer + Título + Buscador -->
            <div class="d-flex align-center gap-2">
                <MudIconButton Icon="@(_drawerOpen ? Icons.Material.Outlined.MenuOpen : Icons.Material.Outlined.Menu)"
                               Color="Color.Default"
                               Edge="Edge.Start"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)"
                               Class="mr-1" />

                <!-- Command Palette Trigger Button (Ctrl + K) -->
                <button type="button"
                        id="command-palette-trigger"
                        class="command-palette-trigger-btn ml-3 d-none d-md-inline-flex"
                        @onclick="OpenCommandPalette"
                        title="Buscar o ejecutar comando (Ctrl+K)">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                    <span>Buscar o comando...</span>
                    <kbd class="command-kbd">Ctrl K</kbd>
                </button>
                <MudIconButton Icon="@Icons.Material.Outlined.Search"
                               Color="Color.Default"
                               Size="Size.Medium"
                               OnClick="OpenCommandPalette"
                               Class="d-inline-flex d-md-none ml-1"
                               title="Buscar o comando (Ctrl+K)" />
            </div>

            <MudSpacer />

            <div class="d-flex align-center gap-3">
                <!-- 1. Dropdown de Notificaciones -->
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="false">
                    <ActivatorContent>
                        <MudBadge Content="@(_unreadCount > 0 ? _unreadCount.ToString() : null)"
                                  Color="Color.Error"
                                  Overlap="true"
                                  BadgeClass="topbar-notification-badge"
                                  Visible="@(_unreadCount > 0)"
                                  Class="mr-1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                                           Color="Color.Default"
                                           Size="Size.Medium"
                                           OnClick="@context.ToggleAsync" />
                        </MudBadge>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="rounded-lg" style="width: 360px; max-width: 90vw; overflow: hidden; border: 1px solid var(--mud-palette-lines-default);">
                            <!-- Encabezado Notificaciones -->
                            <div class="d-flex align-center justify-space-between px-4 py-3" style="border-bottom: 1px solid var(--mud-palette-lines-default); background: rgba(148, 163, 184, 0.05);">
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="font-size: 0.88rem;">Notificaciones</MudText>
                                    @if (_unreadCount > 0)
                                    {
                                        <span class="badge-soft-error font-weight-bold" style="font-size: 0.68rem; padding: 2px 6px;">
                                            @_unreadCount nuevas
                                        </span>
                                    }
                                </div>
                                @if (_unreadCount > 0)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="MarcarNotificacionesLeidas" Style="font-size: 0.75rem; text-transform: none;">
                                        Marcar leídas
                                    </MudButton>
                                }
                            </div>

                            <!-- Lista de Notificaciones -->
                            <div style="max-height: 320px; overflow-y: auto;">
                                @if (_notificaciones.Count == 0)
                                {
                                    <div class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.NotificationsOff" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No hay notificaciones pendientes</MudText>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var notif in _notificaciones)
                                    {
                                        <div class="px-4 py-3 d-flex gap-3 align-start mud-hover"
                                             style="border-bottom: 1px solid var(--mud-palette-lines-default); background: @(notif.Leida ? "transparent" : "rgba(158, 0, 68, 0.04)"); cursor: pointer;">
                                            <div class="pa-2 rounded-circle mt-1" style="background: @notif.BgColor;">
                                                <MudIcon Icon="@notif.Icono" Color="@notif.IconColor" Size="Size.Small" />
                                            </div>
                                            <div style="flex: 1;">
                                                <div class="d-flex align-center justify-space-between">
                                                    <MudText Typo="Typo.body2" Class="font-weight-bold" Style="font-size: 0.83rem;">
                                                        @notif.Titulo
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">
                                                        @notif.Tiempo
                                                    </MudText>
                                                </div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1" Style="line-height: 1.35;">
                                                    @notif.Mensaje
                                                </MudText>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Pie Notificaciones -->
                            <div class="pa-2 text-center" style="background: var(--mud-palette-background-gray); border-top: 1px solid var(--mud-palette-lines-default);">
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" FullWidth="true" OnClick="LimpiarNotificaciones" Style="text-transform: none; font-size: 0.8rem;">
                                    Limpiar historial
                                </MudButton>
                            </div>
                        </div>
                    </ChildContent>
                </MudMenu>

                <!-- 2. User Menu Dropdown (Reagrupado con todas las opciones) -->
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text"
                                   OnClick="@context.ToggleAsync"
                                   Class="user-menu-trigger ml-1">
                            <div class="d-flex align-center gap-2">
                                @if (!string.IsNullOrEmpty(SessionService.CurrentUser?.FotoUrl))
                                {
                                    <MudAvatar Size="Size.Small">
                                        <MudImage Src="@SessionService.CurrentUser.FotoUrl" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 700; font-size: 0.82rem; width: 28px; height: 28px;">
                                        @(SessionService.CurrentUser?.NombreCompleto?.FirstOrDefault() ?? 'A')
                                    </MudAvatar>
                                }
                                <MudText Typo="Typo.body2" Class="font-weight-bold hidden-xs" Style="font-size: 0.84rem;">
                                    @(SessionService.CurrentUser?.NombreCompleto ?? "Administrador")
                                </MudText>
                                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Color="Color.Default" Style="font-size: 1.1rem;" />
                            </div>
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="rounded-lg" style="min-width: 260px; overflow: hidden; border: 1px solid var(--mud-palette-lines-default);">
                            <!-- Tarjeta de Información de Usuario -->
                            <div class="px-4 py-3 d-flex align-center gap-3" style="background: rgba(148, 163, 184, 0.05); border-bottom: 1px solid var(--mud-palette-lines-default);">
                                @if (!string.IsNullOrEmpty(SessionService.CurrentUser?.FotoUrl))
                                {
                                    <MudAvatar Size="Size.Medium">
                                        <MudImage Src="@SessionService.CurrentUser.FotoUrl" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Style="font-weight: 700; font-size: 1.1rem;">
                                        @(SessionService.CurrentUser?.NombreCompleto?.FirstOrDefault() ?? 'A')
                                    </MudAvatar>
                                }
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="line-height: 1.2; font-size: 0.88rem;">
                                        @(SessionService.CurrentUser?.NombreCompleto ?? "Administrador")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" Style="font-size: 0.75rem;">
                                        @(SessionService.CurrentUser?.Email ?? "admin@univalle.edu")
                                    </MudText>
                                    <div class="mt-1">
                                        <span class="badge-soft-info font-weight-bold" style="font-size: 0.65rem; padding: 1px 6px;">
                                            @(SessionService.CurrentUser?.Rol ?? "Administrador")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Opciones del Menú de Usuario -->
                            <div class="py-1">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Person" OnClick="OpenEditProfileDialog">
                                    <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                        <span style="font-size: 0.84rem; font-weight: 500;">Editar Perfil</span>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-4" Style="font-size: 0.7rem;">Foto, datos y clave</MudText>
                                    </div>
                                </MudMenuItem>

                                <MudMenuItem Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                             IconColor="@(_isDarkMode ? Color.Warning : Color.Default)"
                                             OnClick="ToggleThemeAsync">
                                    <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                        <span style="font-size: 0.84rem; font-weight: 500;">Tema de la Interfaz</span>
                                        <span class="@(_isDarkMode ? "badge-soft-warning" : "badge-soft-info") font-weight-bold ml-2"
                                              style="font-size: 0.68rem; padding: 2px 6px;">
                                            @(_isDarkMode ? "Oscuro" : "Claro")
                                        </span>
                                    </div>
                                </MudMenuItem>

                                <MudMenuItem Icon="@Icons.Material.Outlined.HelpOutline" OnClick="OpenHelpDialog">
                                    <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                        <span style="font-size: 0.84rem; font-weight: 500;">Ayuda y Soporte</span>
                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.95rem;" />
                                    </div>
                                </MudMenuItem>
                            </div>

                            <MudDivider Style="opacity: 0.5;" />

                            <div class="py-1">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Error" OnClick="HandleLogout">
                                    <MudText Color="Color.Error" Typo="Typo.body2" Class="font-weight-bold" Style="font-size: 0.84rem;">
                                        Cerrar Sesión
                                    </MudText>
                                </MudMenuItem>
                            </div>
                        </div>
                    </ChildContent>
                </MudMenu>
            </div>
        </MudAppBar>

        <!-- Main Content con espaciado óptimo -->
        <MudMainContent Class="px-6 pb-8" Style="background: var(--mud-palette-background); min-height: 100vh; padding-top: 92px !important;">
            <div class="mt-2">
                @Body
            </div>
        </MudMainContent>
    </MudLayout>

    <!-- Modal para Editar Perfil Básico (Nombre, Foto y Contraseña) -->
    <MudDialog @bind-Visible="_showProfileDialog" Options="_dialogOptions">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">Editar Perfil de Administrador</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <div class="d-flex flex-column gap-4 py-2" style="min-width: 320px; max-width: 480px;">
                <!-- Previsualización y Selección de Foto -->
                <div class="d-flex align-center gap-4 pa-3 rounded-lg" style="background: var(--mud-palette-background-gray); border: 1px solid var(--mud-palette-lines-default);">
                    @if (!string.IsNullOrEmpty(_editFotoUrl))
                    {
                        <MudAvatar Style="width: 64px; height: 64px;">
                            <MudImage Src="@_editFotoUrl" />
                        </MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Style="width: 64px; height: 64px; font-size: 1.5rem; font-weight: 700;">
                            @(_editNombre?.FirstOrDefault() ?? 'A')
                        </MudAvatar>
                    }
                    <div style="flex: 1;">
                        <MudText Typo="Typo.body2" Class="font-weight-bold mb-1">Foto o Avatar de Perfil</MudText>
                        <MudTextField @bind-Value="_editFotoUrl" Label="URL de imagen" Placeholder="https://ejemplo.com/foto.jpg"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="font-size: 0.8rem;" />
                        <div class="d-flex gap-2 mt-2">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _editFotoUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150")" Style="font-size: 0.7rem; padding: 2px 6px;">Avatar 1</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _editFotoUrl = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150")" Style="font-size: 0.7rem; padding: 2px 6px;">Avatar 2</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => _editFotoUrl = "")" Style="font-size: 0.7rem; padding: 2px 6px;">Quitar Foto</MudButton>
                        </div>
                    </div>
                </div>

                <!-- Nombre Completo -->
                <MudTextField @bind-Value="_editNombre" Label="Nombre Completo" Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Person" Required="true" />

                <!-- Correo Electrónico (Solo Lectura) -->
                <MudTextField Value="@(SessionService.CurrentUser?.Email ?? "admin@univalle.edu")" Label="Correo Institucional"
                              Variant="Variant.Outlined" ReadOnly="true" Disabled="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" />

                <!-- Sección Seguridad: Cambiar Contraseña -->
                <MudDivider Class="my-1" />
                <div>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Class="mr-1" Style="vertical-align: text-bottom;" />
                        Seguridad: Cambiar Contraseña (Opcional)
                    </MudText>
                    <div class="d-flex flex-column gap-3">
                        <MudTextField @bind-Value="_currentPassword" Label="Contraseña Actual" Variant="Variant.Outlined"
                                      InputType="@(_showCurrentPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showCurrentPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showCurrentPassword = !_showCurrentPassword)" />

                        <MudTextField @bind-Value="_newPassword" Label="Nueva Contraseña" Variant="Variant.Outlined"
                                      InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showNewPassword = !_showNewPassword)" />

                        <MudTextField @bind-Value="_confirmPassword" Label="Confirmar Nueva Contraseña" Variant="Variant.Outlined"
                                      InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)" />
                    </div>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="() => _showProfileDialog = false">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfileChanges" StartIcon="@Icons.Material.Filled.Save">
                Guardar Cambios
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Modal para Ayuda y Soporte -->
    <MudDialog @bind-Visible="_showHelpDialog" Options="_dialogOptions">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="font-weight-bold">Centro de Ayuda y Soporte</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <div class="d-flex flex-column gap-4 py-2" style="min-width: 320px; max-width: 500px;">
                <!-- Guía Rápida -->
                <div class="pa-4 rounded-lg" style="background: var(--mud-palette-background-gray); border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Color="Color.Primary">
                        💡 Guía Rápida de LabControl
                    </MudText>
                    <div class="d-flex flex-column gap-2" style="font-size: 0.85rem; color: var(--mud-palette-text-secondary);">
                        <div>• <strong>Mosaico en Vivo:</strong> En el Tablero puedes alternar a la vista mosaico para ver capturas en tiempo real de las computadoras activas.</div>
                        <div>• <strong>Políticas de Inactividad:</strong> En Gestión de Aulas puedes definir el tiempo límite de abandono físico y la acción (apagar PC o cerrar sesión).</div>
                        <div>• <strong>Mensajería de Aula:</strong> Envía anuncios directos a los estudiantes de manera flotante sin interrumpir sus actividades.</div>
                    </div>
                </div>

                <!-- Soporte Técnico TI -->
                <div class="pa-4 rounded-lg" style="background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                        📞 Soporte Técnico TI - Univalle
                    </MudText>
                    <div class="d-flex flex-column gap-2" style="font-size: 0.85rem;">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" Color="Color.Secondary" />
                            <span><strong>Correo:</strong> soporte.sistemas@univalle.edu</span>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Small" Color="Color.Secondary" />
                            <span><strong>Interno:</strong> Ext. 4022 / 4023</span>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Secondary" />
                            <span><strong>Horario:</strong> Lunes a Viernes 07:30 - 19:30</span>
                        </div>
                    </div>
                </div>

                <!-- Versión y Derechos -->
                <div class="d-flex align-center justify-space-between px-2" style="font-size: 0.75rem; color: var(--mud-palette-text-disabled);">
                    <span>LabControl Enterprise v2.4</span>
                    <span>Universidad del Valle &copy; @DateTime.Now.Year</span>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _showHelpDialog = false">
                Entendido
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Diálogo: Command Global (Ctrl+K) -->
    <MudDialog @bind-Visible="_showCommandPalette" Options="_commandDialogOptions" Class="rounded-lg shadow-xl" Style="border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); overflow: hidden;">
        <DialogContent>
            <!-- Barra de Búsqueda del Command Palette -->
            <div class="d-flex align-center px-4 py-3 gap-3" style="border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-background);">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Medium" Color="Color.Primary" />
                <input type="text"
                       class="command-search-input"
                       style="background: transparent; border: none; outline: none; width: 100%; font-size: 1rem; color: var(--mud-palette-text-primary); font-family: inherit;"
                       placeholder="Escribe un comando o busca una vista, aula o acción..."
                       @bind="_commandQuery"
                       @bind:event="oninput"
                       autofocus />
                @if (!string.IsNullOrWhiteSpace(_commandQuery))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _commandQuery = string.Empty" />
                }
                <kbd class="command-kbd">ESC</kbd>
            </div>

            <!-- Lista de Resultados Filtrados -->
            <div class="pa-2" style="max-height: 380px; overflow-y: auto;">
                @if (FilteredNavItems.Any())
                {
                    <div class="px-3 py-1 mt-1 text-uppercase font-weight-bold" style="font-size: 0.68rem; letter-spacing: 0.05em; color: var(--mud-palette-text-disabled);">
                        Vistas y Navegación
                    </div>
                    @foreach (var item in FilteredNavItems)
                    {
                        <div class="command-item d-flex align-center justify-space-between px-3 py-2 rounded-lg cursor-pointer"
                             @onclick="() => NavigateFromPalette(item.Route)">
                            <div class="d-flex align-center gap-3">
                                <div class="pa-1 rounded-lg" style="background: rgba(37, 99, 235, 0.08);">
                                    <MudIcon Icon="@item.Icon" Size="Size.Small" Color="Color.Primary" />
                                </div>
                                <div>
                                    <div class="font-weight-medium" style="font-size: 0.88rem; color: var(--mud-palette-text-primary);">@item.Title</div>
                                    <div style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">@item.Description</div>
                                </div>
                            </div>
                            <kbd class="command-kbd" style="font-size: 0.65rem;">@item.Badge</kbd>
                        </div>
                    }
                }

                @if (FilteredAulas.Any())
                {
                    <div class="px-3 py-1 mt-3 text-uppercase font-weight-bold" style="font-size: 0.68rem; letter-spacing: 0.05em; color: var(--mud-palette-text-disabled);">
                        Aulas y Espacios Físicos
                    </div>
                    @foreach (var aula in FilteredAulas)
                    {
                        <div class="command-item d-flex align-center justify-space-between px-3 py-2 rounded-lg cursor-pointer"
                             @onclick="() => NavigateToAula(aula.Id)">
                            <div class="d-flex align-center gap-3">
                                <div class="pa-1 rounded-lg" style="background: rgba(16, 185, 129, 0.08);">
                                    <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" Color="Color.Success" />
                                </div>
                                <div>
                                    <div class="font-weight-medium" style="font-size: 0.88rem; color: var(--mud-palette-text-primary);">@aula.Nombre</div>
                                    <div style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">@aula.Pabellon &bull; Capacidad: @aula.Capacidad pcs</div>
                                </div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Style="font-size: 0.65rem; height: 20px;">
                                Filtrar PCs
                            </MudChip>
                        </div>
                    }
                }

                @if (FilteredActionItems.Any())
                {
                    <div class="px-3 py-1 mt-3 text-uppercase font-weight-bold" style="font-size: 0.68rem; letter-spacing: 0.05em; color: var(--mud-palette-text-disabled);">
                        Acciones y Accesos Rápidos
                    </div>
                    @foreach (var act in FilteredActionItems)
                    {
                        <div class="command-item d-flex align-center justify-space-between px-3 py-2 rounded-lg cursor-pointer"
                             @onclick="act.Action">
                            <div class="d-flex align-center gap-3">
                                <div class="pa-1 rounded-lg" style="background: rgba(245, 158, 11, 0.08);">
                                    <MudIcon Icon="@act.Icon" Size="Size.Small" Color="Color.Warning" />
                                </div>
                                <div>
                                    <div class="font-weight-medium" style="font-size: 0.88rem; color: var(--mud-palette-text-primary);">@act.Title</div>
                                    <div style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">@act.Description</div>
                                </div>
                            </div>
                            <kbd class="command-kbd" style="font-size: 0.65rem;">@act.Badge</kbd>
                        </div>
                    }
                }

                @if (!FilteredNavItems.Any() && !FilteredAulas.Any() && !FilteredActionItems.Any())
                {
                    <div class="text-center py-6 px-4">
                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            No se encontraron comandos o resultados para "<strong>@_commandQuery</strong>"
                        </MudText>
                    </div>
                }
            </div>

            <!-- Footer con Atajos -->
            <div class="d-flex align-center justify-space-between px-4 py-2" style="border-top: 1px solid var(--mud-palette-lines-default); font-size: 0.72rem; color: var(--mud-palette-text-disabled); background: rgba(148, 163, 184, 0.03);">
                <div class="d-flex align-center gap-3">
                    <span><kbd class="command-kbd">↵</kbd> Seleccionar</span>
                    <span><kbd class="command-kbd">ESC</kbd> Cerrar</span>
                </div>
                <span>LabControl Command System</span>
            </div>
        </DialogContent>
    </MudDialog>
}

@code {
