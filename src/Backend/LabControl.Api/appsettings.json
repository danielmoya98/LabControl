    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=LabControlDb;Username=postgres;Password=POSTGRES"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForUnivalleLabControlSystem2026_MustBeLongEnough!",
    "Issuer": "LabControlApi",
